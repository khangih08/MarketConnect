<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>
    
    <!-- Các thư viện UI từ CDN Internet -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    
    <!-- Các thẻ cấu hình nạp CSS tĩnh bắt buộc của ASP.NET Core -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketConnect.styles.css" asp-append-version="true" />

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#004532",
                        "secondary": "#f97316",
                        "surface": "#f9f9ff",
                        "background": "#f5f5fa",
                        "on-background": "#151c27",
                        "outline-variant": "#dee2e6",
                        "primary-container": "#065f46",
                        "on-surface-variant": "#3f4944",
                        "on-surface": "#151c27",
                        "surface-container-low": "#f0f3ff",
                        "surface-container-lowest": "#ffffff"
                    },
                    "fontFamily": {
                        "sans": ["Hanken Grotesk", "sans-serif"]
                    }
                },
            }
        }
    </script>
    <style>
        body {
            font-family: 'Hanken Grotesk', sans-serif;
            background-color: #f5f5fa;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="text-on-background text-sm flex flex-col min-h-screen">

    <!-- 1. HEADER CHUNG CHO TẤT CẢ CÁC TRANG -->
    <header class="w-full sticky top-0 bg-[#004532] text-white z-50 shadow-md select-none">
        <div class="max-w-[1440px] mx-auto px-4 md:px-16 py-3 flex justify-between items-center">
            <!-- Left Links -->
            <div class="flex items-center gap-4 text-xs">
                <a class="hover:text-orange-400 transition-colors" href="/">Kênh Người Bán</a>
                <div class="w-px h-4 bg-white/20 hidden md:block"></div>
                <a class="hover:text-orange-400 transition-colors" href="#">Tải ứng dụng</a>
                <div class="w-px h-4 bg-white/20 hidden md:block"></div>
                <div class="flex items-center gap-2">
                    <span>Kết nối</span>
                    <i class="bi bi-facebook cursor-pointer hover:text-orange-400 transition-colors"></i>
                    <i class="bi bi-instagram cursor-pointer hover:text-orange-400 transition-colors"></i>
                </div>
            </div>
            <!-- Right Links -->
            <div class="flex items-center gap-4 text-xs">
                <a class="flex items-center gap-1 hover:text-orange-400 transition-colors" href="/Notifications">
                    <span class="material-symbols-outlined text-[18px]">notifications</span> Thông báo
                </a>
                <a class="flex items-center gap-1 hover:text-orange-400 transition-colors" href="/Support">
                    <span class="material-symbols-outlined text-[18px]">help</span> Hỗ trợ
                </a>
                
                <div id="topbar_auth_zone" class="flex items-center gap-2">
                    <a class="font-medium hover:text-orange-400" href="/Account/Register">Đăng ký</a>
                    <div class="w-[1px] h-3 bg-white/30"></div>
                    <a class="font-medium hover:text-orange-400" href="/Account/Login">Đăng nhập</a>
                </div>
            </div>
        </div>
    </header>

    <div class="w-full bg-white border-b border-gray-200 shadow-sm">
        <div class="max-w-[1440px] mx-auto px-4 md:px-16 py-4 flex items-center justify-between gap-8">
            <a href="/" class="flex items-center gap-2 shrink-0">
                <i class="bi bi-bag-fill text-[#f97316] text-3xl"></i>
                <h1 class="font-bold text-2xl text-[#004d38] tracking-tight">MarketConnect</h1>
            </a>

            <div class="flex-grow max-w-2xl hidden md:block">
                <form method="get" action="/Home/Index" class="flex bg-white border-2 border-[#f97316] rounded-sm p-[2px]">
                    <input name="q" class="flex-grow border-none focus:ring-0 px-4 text-sm outline-none" placeholder="Săn Deal 11.11 - Miễn phí vận chuyển toàn quốc..." type="text" />
                    <button type="submit" class="bg-[#f97316] text-white px-6 py-1.5 flex items-center justify-center hover:opacity-95 transition-all">
                        <i class="bi bi-search text-base"></i>
                    </button>
                </form>
            </div>

            <div class="flex items-center pr-4">
                <div class="relative cursor-pointer">
                    <i class="bi bi-cart3 text-[#004d38] text-2xl"></i>
                    <span class="absolute -top-2 -right-2 bg-[#f97316] text-white text-[10px] px-1.5 rounded-full border-2 border-white font-bold">5</span>
                </div>
            </div>
        </div>
    </div>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-200 pt-8 mt-auto">
        <div class="max-w-[1440px] mx-auto px-4 md:px-16 py-6 text-center text-gray-500 text-xs">
            <p>© 2026 MarketConnect. Tất cả các quyền được bảo lưu.</p>
            <p class="mt-2 text-gray-400">Địa chỉ: Tầng 4-5-6, Tòa nhà Capital Place, số 29 đường Liễu Giai, Phường Ngọc Khánh, Quận Ba Đình, Hà Nội.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // 1. Hàm hiển thị giao diện góc phải (Đã tối ưu nhận dữ liệu động)
function checkAuthStatus() {
    const token = localStorage.getItem('token');
    const authZone = document.getElementById('topbar_auth_zone');
    
    if (token && authZone) {
        const storedAvatar = localStorage.getItem('user_avatar');
        // Nếu chưa kịp lấy tên từ API Profile thì dùng tạm phần trước @ của Email làm tên hiển thị
        let storedName = localStorage.getItem('user_name');
        if (!storedName || storedName.trim() === "" || storedName === "Tài khoản") {
            const email = localStorage.getItem('user_email');
            storedName = email ? email.split('@')[0] : 'Tài khoản';
        }
        
        authZone.innerHTML = `
            <div class="relative inline-block text-left">
                <button id="layoutMenuBtn" class="flex items-center gap-1.5 hover:bg-white/10 transition-colors py-1 px-2.5 rounded-full cursor-pointer focus:outline-none">
                    ${storedAvatar && storedAvatar.trim() !== "" 
                        ? `<img class="w-5 h-5 rounded-full object-cover border border-white/40" src="${storedAvatar}"/>`
                        : `<i class="bi bi-person-circle text-base text-white"></i>`
                    }
                    <span class="font-medium text-white text-xs max-w-[120px] truncate">
                        ${storedName}
                    </span>
                    <i class="bi bi-chevron-down text-[10px] text-white/70 transition-transform duration-200" id="layoutMenuArrow"></i>
                </button>
                <div id="layoutDropdownMenu" class="hidden absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-xl shadow-xl py-1 z-50 text-gray-800">
                    <a href="/Account/Profile" class="flex items-center gap-2 px-4 py-2 text-xs hover:bg-gray-50 transition-colors">
                        <i class="bi bi-person-gear text-[#004d38]"></i> Cài đặt tài khoản
                    </a>
                    <a href="#" class="flex items-center gap-2 px-4 py-2 text-xs hover:bg-gray-50 transition-colors">
                        <i class="bi bi-headset text-gray-500"></i> Trợ giúp
                    </a>
                    <a href="#" class="flex items-center gap-2 px-4 py-2 text-xs hover:bg-gray-50 transition-colors">
                        <i class="bi bi-chat-left-heart text-gray-500"></i> Đóng góp ý kiến
                    </a>
                    <div class="border-t border-gray-100 my-1"></div>
                    <button onclick="globalLogout(event)" class="w-full flex items-center gap-2 px-4 py-2 text-xs text-red-600 hover:bg-red-50 transition-colors text-left font-medium">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </button>
                </div>
            </div>
        `;

        const menuBtn = document.getElementById('layoutMenuBtn');
        const dropdownMenu = document.getElementById('layoutDropdownMenu');
        const menuArrow = document.getElementById('layoutMenuArrow');

        if (menuBtn && dropdownMenu) {
            menuBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                if (dropdownMenu.classList.contains('hidden')) {
                    dropdownMenu.classList.remove('hidden');
                    menuArrow.classList.add('rotate-180');
                } else {
                    dropdownMenu.classList.add('hidden');
                    menuArrow.classList.remove('rotate-180');
                }
            });

            document.addEventListener('click', function () {
                if (dropdownMenu) {
                    dropdownMenu.classList.add('hidden');
                    menuArrow.classList.remove('rotate-180');
                }
            });
        }
    }
}

// 2. BỔ SUNG: Hàm tự động gọi lên Backend xin Họ và Tên thật thông qua Token
async function fetchUserProfile() {
    const token = localStorage.getItem('token');
    if (!token) return;

    try {
        // Gọi tới endpoint lấy thông tin cá nhân của Backend (Khang đổi lại URL cho đúng với Backend của bạn nhé)
        const res = await fetch(`${window.location.origin}/api/auth/me`, { 
            method: 'GET',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });

        if (res.ok) {
            const userData = await res.json();
            // Lấy key họ tên tùy theo Backend trả về (ví dụ: fullName, name hoặc userName)
            const fullName = userData.fullName || userData.name || userData.userName; 
            if (fullName) {
                localStorage.setItem('user_name', fullName);
                if (userData.avatar || userData.avatarUrl) {
                    localStorage.setItem('user_avatar', userData.avatar || userData.avatarUrl);
                }
                // Render lại giao diện góc phải sau khi đã có tên thật
                checkAuthStatus(); 
            }
        }
    } catch (error) {
        console.error("Không thể lấy thông tin chi tiết cá nhân từ Backend:", error);
    }
}

   checkAuthStatus();
   document.addEventListener("DOMContentLoaded", function() {
   checkAuthStatus();
   fetchUserProfile(); 
});

function globalLogout(e) {
    e.preventDefault();
    localStorage.clear();
    alert('Đã đăng xuất tài khoản thành công!');
    window.location.href = '/Account/Login';
}
    </script>
</body>
</html>