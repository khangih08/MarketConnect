@{
    Layout = "_Layout";
    ViewData["Title"] = "Thay đổi mật khẩu | MarketConnect";
}

<main class="max-w-[1440px] mx-auto w-full px-4 md:px-16 py-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

        <!-- Left Column: Sidebar (Giữ nguyên cấu trúc của trang Profile) -->
        <aside class="md:col-span-4 lg:col-span-3 space-y-4">
            <div class="bg-white border border-gray-200 rounded-2xl p-6 flex flex-col items-center text-center shadow-sm">
                <div class="relative mb-2">
                    <img id="sidebar_avatar" alt="Profile" class="w-24 h-24 rounded-full object-cover border-4 border-[#004532]/10" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80" />
                    <div class="absolute bottom-1 right-1 bg-[#004532] text-white rounded-full p-1 border-2 border-white flex items-center justify-center">
                        <span class="material-symbols-outlined text-[16px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                    </div>
                </div>
                <h2 id="sidebar_fullname" class="text-base font-bold text-gray-800">Đang tải...</h2>
                <p id="sidebar_username" class="text-xs text-gray-500">@("@marketconnect")</p>
                <div class="mt-2 inline-flex items-center px-2 py-0.5 rounded-full bg-emerald-50 text-[#004532] text-[10px] font-bold uppercase tracking-wider">
                    Đã xác minh
                </div>
            </div>

            <nav class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
                <ul class="flex flex-col list-none m-0 p-0">
                    <li>
                        <a class="flex items-center gap-3 px-6 py-3.5 text-gray-600 hover:bg-gray-50 transition-all" href="/Account/Profile">
                            <span class="material-symbols-outlined">person</span>
                            <span class="text-sm font-medium">Thông tin cá nhân</span>
                        </a>
                    </li>
                    <li>
                        <!-- Mục Đổi mật khẩu được active nổi bật lên bằng màu xanh emerald -->
                        <a class="flex items-center gap-3 px-6 py-3.5 transition-all bg-emerald-50 text-[#004532] border-l-4 border-[#004532]" href="#">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">lock</span>
                            <span class="text-sm font-medium">Đổi mật khẩu</span>
                        </a>
                    </li>
                    <li>
                        <a class="flex items-center gap-3 px-6 py-3.5 text-gray-600 hover:bg-gray-50 transition-all" href="#">
                            <span class="material-symbols-outlined">shopping_bag</span>
                            <span class="text-sm font-medium">Lịch sử mua hàng</span>
                        </a>
                    </li>
                    <li>
                        <a class="flex items-center gap-3 px-6 py-3.5 text-gray-600 hover:bg-gray-50 transition-all" href="#">
                            <span class="material-symbols-outlined">location_on</span>
                            <span class="text-sm font-medium">Sổ địa chỉ</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Right Column: Main Content (Form đổi mật khẩu) -->
        <section class="md:col-span-8 lg:col-span-9">
            <div class="bg-white border border-gray-200 rounded-3xl p-6 md:p-8 shadow-sm">
                <div class="border-b border-gray-100 pb-4 mb-6">
                    <!-- Gắn thêm id để cập nhật tiêu đề động tùy theo loại tài khoản -->
                    <h3 id="pageTitle" class="text-xl font-bold text-gray-800">Đổi mật khẩu</h3>
                    <p id="pageSubTitle" class="text-sm text-gray-500 mt-1">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác</p>
                </div>

                <form action="#" class="space-y-5 max-w-xl" id="changePasswordForm" method="POST">
                    <!-- Mật khẩu hiện tại (Bọc container để ẩn nếu user đăng nhập bằng Google/OTP) -->
                    <div id="currentPasswordContainer" class="flex flex-col gap-1.5">
                        <label class="text-sm font-medium text-gray-600" for="currentPassword">Mật khẩu hiện tại</label>
                        <input required name="CurrentPassword" class="bg-white border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#004532] focus:border-[#004532] transition-shadow outline-none" id="currentPassword" type="password" placeholder="Nhập mật khẩu hiện tại" />
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-medium text-gray-600" for="newPassword">Mật khẩu mới</label>
                        <input required name="NewPassword" class="bg-white border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#004532] focus:border-[#004532] transition-shadow outline-none" id="newPassword" type="password" placeholder="Nhập mật khẩu mới" />
                    </div>

                    <!-- Xác nhận mật khẩu mới -->
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-medium text-gray-600" for="confirmPassword">Xác nhận mật khẩu mới</label>
                        <input required id="confirmPassword" class="bg-white border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#004532] focus:border-[#004532] transition-shadow outline-none" type="password" placeholder="Nhập lại mật khẩu mới" />
                    </div>

                    <!-- Submit Button -->
                    <div class="pt-4 flex justify-start">
                        <button id="submitBtn" class="bg-[#004532] hover:bg-[#065f46] text-white font-semibold text-sm px-8 py-2.5 rounded-xl transition-all duration-300 shadow-md shadow-[#004532]/20" type="submit">
                            Xác nhận đổi mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</main>

<script>
    // Biến toàn cục để kiểm tra trạng thái mật khẩu của tài khoản
    let accountHasPassword = true;

    document.addEventListener('DOMContentLoaded', async function () {
        const token = sessionStorage.getItem('token');
        if (!token) {
            window.location.href = '/Account/Login';
            return;
        }

        const savedName = sessionStorage.getItem('user_name');
        if (savedName && savedName !== "undefined") {
            const sidebarName = document.getElementById('sidebar_fullname');
            if (sidebarName) sidebarName.innerText = savedName;
        }

        try {
            const response = await fetch('/Account/GetProfileData', {
                method: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + token
                }
            });

            if (response.ok) {
                const result = await response.json();

                const hasPassword = result.hasPassword !== undefined ? result.hasPassword : result.HasPassword;
                accountHasPassword = hasPassword;

                if (accountHasPassword === false) {
                    document.getElementById('pageTitle').innerText = "Tạo mật khẩu tài khoản";
                    document.getElementById('pageSubTitle').innerText = "Tài khoản đăng nhập qua Google/OTP chưa có mật khẩu. Hãy tạo mật khẩu mới để tăng cường bảo mật.";
                    document.getElementById('submitBtn').innerText = "Xác nhận tạo mật khẩu";

                    const currentPwdContainer = document.getElementById('currentPasswordContainer');
                    if (currentPwdContainer) {
                        currentPwdContainer.classList.add('hidden');
                        currentPwdContainer.style.display = 'none';
                    }

                    const currentPwdInput = document.getElementById('currentPassword');
                    if (currentPwdInput) {
                        currentPwdInput.required = false;
                    }
                }
            }
        } catch (error) {
            console.error('Không thể kiểm tra trạng thái mật khẩu của user:', error);
        }
    });

    document.getElementById('changePasswordForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();

        const btn = this.querySelector('button[type="submit"]');
        const originalText = btn.innerText;

        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        if (newPassword.length < 6) {
            alert('Mật khẩu mới phải có ít nhất 6 ký tự.');
            return;
        }

        if (newPassword !== confirmPassword) {
            alert('Mật khẩu xác nhận không trùng khớp với mật khẩu mới.');
            return;
        }

        btn.innerText = 'Đang xử lý...';
        btn.disabled = true;

        const formData = new FormData(this);

        try {
            const response = await fetch('/Account/ChangePasswordSubmit', {
                method: 'POST',
                body: formData,
                headers: {
                    'Authorization': 'Bearer ' + sessionStorage.getItem('token')
                }
            });

            const result = await response.json();

            if (response.ok) {
                btn.innerText = accountHasPassword ? 'Đổi thành công!' : 'Tạo thành công!';
                btn.classList.add('bg-emerald-700');
                btn.classList.remove('bg-[#004532]');

                alert(result.message || 'Mật khẩu đã được thiết lập thành công!');
                document.getElementById('changePasswordForm').reset();

                if (!accountHasPassword) {
                    setTimeout(() => {
                        window.location.reload();
                    }, 500);
                }
            } else {
                alert(result.message || 'Thiết lập mật khẩu thất bại!');
                btn.innerText = 'Thất bại';
            }
        } catch (error) {
            console.error('Lỗi kết nối server:', error);
            alert('Không thể kết nối đến máy chủ. Vui lòng kiểm tra API.');
            btn.innerText = 'Lỗi kết nối';
        } finally {
            setTimeout(() => {
                btn.innerText = originalText;
                btn.classList.remove('bg-emerald-700');
                btn.classList.add('bg-[#004532]');
                btn.disabled = false;
            }, 2000);
        }
    });
</script>