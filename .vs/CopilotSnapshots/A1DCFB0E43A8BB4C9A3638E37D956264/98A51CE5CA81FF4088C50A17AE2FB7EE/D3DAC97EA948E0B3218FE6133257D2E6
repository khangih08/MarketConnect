using System.Threading.Tasks;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using MarketConnect.Data;
using Swashbuckle.AspNetCore.Annotations;
using MarketConnect.Services.Models;

namespace MarketConnect.Controllers
{
    [ApiController]
    [Route("api/Categories")]
    public class CategoriesApiController : ControllerBase
    {
        private readonly ApplicationDbContext _db;

        public CategoriesApiController(ApplicationDbContext db)
        {
            _db = db;
        }

        // POST: api/categories
        [HttpPost]
        [SwaggerOperation(Tags = new[] { "Categories" })]
        public async Task<IActionResult> Post([FromBody] Category category)
        {
            if (!ModelState.IsValid) return BadRequest(ModelState);

            // Prevent duplicate category names (case-insensitive)
            var exists = await _db.Categories.AnyAsync(c => c.Name.ToLower() == category.Name.ToLower());
            if (exists) return Conflict(new { message = "Category with the same name already exists." });

            _db.Categories.Add(category);
            await _db.SaveChangesAsync();

            return CreatedAtAction(nameof(GetById), new { id = category.Id }, category);
        }

        // GET: api/categories/{id}
        [HttpGet("{id}")]
        [SwaggerOperation(Tags = new[] { "Categories" })]
        public async Task<ActionResult<Category>> GetById(int id)
        {
            var cat = await _db.Categories.FindAsync(id);
            if (cat == null) return NotFound();
            return Ok(cat);
        }
    }
}
