@{
    Layout = "_Layout";
    ViewData["Title"] = "Liên kết tài khoản | MarketConnect";
}

<main class="max-w-[1440px] mx-auto w-full px-4 py-16 flex items-center justify-center">
    <!-- Box nội dung được căn giữa tuyệt đối, bo góc bo cạnh mượt mà -->
    <div class="bg-white border border-gray-200 rounded-3xl p-6 md:p-12 shadow-sm flex flex-col items-center max-w-md w-full">

        <div class="text-center w-full mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Thêm số điện thoại</h2>
            <p class="text-sm text-gray-500">Nhập số điện thoại của bạn để kích hoạt tài khoản và thiết lập mật khẩu</p>
        </div>

        <form id="addPhoneForm" class="space-y-4 w-full" method="post">
            <!-- Ô nhập Số điện thoại -->
            <div class="flex flex-col gap-1.5">
                <input id="phoneInput" name="Phone" type="tel" required
                       class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#004532] focus:border-[#004532] transition-all outline-none"
                       placeholder="Nhập số điện thoại *" />
            </div>

            <!-- Ô nhập Mật khẩu mới -->
            <div class="flex flex-col gap-1.5">
                <input id="newPwd" name="NewPassword" type="password" required
                       class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#004532] focus:border-[#004532] transition-all outline-none"
                       placeholder="Thêm một mật khẩu *" />
            </div>

            <!-- Chỉ số kiểm tra cấu trúc mật khẩu (Real-time Validation) giống Chợ Tốt -->
            <div id="passwordGuidelines" class="grid grid-cols-2 gap-x-4 gap-y-2 pt-1 text-xs text-gray-400">
                <div id="chkLength" class="flex items-center gap-1.5 transition-colors duration-200">
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    <span>Từ 8-32 ký tự.</span>
                </div>
                <div id="chkUppercase" class="flex items-center gap-1.5 transition-colors duration-200">
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    <span>Có 01 chữ IN HOA.</span>
                </div>
                <div id="chkLowercase" class="flex items-center gap-1.5 transition-colors duration-200">
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    <span>Có 01 chữ thường.</span>
                </div>
                <div id="chkNumber" class="flex items-center gap-1.5 transition-colors duration-200">
                    <span class="material-symbols-outlined text-[14px]">check_circle</span>
                    <span>Có 01 chữ số.</span>
                </div>
            </div>

            <!-- Ô xác nhận Mật khẩu -->
            <div class="flex flex-col gap-1.5 pt-2">
                <input id="confirmPwd" type="password" required
                       class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#004532] focus:border-[#004532] transition-all outline-none"
                       placeholder="Nhập lại mật khẩu *" />
            </div>

            <!-- Submit Button chuẩn màu xanh lục đậm đặc trưng MarketConnect -->
            <div class="pt-4">
                <button id="submitBtn" type="submit"
                        class="w-full bg-[#004532] hover:bg-[#065f46] text-white font-bold text-base py-3 rounded-xl transition-all duration-300 shadow-md shadow-[#004532]/20">
                    Tiếp tục
                </button>
            </div>
        </form>
    </div>
</main>

<script>
    // Kiểm tra token đăng nhập ngay từ khi tải trang
    document.addEventListener('DOMContentLoaded', function () {
        if (!sessionStorage.getItem('token')) {
            window.location.href = '/Account/Login';
        }
    });

    const newPwdInput = document.getElementById('newPwd');
    newPwdInput.addEventListener('input', function () {
        const val = this.value;
        const rules = {
            chkLength: val.length >= 8 && val.length <= 32,
            chkUppercase: /[A-Z]/.test(val),
            chkLowercase: /[a-z]/.test(val),
            chkNumber: /[0-9]/.test(val)
        };

        for (const [id, isPassed] of Object.entries(rules)) {
            const el = document.getElementById(id);
            if (isPassed) {
                el.classList.remove('text-gray-400');
                el.classList.add('text-emerald-600', 'font-medium');
                el.querySelector('span').style.fontVariationSettings = "'FILL' 1";
            } else {
                el.classList.remove('text-emerald-600', 'font-medium');
                el.classList.add('text-gray-400');
                el.querySelector('span').style.fontVariationSettings = "'FILL' 0";
            }
        }
    });

    // Xử lý gửi Form lên Controller
    document.getElementById('addPhoneForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const btn = document.getElementById('submitBtn');
        const originalText = btn.innerText;

        const phone = document.getElementById('phoneInput').value.trim();
        const newPwd = newPwdInput.value;
        const confirm = document.getElementById('confirmPwd').value;

        // Bắt lỗi validate cấu trúc mật khẩu ở Client trước
        const hasUpper = /[A-Z]/.test(newPwd);
        const hasLower = /[a-z]/.test(newPwd);
        const hasNum = /[0-9]/.test(newPwd);

        if (newPwd.length < 8 || newPwd.length > 32 || !hasUpper || !hasLower || !hasNum) {
            alert('Mật khẩu chưa đáp ứng đầy đủ điều kiện bảo mật hệ thống.');
            return;
        }

        if (newPwd !== confirm) {
            alert('Mật khẩu xác nhận nhập lại không trùng khớp.');
            return;
        }

        btn.innerText = 'Đang xử lý...';
        btn.disabled = true;

        const form = new FormData();
        form.append('Phone', phone);
        form.append('NewPassword', newPwd);

        try {
            const response = await fetch('/Account/AddPhoneAndSetPassword', {
                method: 'POST',
                body: form,
                headers: { 'Authorization': 'Bearer ' + sessionStorage.getItem('token') }
            });

            const contentType = response.headers.get('content-type') || '';
            let result = {};
            if (contentType.includes('application/json')) result = await response.json(); else result = { message: await response.text() };

            if (response.ok) {
                btn.innerText = 'Thành công!';
                btn.style.backgroundColor = '#059669';

                alert(result.message || 'Cập nhật thông tin bảo mật thành công!');
                sessionStorage.setItem('user_phone', phone);

                setTimeout(() => {
                    window.location.href = '/Account/Profile';
                }, 500);
            } else {
                alert(result.message || ('Lỗi: ' + response.status));
                btn.innerText = 'Thử lại';
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối đến máy chủ.');
            btn.innerText = 'Lỗi kết nối';
        } finally {
            setTimeout(() => {
                btn.innerText = originalText;
                btn.style.backgroundColor = '#004532';
                btn.disabled = false;
            }, 2000);
        }
    });
</script>