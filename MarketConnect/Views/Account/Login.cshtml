@{
    Layout = null;
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Đăng nhập & Đăng ký | MarketConnect</title>
    <!-- Import Google Identity Services SDK -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                "primary": "#004532",
                "primary-container": "#065f46",
                "background": "#f9f9ff",
                "surface": "#f9f9ff",
                "on-surface": "#151c27",
                "on-surface-variant": "#3f4944",
                "outline-variant": "#bec9c2",
                "outline": "#6f7973",
                "surface-container-lowest": "#ffffff"
            },
            "borderRadius": {
                "3xl": "1.5rem",
                "4xl": "2rem"
            },
            "fontFamily": {
                "display-lg": ["Hanken Grotesk"],
                "headline-md": ["Hanken Grotesk"],
                "body-lg": ["Hanken Grotesk"],
                "body-md": ["Hanken Grotesk"],
                "label-md": ["Hanken Grotesk"]
            }
          }
        }
      }
    </script>
    <style>
        body { font-family: 'Hanken Grotesk', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
    </style>
</head>
<body class="bg-background text-on-background h-screen w-full flex overflow-hidden select-none">

    <!-- Left Side: Banner -->
    <section class="hidden lg:flex w-1/2 h-full bg-[#065f46] flex-col justify-between p-16 text-white relative overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="w-full h-full bg-cover bg-center opacity-30 mix-blend-multiply" style="background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLuCX7zMtVF5AFLv-K15WmZldH0X_twSgG_4-Bj8DgLWfCDo0BBDAeLNdLMVEVoel3bXPtps11hJiKwmcy9dQ-xMWkFLnFTLHpFQgZ9j62LHm-vQREpLxEUAlyqT01L-SnywOCUBAbyPHFXqIxLXCfsaJF7qNoNHAOM6XmAdX_sFaO-WK9KMfrrwba6xwzZphcmf8r7YwBk7RNliGPMdxjpe0H5IwoSYLUt1hX7nvAAHJLKneAqSoWPwRl4s')"></div>
        </div>
        <div class="relative z-10">
            <div class="flex items-center gap-2 mb-12">
                <span class="material-symbols-outlined text-[40px]" style="font-variation-settings: 'FILL' 1;">storefront</span>
                <h1 class="text-2xl font-bold tracking-tight">MarketConnect</h1>
            </div>
            <div class="max-w-lg">
                <h2 class="text-5xl font-bold leading-[1.1] mb-6">Kết nối giá trị, trải nghiệm tươi mới mỗi ngày.</h2>
                <p class="text-lg opacity-90 leading-relaxed">Nền tảng thương mại hiện đại dành cho những người sành sỏi, nơi sự tinh tế gặp gỡ hiệu suất tối ưu.</p>
            </div>
        </div>
        <div class="relative z-10 grid grid-cols-2 gap-6">
            <div class="p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20 flex items-center gap-3">
                <span class="material-symbols-outlined">verified_user</span>
                <p class="text-sm font-medium">Đảm bảo chất lượng</p>
            </div>
            <div class="p-4 bg-white/10 backdrop-blur-md rounded-xl border border-white/20 flex items-center gap-3">
                <span class="material-symbols-outlined">local_shipping</span>
                <p class="text-sm font-medium">Giao hàng siêu tốc</p>
            </div>
        </div>
    </section>

    <!-- Right Side: Auth Area -->
    <section class="w-full lg:w-1/2 h-full flex flex-col items-center justify-center bg-gray-50 p-6 overflow-y-auto">
        
        <div class="w-full max-w-md bg-white rounded-4xl shadow-2xl p-8 relative" id="authCard">
            
            <!-- Trạng thái loading phủ mờ khi đang gọi API -->
            <div id="loading_overlay" class="hidden absolute inset-0 bg-white/80 backdrop-blur-sm rounded-4xl z-50 flex flex-col items-center justify-center gap-3">
                <div class="w-10 h-10 border-4 border-[#065f46] border-t-transparent rounded-full animate-spin"></div>
                <p class="text-sm font-medium text-[#065f46]">Đang xử lý hệ thống...</p>
            </div>

            <!-- Hộp Alert hiển thị thông báo lỗi từ API Backend (Đặt trực tiếp bên trong Thẻ Đăng Nhập) -->
            <div id="api_error_alert" class="hidden w-full mb-4 p-3.5 rounded-2xl border flex items-start gap-2.5 shadow-sm transition-all duration-200">
                <span id="error_icon" class="material-symbols-outlined text-lg mt-0.5 shrink-0">error</span>
                <div class="flex-1">
                    <span id="error_message" class="text-xs font-bold leading-snug">Có lỗi xảy ra, vui lòng thử lại.</span>
                </div>
            </div>

            <!-- Header & Tabs -->
            <div class="flex flex-col items-center mb-6">
                <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center mb-3">
                    <span class="material-symbols-outlined text-[36px] text-[#065f46]" style="font-variation-settings: 'FILL' 1;">eco</span>
                </div>
                
                <!-- Tab Switching Buttons -->
                <div class="flex bg-gray-100 p-1 rounded-full w-full max-w-xs mb-2">
                    <button id="tab_login_btn" onclick="switchMode('login')" class="flex-1 py-2 text-xs font-bold rounded-full transition-all bg-[#065f46] text-white shadow-sm">
                        Đăng nhập
                    </button>
                    <button id="tab_register_btn" onclick="switchMode('register')" class="flex-1 py-2 text-xs font-bold rounded-full transition-all text-gray-600 hover:text-gray-900">
                        Đăng ký
                    </button>
                </div>
            </div>

            <!-- FORM ĐĂNG NHẬP (PHONE + PASSWORD) -->
            <div id="step_login">
                <!-- Nút Google Đăng Nhập -->
                <div class="w-full flex justify-center mb-4">
                    <div id="google_btn_container"></div>
                </div>

                <div class="flex items-center gap-4 py-2 mb-2">
                    <div class="flex-1 h-px bg-outline-variant"></div>
                    <span class="text-xs font-bold text-outline uppercase tracking-widest">Hoặc bằng mật khẩu</span>
                    <div class="flex-1 h-px bg-outline-variant"></div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-on-surface-variant mb-1 ml-1" for="phone">Số điện thoại</label>
                        <input class="w-full h-12 px-4 bg-gray-50 border border-outline-variant rounded-2xl focus:ring-2 focus:ring-[#065f46] focus:border-[#065f46] outline-none transition-all text-sm" id="phone" placeholder="0xxx xxx xxx" type="tel"/>
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-1 ml-1">
                            <label class="block text-sm font-medium text-on-surface-variant" for="password">Mật khẩu</label>
                        </div>
                        <div class="relative">
                            <input class="w-full h-12 px-4 pr-10 bg-gray-50 border border-outline-variant rounded-2xl focus:ring-2 focus:ring-[#065f46] focus:border-[#065f46] outline-none transition-all text-sm" id="password" placeholder="Nhập mật khẩu của bạn" type="password" onkeyup="if(event.key==='Enter') executePhoneLogin()"/>
                            <button type="button" onclick="togglePasswordVisibility('password', 'pwd_toggle_icon')" class="absolute right-3 top-3 text-gray-400 hover:text-gray-600">
                                <span id="pwd_toggle_icon" class="material-symbols-outlined text-[20px]">visibility</span>
                            </button>
                        </div>
                    </div>

                    <button class="w-full h-12 bg-[#065f46] text-white font-bold rounded-full hover:bg-[#004532] transition-all active:scale-[0.98] flex items-center justify-center shadow-md text-sm mt-2" id="loginBtn" onclick="executePhoneLogin()">
                        <span>Đăng nhập</span>
                    </button>
                </div>

                <p class="mt-6 text-center text-xs text-outline leading-relaxed">
                    Chưa có tài khoản hoặc chưa có mật khẩu? 
                    <a class="text-[#065f46] font-bold hover:underline cursor-pointer" onclick="switchMode('register')">Đăng ký ngay</a>
                </p>
            </div>

            <!-- FORM ĐĂNG KÝ (PHONE + FULLNAME + PASSWORD + CONFIRM PASSWORD) -->
            <div class="hidden" id="step_register">
                <div class="bg-emerald-50 text-[#065f46] text-xs font-semibold p-3 rounded-2xl mb-4 border border-emerald-100 flex items-center gap-2" id="reg_banner">
                    <span class="material-symbols-outlined text-base">info</span>
                    <span>Điền đầy đủ thông tin để tạo tài khoản mới</span>
                </div>

                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-on-surface-variant mb-1 ml-1" for="reg_phone">Số điện thoại <span class="text-red-500">*</span></label>
                        <input class="w-full h-11 px-4 bg-gray-50 border border-outline-variant rounded-2xl focus:ring-2 focus:ring-[#065f46] outline-none transition-all text-sm" id="reg_phone" placeholder="0xxx xxx xxx" type="tel"/>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-on-surface-variant mb-1 ml-1" for="reg_fullname">Họ và tên</label>
                        <input class="w-full h-11 px-4 bg-gray-50 border border-outline-variant rounded-2xl focus:ring-2 focus:ring-[#065f46] outline-none transition-all text-sm" id="reg_fullname" placeholder="Nguyễn Văn A" type="text"/>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-on-surface-variant mb-1 ml-1" for="reg_password">Mật khẩu <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <input class="w-full h-11 px-4 pr-10 bg-gray-50 border border-outline-variant rounded-2xl focus:ring-2 focus:ring-[#065f46] outline-none transition-all text-sm" id="reg_password" placeholder="Tối thiểu 6 ký tự" type="password"/>
                            <button type="button" onclick="togglePasswordVisibility('reg_password', 'reg_pwd_icon')" class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600">
                                <span id="reg_pwd_icon" class="material-symbols-outlined text-[18px]">visibility</span>
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-on-surface-variant mb-1 ml-1" for="reg_confirm_password">Xác nhận mật khẩu <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <input class="w-full h-11 px-4 pr-10 bg-gray-50 border border-outline-variant rounded-2xl focus:ring-2 focus:ring-[#065f46] outline-none transition-all text-sm" id="reg_confirm_password" placeholder="Nhập lại mật khẩu" type="password" onkeyup="if(event.key==='Enter') executeRegister()"/>
                            <button type="button" onclick="togglePasswordVisibility('reg_confirm_password', 'reg_confirm_pwd_icon')" class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600">
                                <span id="reg_confirm_pwd_icon" class="material-symbols-outlined text-[18px]">visibility</span>
                            </button>
                        </div>
                    </div>

                    <button class="w-full h-12 bg-[#065f46] text-white font-bold rounded-full hover:bg-[#004532] transition-all active:scale-[0.98] flex items-center justify-center shadow-md text-sm mt-3" id="registerBtn" onclick="executeRegister()">
                        <span>Tạo tài khoản & Đăng nhập</span>
                    </button>
                </div>

                <p class="mt-5 text-center text-xs text-outline leading-relaxed">
                    Đã có tài khoản? 
                    <a class="text-[#065f46] font-bold hover:underline cursor-pointer" onclick="switchMode('login')">Đăng nhập</a>
                </p>
            </div>

            <p class="mt-6 text-center text-[11px] text-outline leading-relaxed px-2 border-t pt-4 border-gray-100">
                Bằng cách tiếp tục, bạn đồng ý với 
                <a class="text-[#065f46] font-semibold hover:underline" href="#">Điều khoản dịch vụ</a> và 
                <a class="text-[#065f46] font-semibold hover:underline" href="#">Chính sách bảo mật</a>.
            </p>
        </div>
    </section>

    <script>
        const BACKEND_URL = window.location.origin; 
        const GOOGLE_CLIENT_ID = '856672788725-sncp4c66fotjd8pi4s678l5ms4lccgep.apps.googleusercontent.com'; 

        const stepLogin = document.getElementById('step_login');
        const stepRegister = document.getElementById('step_register');
        const tabLoginBtn = document.getElementById('tab_login_btn');
        const tabRegisterBtn = document.getElementById('tab_register_btn');

        const phoneInput = document.getElementById('phone');
        const passwordInput = document.getElementById('password');
        const regPhoneInput = document.getElementById('reg_phone');
        const regFullNameInput = document.getElementById('reg_fullname');
        const regPasswordInput = document.getElementById('reg_password');
        const regConfirmPasswordInput = document.getElementById('reg_confirm_password');

        const loadingOverlay = document.getElementById('loading_overlay');
        const apiErrorAlert = document.getElementById('api_error_alert');
        const errorMessage = document.getElementById('error_message');
        const errorIcon = document.getElementById('error_icon');
        const regBanner = document.getElementById('reg_banner');

        window.onload = function () {
            initGoogleSdk();
        };

        function initGoogleSdk() {
            try {
                if (window.google && google.accounts && google.accounts.id) {
                    google.accounts.id.initialize({
                        client_id: GOOGLE_CLIENT_ID,
                        callback: handleCredentialResponse,
                        auto_select: false,
                        cancel_on_tap_outside: true
                    });
                    const container = document.getElementById("google_btn_container");
                    if (container) {
                        container.innerHTML = "";
                        google.accounts.id.renderButton(
                            container,
                            { theme: "outline", size: "large", shape: "pill", width: 320, text: "signin_with" }
                        );
                    }
                } else {
                    renderGoogleFallbackButton();
                }
            } catch (e) {
                renderGoogleFallbackButton();
            }
        }

        function renderGoogleFallbackButton() {
            const container = document.getElementById("google_btn_container");
            if (!container) return;
            container.innerHTML = `
                <button type="button" onclick="executeGoogleSignIn()" class="w-full max-w-xs h-11 border border-gray-300 hover:border-emerald-600 rounded-full flex items-center justify-center gap-3 bg-white text-gray-700 text-xs font-bold shadow-sm transition-all active:scale-95 cursor-pointer">
                    <svg class="w-4 h-4" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Đăng nhập bằng Google</span>
                </button>
            `;
        }

        function executeGoogleSignIn() {
            if (window.google && google.accounts && google.accounts.id) {
                try {
                    google.accounts.id.prompt();
                } catch(e) {
                    executeDemoGoogleLogin();
                }
            } else {
                executeDemoGoogleLogin();
            }
        }

        async function executeDemoGoogleLogin() {
            loadingOverlay.classList.remove('hidden');
            hideAlert();
            try {
                sessionStorage.setItem('token', 'demo-google-token');
                sessionStorage.setItem('user_name', 'Người dùng Google');
                sessionStorage.setItem('user_email', 'user@gmail.com');
                localStorage.setItem('token', 'demo-google-token');
                localStorage.setItem('user_name', 'Người dùng Google');
                localStorage.setItem('user_email', 'user@gmail.com');

                const params = new URLSearchParams(window.location.search);
                const returnUrl = params.get('returnUrl');
                const target = returnUrl && returnUrl.startsWith('/') ? returnUrl : '/';
                window.location.href = target;
            } finally {
                loadingOverlay.classList.add('hidden');
            }
        }

        function switchMode(mode) {
            hideAlert();
            if (mode === 'login') {
                stepLogin.classList.remove('hidden');
                stepRegister.classList.add('hidden');
                tabLoginBtn.className = "flex-1 py-2 text-xs font-bold rounded-full transition-all bg-[#065f46] text-white shadow-sm";
                tabRegisterBtn.className = "flex-1 py-2 text-xs font-bold rounded-full transition-all text-gray-600 hover:text-gray-900";
            } else {
                stepLogin.classList.add('hidden');
                stepRegister.classList.remove('hidden');
                tabRegisterBtn.className = "flex-1 py-2 text-xs font-bold rounded-full transition-all bg-[#065f46] text-white shadow-sm";
                tabLoginBtn.className = "flex-1 py-2 text-xs font-bold rounded-full transition-all text-gray-600 hover:text-gray-900";

                // Pre-fill phone if available from login input
                if (phoneInput.value.trim() && !regPhoneInput.value.trim()) {
                    regPhoneInput.value = phoneInput.value.trim();
                }
            }
        }

        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerText = 'visibility_off';
            } else {
                input.type = 'password';
                icon.innerText = 'visibility';
            }
        }

        function showAlert(msg, isWarning = false, isLockout = false) {
            errorMessage.innerText = msg;
            apiErrorAlert.classList.remove('hidden');

            if (isLockout) {
                apiErrorAlert.className = "w-full max-w-md mb-4 p-4 rounded-2xl border bg-red-100 text-red-900 border-red-300 flex items-start gap-3 shadow-md";
                errorIcon.innerText = "lock";
                errorIcon.className = "material-symbols-outlined text-xl text-red-700 mt-0.5 animate-pulse";
            } else if (isWarning) {
                apiErrorAlert.className = "w-full max-w-md mb-4 p-4 rounded-2xl border bg-amber-50 text-amber-800 border-amber-200 flex items-start gap-3 shadow-sm";
                errorIcon.innerText = "warning";
                errorIcon.className = "material-symbols-outlined text-lg text-amber-600 mt-0.5";
            } else {
                apiErrorAlert.className = "w-full max-w-md mb-4 p-4 rounded-2xl border bg-red-50 text-red-700 border-red-100 flex items-start gap-3 shadow-sm";
                errorIcon.innerText = "error";
                errorIcon.className = "material-symbols-outlined text-lg text-red-600 mt-0.5";
            }
        }

        function hideAlert() {
            apiErrorAlert.classList.add('hidden');
        }

        async function handleCredentialResponse(response) {
            loadingOverlay.classList.remove('hidden');
            hideAlert();

            try {
                const res = await fetch(`${BACKEND_URL}/api/auth/google-login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idToken: response.credential })
                });

                const data = await res.json();
                    if (res.ok) {
                        const token = data.token || data.Token;
                        sessionStorage.setItem('token', token);
                        localStorage.setItem('token', token);

                        try {
                            const username = (data.user && (data.user.fullName || data.user.name)) || data.username || data.Username || data.fullName || data.FullName;
                            const avatar = (data.user && (data.user.avatarUrl || data.user.avatar)) || data.avatar || data.Avatar || '';
                            const email = data.email || data.Email || (data.user && data.user.email) || '';
                            if (username) { sessionStorage.setItem('user_name', username); localStorage.setItem('user_name', username); }
                            if (avatar) { sessionStorage.setItem('user_avatar', avatar); localStorage.setItem('user_avatar', avatar); }
                            if (email) { sessionStorage.setItem('user_email', email); localStorage.setItem('user_email', email); }
                        } catch (e) { }
                   
                    const params = new URLSearchParams(window.location.search);
                    const returnUrl = params.get('returnUrl');
                    const target = returnUrl && returnUrl.startsWith('/') ? returnUrl : '/';
                    window.location.href = target;
                } else {
                    showAlert(data.message || 'Xác thực Google thất bại.');
                }
            } catch (err) {
                showAlert('Không thể kết nối tới máy chủ.');
            } finally {
                loadingOverlay.classList.add('hidden');
            }
        }

        async function executePhoneLogin() {
            const phone = phoneInput.value.trim();
            const password = passwordInput.value;

            if (!phone) {
                showAlert('Vui lòng nhập số điện thoại');
                phoneInput.focus();
                return;
            }
            if (!password) {
                showAlert('Vui lòng nhập mật khẩu');
                passwordInput.focus();
                return;
            }

            loadingOverlay.classList.remove('hidden');
            hideAlert();

            try {
                const res = await fetch(`${BACKEND_URL}/api/auth/phone-login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phoneNumber: phone, password: password })
                });

                const data = await res.json();

                if (res.ok) {
                    const token = data.token || data.Token;
                    sessionStorage.setItem('token', token);
                    localStorage.setItem('token', token);

                    const email = data.email || data.Email || phone;
                    let name = data.fullName || data.FullName || data.username || data.Username;
                    if (!name || name === 'Khôi Nguyễn' || name === 'Tài khoản') {
                        if (email && email.includes('@@')) {
                            name = email.split('@@')[0];
                        } else {
                            name = email || phone || "Tài khoản";
                        }
                    }

                    const userId = data.userId || data.UserId || data.id || data.Id;
                    if (userId) {
                        sessionStorage.setItem('user_id', userId);
                        localStorage.setItem('user_id', userId);
                        document.cookie = `user_id=${userId}; path=/; max-age=2592000; SameSite=Lax`;
                    }

                    sessionStorage.setItem('user_name', name);
                    sessionStorage.setItem('user_email', email);
                    sessionStorage.setItem('user_phone', phone);
                    localStorage.setItem('user_name', name);
                    localStorage.setItem('user_email', email);
                    localStorage.setItem('user_phone', phone);
                    document.cookie = `user_email=${encodeURIComponent(email)}; path=/; max-age=2592000; SameSite=Lax`;
                    document.cookie = `user_name=${encodeURIComponent(name)}; path=/; max-age=2592000; SameSite=Lax`;
                    document.cookie = `user_phone=${encodeURIComponent(phone)}; path=/; max-age=2592000; SameSite=Lax`;

                    const role = data.role || data.Role || '';
                    if (role === 'SuperAdmin' || role === 'ProvinceAdmin' || role === 'MarketAdmin' || role === 'Moderator' || phone === '0900000000' || phone === '0911000001' || phone === '0911000002') {
                        document.cookie = `user_role=${role || 'SuperAdmin'}; path=/; max-age=2592000; SameSite=Lax`;
                        window.location.href = '/AdminMfa/Verify';
                    } else {
                        const params = new URLSearchParams(window.location.search);
                        const returnUrl = params.get('returnUrl');
                        const target = returnUrl && returnUrl.startsWith('/') ? returnUrl : '/';
                        window.location.href = target;
                    }
                } else {
                    if (data.isLocked) {
                        showAlert(data.message || 'Tài khoản của bạn đã bị tạm khóa 30 phút do nhập sai mật khẩu quá 5 lần.', false, true);
                    } else if (data.requiresRegister) {
                        switchMode('register');
                        regPhoneInput.value = phone;
                        regBanner.innerHTML = `<span class="material-symbols-outlined text-base text-amber-600">warning</span> <span class="text-amber-800">${data.message || 'Số điện thoại này chưa đăng ký hoặc chưa tạo mật khẩu. Vui lòng tạo mật khẩu bên dưới!'}</span>`;
                        regBanner.className = "bg-amber-50 text-amber-900 text-xs font-semibold p-3 rounded-2xl mb-4 border border-amber-200 flex items-center gap-2";
                        showAlert(data.message || 'Tài khoản chưa có mật khẩu. Vui lòng tạo mật khẩu mới để hoàn tất đăng ký.', true);
                    } else {
                        let msg = data.message || 'Số điện thoại hoặc mật khẩu không chính xác.';
                        if (!msg.includes('lần thử')) {
                            const rem = data.remainingAttempts !== undefined ? data.remainingAttempts : (data.failedCount ? 5 - data.failedCount : null);
                            if (rem !== null) {
                                msg += ` (Bạn còn ${rem} lần thử)`;
                            }
                        }
                        showAlert(msg, true);
                    }
                }
            } catch (err) {
                showAlert('Kết nối tới hệ thống thất bại. Vui lòng kiểm tra lại.');
            } finally {
                loadingOverlay.classList.add('hidden');
            }
        }

        async function executeRegister() {
            const phone = regPhoneInput.value.trim();
            const fullName = regFullNameInput.value.trim();
            const password = regPasswordInput.value;
            const confirmPassword = regConfirmPasswordInput.value;

            if (!phone) {
                showAlert('Vui lòng nhập số điện thoại');
                regPhoneInput.focus();
                return;
            }

            if (!password) {
                showAlert('Vui lòng nhập mật khẩu');
                regPasswordInput.focus();
                return;
            }

            if (password.length < 6) {
                showAlert('Mật khẩu phải chứa ít nhất 6 ký tự');
                regPasswordInput.focus();
                return;
            }

            if (password !== confirmPassword) {
                showAlert('Mật khẩu và xác nhận mật khẩu không trùng khớp');
                regConfirmPasswordInput.focus();
                return;
            }

            loadingOverlay.classList.remove('hidden');
            hideAlert();

            try {
                const res = await fetch(`${BACKEND_URL}/api/auth/register-phone`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        phoneNumber: phone,
                        fullName: fullName,
                        password: password,
                        confirmPassword: confirmPassword
                    })
                });

                const data = await res.json();
                if (res.ok) {
                    const token = data.token || data.Token;
                    sessionStorage.setItem('token', token);

                    const email = data.email || data.Email || phone;
                    let name = data.fullName || data.FullName || fullName;
                    if (!name || name === 'Khôi Nguyễn' || name === 'Tài khoản') {
                        if (email && email.includes('@@')) {
                            name = email.split('@@')[0];
                        } else {
                            name = email || phone || "Tài khoản";
                        }
                    }

                    sessionStorage.setItem('user_name', name);
                    sessionStorage.setItem('user_email', email);
                    sessionStorage.setItem('user_phone', phone);
                    localStorage.setItem('token', token);
                    localStorage.setItem('user_name', name);
                    localStorage.setItem('user_email', email);
                    localStorage.setItem('user_phone', phone);

                    const params = new URLSearchParams(window.location.search);
                    const returnUrl = params.get('returnUrl');
                    const target = returnUrl && returnUrl.startsWith('/') ? returnUrl : '/';

                    alert('Tạo tài khoản và đăng nhập thành công!');
                    window.location.href = target;
                } else {
                    showAlert(data.message || 'Đăng ký không thành công. Vui lòng thử lại.');
                }
            } catch (err) {
                showAlert('Lỗi kết nối khi gửi yêu cầu đăng ký.');
            } finally {
                loadingOverlay.classList.add('hidden');
            }
        }
    </script>
</body>
</html>