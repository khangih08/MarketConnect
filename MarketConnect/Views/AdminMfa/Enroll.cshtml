@{
    Layout = "_Layout";
    ViewData["Title"] = "Cài Đặt Ứng Dụng Xác Thực MFA | MarketConnect";
    var tempSecret = ViewBag.TempSecret as string ?? "MCSECRET2026";
}

<main class="max-w-[1440px] mx-auto w-full px-4 md:px-16 py-12">
    <div class="max-w-md mx-auto bg-white border border-gray-200 rounded-3xl p-8 shadow-xl space-y-6">
        <div class="text-center space-y-2">
            <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center mx-auto shadow-sm">
                <span class="material-symbols-outlined text-[36px]">qr_code_2</span>
            </div>
            <h2 class="text-2xl font-extrabold text-gray-900">Kích Hoạt Bảo Mật MFA</h2>
            <p class="text-xs text-gray-500">Quét mã hoặc nhập chuỗi bí mật bên dưới vào Google Authenticator / Authy.</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="p-4 bg-red-50 text-red-800 rounded-2xl text-xs font-bold border border-red-200 flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">error</span>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <div class="bg-emerald-50/70 p-5 rounded-2xl border border-emerald-200 text-center space-y-3">
            <div class="text-xs font-bold text-emerald-950 uppercase tracking-wider">Chuỗi mã khóa thiết bị (Secret):</div>
            <div class="bg-white p-3 rounded-xl border border-emerald-300 font-mono text-base font-extrabold text-emerald-900 tracking-wider select-all shadow-2xs">
                @tempSecret
            </div>
            <p class="text-[11px] text-emerald-800 italic">Mã bí mật sẽ được mã hóa bảo vệ tự động và ẩn vĩnh viễn sau khi hoàn tất thiết lập.</p>
        </div>

        <form method="post" action="/AdminMfa/VerifyEnroll" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tempSecret" value="@tempSecret" />

            <div>
                <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wider">Nhập mã OTP 6 số để xác nhận:</label>
                <input type="text" name="passcode" required maxlength="6" autofocus placeholder="123456" class="w-full text-center text-2xl font-mono tracking-widest bg-gray-50 border border-gray-200 rounded-2xl py-3 text-gray-900 outline-none focus:border-emerald-700 focus:bg-white transition-all" />
            </div>

            <button type="submit" class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-extrabold py-3.5 rounded-2xl text-sm shadow-md transition-all cursor-pointer flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span>Kích Hoạt & Mã Hóa Bảo Mật</span>
            </button>
        </form>
    </div>
</main>
