@{
    Layout = "_Layout";
    ViewData["Title"] = "Xác Thực Bảo Mật Quản Trị MFA | MarketConnect";
}

<main class="max-w-[1440px] mx-auto w-full px-4 md:px-16 py-12">
    <div class="max-w-md mx-auto bg-white border border-gray-200 rounded-3xl p-8 shadow-xl space-y-6">
        <div class="text-center space-y-2">
            <div class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center mx-auto shadow-sm">
                <span class="material-symbols-outlined text-[36px]">security</span>
            </div>
            <h2 class="text-2xl font-extrabold text-gray-900">Xác Thực Quản Trị MFA</h2>
            <p class="text-xs text-gray-500">Nhập mã xác thực OTP từ ứng dụng Authenticator hoặc sử dụng mã thử nghiệm <strong>123456</strong>.</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="p-4 bg-red-50 text-red-800 rounded-2xl text-xs font-bold border border-red-200 flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">error</span>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <form method="post" action="/AdminMfa/Verify" class="space-y-5" id="mfaForm">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-bold text-gray-700 mb-1.5 uppercase tracking-wider">Mã OTP Quản Trị (6 chữ số):</label>
                <input type="text" id="passcodeInput" name="passcode" required maxlength="6" autofocus placeholder="123456" class="w-full text-center text-2xl font-mono tracking-widest bg-gray-50 border border-gray-200 rounded-2xl py-3 text-gray-900 outline-none focus:border-amber-600 focus:bg-white transition-all" />
            </div>

            <div class="flex gap-2">
                <button type="button" onclick="fillTestCode()" class="w-1/3 bg-amber-50 hover:bg-amber-100 text-amber-900 font-bold py-3.5 rounded-2xl text-xs border border-amber-300 transition-all cursor-pointer flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-sm">bolt</span> Nhanh 123456
                </button>
                <button type="submit" class="w-2/3 bg-amber-600 hover:bg-amber-700 text-white font-extrabold py-3.5 rounded-2xl text-sm shadow-md transition-all cursor-pointer flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">verified_user</span>
                    <span>Xác Nhận & Tiếp Tục</span>
                </button>
            </div>
        </form>

        <script>
            function fillTestCode() {
                const input = document.getElementById('passcodeInput');
                if (input) {
                    input.value = '123456';
                    document.getElementById('mfaForm').submit();
                }
            }
        </script>

        <div class="text-center pt-2 border-t border-gray-100">
            <a href="/AdminMfa/Enroll" class="text-xs font-bold text-emerald-700 hover:underline flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-sm">qr_code_2</span> Kích hoạt / Cài đặt lại ứng dụng Authenticator &rarr;
            </a>
        </div>
    </div>
</main>
