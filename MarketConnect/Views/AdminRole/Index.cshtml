@model List<MarketConnect.Data.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Phân Quyền & Phạm Vi Dữ Liệu Quản Trị (RBAC & Data Scope FR-08)";
    var markets = ViewBag.Markets as List<MarketConnect.Data.Market> ?? new List<MarketConnect.Data.Market>();
    var provinces = ViewBag.Provinces as List<MarketConnect.Data.Province> ?? new List<MarketConnect.Data.Province>();
}

<div class="space-y-6">
    <!-- Header Title -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-800 text-3xl">vpn_key</span>
                <span>Quản Lý Phân Quyền Roles & Phạm Vi Dữ Liệu (RBAC & Scope FR-08)</span>
            </h1>
            <p class="text-xs text-slate-500 mt-1">Cấp quyền vai trò tài khoản, ma trận Permissions và gán phạm vi địa lý (AdminScope Tỉnh/Chợ) chống nâng quyền trái phép.</p>
        </div>
        <a href="/Moderation" class="px-4 py-2 bg-emerald-800 text-white font-extrabold rounded-2xl text-xs shadow-sm flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">gavel</span> Quay lại Hàng Đợi Kiểm Duyệt &rarr;
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 text-emerald-800 rounded-2xl text-xs font-bold border border-emerald-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-red-50 text-red-800 rounded-2xl text-xs font-bold border border-red-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">warning</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- 1. ROLES & PERMISSIONS MATRIX (LAYOUT SECTION 7) -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h3 class="font-extrabold text-sm text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-purple-700">shield_lock</span> Ma Trận Quyền Hạn Theo Vai Trò (Permissions Matrix)
        </h3>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-purple-50 text-purple-900 font-extrabold uppercase tracking-wider text-[10px]">
                        <th class="p-3">Vai Trò (Role)</th>
                        <th class="p-2 text-center">CONTENT_VIEW</th>
                        <th class="p-2 text-center">CONTENT_APPROVE</th>
                        <th class="p-2 text-center">CONTENT_REJECT</th>
                        <th class="p-2 text-center">CONTENT_EDIT_REQ</th>
                        <th class="p-2 text-center">CONTENT_HIDE</th>
                        <th class="p-2 text-center">CONTENT_ESCALATE</th>
                        <th class="p-2 text-center">ROLE_ASSIGN</th>
                        <th class="p-2 text-center">SYSTEM_CONFIG</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-purple-100 text-[11px] font-bold text-slate-700">
                    <tr>
                        <td class="p-3 text-purple-900 font-black">Super Admin</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                    </tr>
                    <tr>
                        <td class="p-3 text-blue-900 font-black">Province Admin</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-slate-300">☐</td>
                        <td class="p-2 text-center text-slate-300">☐</td>
                    </tr>
                    <tr>
                        <td class="p-3 text-emerald-900 font-black">Market Admin / Moderator</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-emerald-600">☑</td>
                        <td class="p-2 text-center text-slate-300">☐</td>
                        <td class="p-2 text-center text-slate-300">☐</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. DATA SCOPE PER USER TABLE (LAYOUT SECTION 8) -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h3 class="font-extrabold text-sm text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-emerald-700">map</span> Gán Phạm Vi Quản Trị Dữ Liệu (Administrative Data Scope)
        </h3>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700 border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-900 font-extrabold uppercase tracking-wider text-[11px]">
                        <th class="p-3.5">ID</th>
                        <th class="p-3.5">Họ Tên / Email</th>
                        <th class="p-3.5">Vai Trò Hiện Tại</th>
                        <th class="p-3.5">Phạm Vi Dữ Liệu Đã Gán (AdminScope)</th>
                        <th class="p-3.5 text-right">Thao Tác Đổi Role / Gán Scope</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var u in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="p-3.5 font-bold text-slate-900">#@u.Id</td>
                            <td class="p-3.5">
                                <div class="font-extrabold text-slate-900">@(u.Name ?? "Chưa đặt tên")</div>
                                <div class="text-[11px] text-slate-500">@u.Email (@(u.Phone ?? "Chưa có SĐT"))</div>
                            </td>
                            <td class="p-3.5">
                                <span class="px-2.5 py-1 rounded-full font-black text-[11px] @(u.Role == MarketConnect.Data.UserRole.SuperAdmin ? "bg-purple-100 text-purple-900 border border-purple-300" : u.Role == MarketConnect.Data.UserRole.ProvinceAdmin ? "bg-blue-100 text-blue-900 border border-blue-300" : u.Role == MarketConnect.Data.UserRole.MarketAdmin || u.Role == MarketConnect.Data.UserRole.Moderator ? "bg-emerald-100 text-emerald-900 border border-emerald-300" : "bg-slate-100 text-slate-700")">
                                    @u.Role.ToString()
                                </span>
                            </td>
                            <td class="p-3.5">
                                @if (u.AdminScopes != null && u.AdminScopes.Any())
                                {
                                    <div class="space-y-1">
                                        @foreach (var s in u.AdminScopes)
                                        {
                                            <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-900 border border-emerald-200 text-[10px] font-black">
                                                <span>☑ @s.ScopeLevel:</span>
                                                @if (s.Market != null) { <span>@s.Market.Name</span> }
                                                else if (s.Province != null) { <span>@s.Province.Name</span> }
                                                else { <span>Toàn hệ thống</span> }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-slate-400 italic">Chưa gán phạm vi (Data Scope)</span>
                                }
                            </td>
                            <td class="p-3.5 text-right">
                                <div class="flex items-center justify-end gap-2 flex-wrap">
                                    <!-- Form Đổi Role -->
                                    <form method="post" action="/AdminRole/AssignRole" class="flex items-center gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="targetUserId" value="@u.Id" />
                                        <select name="newRole" class="bg-slate-50 border border-slate-200 rounded-xl px-2 py-1 text-[11px] font-bold outline-none">
                                            @foreach (MarketConnect.Data.UserRole r in Enum.GetValues(typeof(MarketConnect.Data.UserRole)))
                                            {
                                                <option value="@r" selected="@(r == u.Role)">@r.ToString()</option>
                                            }
                                        </select>
                                        <button type="submit" class="bg-purple-800 hover:bg-purple-900 text-white font-bold px-2.5 py-1 rounded-xl text-[11px] cursor-pointer">
                                            Đổi Role
                                        </button>
                                    </form>

                                    <!-- Form Gán AdminScope -->
                                    <form method="post" action="/AdminRole/AssignScope" class="flex items-center gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="targetUserId" value="@u.Id" />
                                        <select name="scopeLevel" class="bg-slate-50 border border-slate-200 rounded-xl px-2 py-1 text-[11px] font-bold outline-none">
                                            <option value="Market">Chợ</option>
                                            <option value="Province">Tỉnh</option>
                                            <option value="System">Hệ Thống</option>
                                        </select>
                                        <select name="marketId" class="bg-slate-50 border border-slate-200 rounded-xl px-2 py-1 text-[11px] outline-none max-w-[120px]">
                                            <option value="">-- Chọn chợ --</option>
                                            @foreach (var m in markets)
                                            {
                                                <option value="@m.Id">@m.Name</option>
                                            }
                                        </select>
                                        <button type="submit" class="bg-emerald-800 hover:bg-emerald-900 text-white font-bold px-2.5 py-1 rounded-xl text-[11px] cursor-pointer">
                                            + Scope
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
