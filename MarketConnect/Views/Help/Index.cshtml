@{
    Layout = "_Layout";
    ViewData["Title"] = "Trung Tâm Trợ Giúp & Hướng Dẫn | MarketConnect";
}

<main class="max-w-[1440px] mx-auto w-full px-4 md:px-16 py-8 space-y-8">
    <!-- Header -->
    <div class="bg-gradient-to-r from-[#004532] to-[#065f46] text-white rounded-3xl p-8 shadow-lg text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2">
            <h1 class="text-2xl md:text-3xl font-extrabold flex items-center justify-center md:justify-start gap-2">
                <span class="material-symbols-outlined text-3xl text-amber-400">help_center</span> Trung Tâm Trợ Giúp MarketConnect
            </h1>
            <p class="text-sm text-emerald-100 max-w-xl">Giải đáp thắc mắc dành cho Người mua hàng và Tiểu thương bán hàng tại các Chợ Nông sản Nội thành Hà Nội.</p>
        </div>
        <a href="#faq" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-6 py-3 rounded-2xl shadow transition-all shrink-0 text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-base">quiz</span> Câu hỏi thường gặp
        </a>
    </div>

    <!-- Quick Navigation Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow space-y-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-2xl">shopping_cart</span>
            </div>
            <h3 class="font-extrabold text-base text-gray-900">Dành cho Người Mua</h3>
            <p class="text-xs text-gray-500">Cách chọn chợ gần nhất, tìm sản phẩm tươi ngon, gửi đơn mua trực tiếp tới quầy tiểu thương.</p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow space-y-3">
            <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-2xl">storefront</span>
            </div>
            <h3 class="font-extrabold text-base text-gray-900">Dành cho Tiểu Thương</h3>
            <p class="text-xs text-gray-500">Đăng ký mở gian hàng trực tuyến, quản lý sản phẩm, tiếp nhận và xử lý đơn hàng gửi đến quầy.</p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow space-y-3">
            <div class="w-12 h-12 rounded-xl bg-cyan-100 text-cyan-800 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-2xl">two_wheeler</span>
            </div>
            <h3 class="font-extrabold text-base text-gray-900">Gọi Hàng Rong & Bản Đồ</h3>
            <p class="text-xs text-gray-500">Cách xem định vị xe hàng rong di động trên bản đồ vệ tinh GPS thực tế theo thời gian thực.</p>
        </div>
    </div>

    <!-- FAQ Accordion -->
    <div id="faq" class="bg-white border border-gray-200 rounded-3xl p-6 md:p-8 shadow-sm space-y-6">
        <h2 class="text-xl font-extrabold text-gray-900 flex items-center gap-2 border-b border-gray-100 pb-4">
            <span class="material-symbols-outlined text-emerald-700">quiz</span> Câu Hỏi Thường Gặp (FAQ)
        </h2>

        <div class="space-y-4">
            <details class="group bg-gray-50 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden" open>
                <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-800">
                    <span>1. Tôi làm thế nào để đăng ký trở thành Tiểu Thương bán hàng?</span>
                    <span class="material-symbols-outlined text-gray-400 group-open:rotate-180 transition-transform">expand_more</span>
                </summary>
                <p class="mt-3 text-xs text-gray-600 leading-relaxed border-t border-gray-200/60 pt-3">
                    Bạn vào menu tài khoản chọn <strong>Đăng ký bán hàng</strong> (hoặc nhấn vào nút Đăng ký bán hàng ở thanh Header). Bạn điền thông tin tên gian hàng, vị trí số quầy trong chợ và tải ảnh xác thực. Ban quản trị chợ sẽ xác minh và duyệt hồ sơ của bạn trong vòng 24h.
                </p>
            </details>

            <details class="group bg-gray-50 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-800">
                    <span>2. Đơn hàng gửi tới quầy được xử lý như thế nào?</span>
                    <span class="material-symbols-outlined text-gray-400 group-open:rotate-180 transition-transform">expand_more</span>
                </summary>
                <p class="mt-3 text-xs text-gray-600 leading-relaxed border-t border-gray-200/60 pt-3">
                    Khi người mua tạo đơn mua, thông báo sẽ gửi tới tiểu thương. Tiểu thương vào mục <strong>Kênh tiểu thương &rarr; Đơn đặt mua gửi đến quầy</strong> để xem sđt khách hàng, xác nhận số lượng tồn kho và thỏa thuận phương thức nhận hàng.
                </p>
            </details>

            <details class="group bg-gray-50 rounded-2xl p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-gray-800">
                    <span>3. Tôi có thể đổi vị trí Chợ mặc định được không?</span>
                    <span class="material-symbols-outlined text-gray-400 group-open:rotate-180 transition-transform">expand_more</span>
                </summary>
                <p class="mt-3 text-xs text-gray-600 leading-relaxed border-t border-gray-200/60 pt-3">
                    Có! Hệ thống tự động chọn chợ gần bạn nhất theo GPS. Bạn cũng có thể bấm vào tên Chợ ở góc trên bên trái thanh tìm kiếm để chọn bất kỳ chợ nào khác trong nội thành Hà Nội.
                </p>
            </details>
        </div>
    </div>
</main>
