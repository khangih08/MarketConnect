    <!-- Interactive JavaScript Logic -->
    <script>
        // 1. Toast Notification Helper
        function showToast(msg) {
            const toast = document.getElementById('toastNotification');
            const toastMsg = document.getElementById('toastMessage');
            if (toast && toastMsg) {
                toastMsg.innerText = msg;
                toast.classList.remove('hidden');
                setTimeout(() => toast.classList.add('hidden'), 3500);
            }
        }

        // 2. User Dropdown Toggle
        function toggleUserDropdown(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('userDropdownMenu');
            if (menu) menu.classList.toggle('hidden');
        }

        // 3. Market Dropdown Selector
        function toggleMarketDropdownMenu(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('marketDropdownMenu');
            const chevron = document.getElementById('marketChevron');
            if (menu) {
                menu.classList.toggle('hidden');
                if (chevron) chevron.classList.toggle('rotate-180');
            }
        }

        document.addEventListener('click', function(e) {
            const marketMenu = document.getElementById('marketDropdownMenu');
            const userMenu = document.getElementById('userDropdownMenu');
            if (marketMenu && !marketMenu.classList.contains('hidden')) marketMenu.classList.add('hidden');
            if (userMenu && !userMenu.classList.contains('hidden')) userMenu.classList.add('hidden');
        });

        function onMarketOptionClick(btn) {
            if (!btn) return;
            const marketId = btn.getAttribute('data-market-id');
            const marketName = btn.getAttribute('data-market-name');
            const address = btn.getAttribute('data-market-address');
            const distText = btn.getAttribute('data-market-dist');
            selectActiveMarket(marketId, marketName, address, distText);
        }

        function selectActiveMarket(marketId, marketName, address, distText) {
            document.cookie = "SelectedMarketId=" + marketId + "; path=/; max-age=2592000";
            sessionStorage.setItem('selected_market_id', marketId);
            sessionStorage.setItem('selected_market_name', marketName);
            sessionStorage.setItem('selected_market', marketName);
            localStorage.setItem('selected_market_id', marketId);
            localStorage.setItem('selected_market_name', marketName);
            localStorage.setItem('selected_market', marketName);
            localStorage.setItem('selected_market_user_choice', marketName);

            const displayDist = distText ? distText.toLowerCase() : 'cách 1.2 km';
            const nameElem = document.getElementById('currentSelectedMarketName');
            if (nameElem) nameElem.innerText = marketName;
            const badgeElem = document.getElementById('currentSelectedMarketBadge');
            if (badgeElem) badgeElem.innerText = displayDist;
            const titleElem = document.getElementById('marketTitleHeading');
            if (titleElem) titleElem.innerText = marketName;
            const pinElem = document.getElementById('mapPinMarketName');
            if (pinElem) pinElem.innerText = marketName;
            const breadcrumbElem = document.getElementById('breadcrumbCurrentMarket');
            if (breadcrumbElem) breadcrumbElem.innerText = marketName + ' - ' + displayDist;
            const merchantElem = document.getElementById('merchantSectionHeading');
            if (merchantElem) merchantElem.innerText = 'Tiểu thương tiêu biểu tại ' + marketName;
            
            if (address && address.trim() !== '') {
                const addrElem = document.getElementById('marketAddressDisplay');
                if (addrElem) addrElem.innerText = address;
            }

            showToast('Đã chuyển sang xem thông tin ' + marketName);
            const targetUrl = new URL(window.location.href);
            targetUrl.searchParams.set('marketId', marketId);
            window.location.href = targetUrl.toString();
        }

        // 4. Photo Gallery Dataset Per Market (Dynamic & Accurate Count)
        const marketGalleriesData = {
            'cho-nhan-chinh': [
                'https://lh3.googleusercontent.com/aida-public/AB6AXuBv_dm10PMDGYVg5t3nYcGJHyFi2DrI2dYZ0X3YKRrrod-pGCBimI5jVl4zqIDGlAYggLMT47Uwa9Okz707yd9QRWRbskAOndIgBiOxxShliS1RSkXlO2PzMiNa5zZ8EW_buQlwWKG1Tlzr7hwea7jRSheArvLJuXi2hwYzY-fqnV0KIHNbxl35u2RedRceYnIl_kdA_Hg0gbjBFiaDKfxeobrGQEdn9ydqRkqA_xoGaxf42OybRtxm',
                'https://images.unsplash.com/photo-1542838132-92c53300491e?w=800',
                'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=800',
                'https://images.unsplash.com/photo-1588168333986-5078d3ae3976?w=800',
                'https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?w=800'
            ],
            'cho-dong-xuan': [
                'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=800',
