    <!-- Modal Chọn Chợ Theo Tỉnh -> Quận -> Phường -> Chợ -->
    <div id="cascadingLocationModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 space-y-5 shadow-2xl">
            <div class="flex justify-between items-center pb-3 border-b border-gray-100">
                <h3 class="font-extrabold text-base text-gray-900 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">pin_drop</span> Chọn Chợ Theo Tỉnh → Quận → Phường
                </h3>
                <button type="button" onclick="closeCascadingLocationModal()" class="text-gray-400 hover:text-gray-700 text-2xl font-bold cursor-pointer">✕</button>
