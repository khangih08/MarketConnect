            <div class="space-y-4 text-xs">
                <!-- Bước 1: Chọn Tỉnh / Thành Phố -->
                <div>
                    <label class="block font-bold text-gray-700 mb-1">1. Chọn Tỉnh / Thành Phố (*)</label>
                    <select id="modalProvinceSelect" onchange="onProvinceChanged()" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 outline-none focus:border-primary font-medium">
                        <option value="">-- Chọn Tỉnh / Thành phố --</option>
