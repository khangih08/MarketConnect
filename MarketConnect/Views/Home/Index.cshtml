                <!-- Bước 4: Chọn Chợ -->
                <div>
                    <label class="block font-bold text-gray-700 mb-1">4. Chọn Chợ Tương Ứng (*)</label>
                    <select id="modalMarketSelect" disabled class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 outline-none focus:border-primary font-bold text-emerald-800 disabled:opacity-50">
                        <option value="">-- Chọn Chợ --</option>
                    </select>
                </div>

                <button type="button" onclick="confirmSelectedMarketFromModal()" class="w-full bg-primary hover:bg-primary-container text-white font-extrabold py-3 rounded-xl transition-all shadow-md active:scale-95 cursor-pointer mt-2">
                    Xác Nhận Chọn Chợ
