@using System.Linq
@using MarketConnect.Data
@model IEnumerable<Product>
@{
    Layout = null; // Tự chứa toàn bộ thiết kế HTML chuẩn theo thiết kế được cung cấp
    var selectedMarket = ViewBag.SelectedMarket as Market;
    var markets = ViewBag.Markets as List<Market> ?? new List<Market>();
    var stores = ViewBag.Stores as List<Store> ?? new List<Store>();
    var cartCount = ViewBag.CartItemCount ?? 3;

    string ComputeDistanceText(double mLat, double mLng)
    {
        double refLat = 21.0040;
        double refLng = 105.8050;
        if (mLat == 0 || mLng == 0) return "Cách 1.2 km";
        double r = 6371.0;
        double dLat = (mLat - refLat) * Math.PI / 180.0;
        double dLon = (mLng - refLng) * Math.PI / 180.0;
        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                   Math.Cos(refLat * Math.PI / 180.0) * Math.Cos(mLat * Math.PI / 180.0) *
                   Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        double c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        double dist = Math.Round(r * c, 1);
        if (dist < 0.2) return "Cách 0.5 km";
        return $"Cách {dist:0.0} km";
    }

    var selectedMarketDistText = selectedMarket != null ? ComputeDistanceText(selectedMarket.Latitude, selectedMarket.Longitude) : "Cách 0.5 km";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Chợ Việt Online - MarketConnect</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
