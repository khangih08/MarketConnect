                <!-- Bước 2: Chọn Quận / Huyện -->
                <div>
                    <label class="block font-bold text-gray-700 mb-1">2. Chọn Quận / Huyện (*)</label>
                    <select id="modalDistrictSelect" onchange="onDistrictChanged()" disabled class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 outline-none focus:border-primary font-medium disabled:opacity-50">
                        <option value="">-- Chọn Quận / Huyện --</option>
                    </select>
                </div>

                <!-- Bước 3: Chọn Phường / Xã -->
                <div>
                    <label class="block font-bold text-gray-700 mb-1">3. Chọn Phường / Xã (*)</label>
                    <select id="modalWardSelect" onchange="onWardChanged()" disabled class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 outline-none focus:border-primary font-medium disabled:opacity-50">
                        <option value="">-- Chọn Phường / Xã --</option>
                    </select>
