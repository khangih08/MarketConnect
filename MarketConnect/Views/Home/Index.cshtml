    <style>
        body { font-family: 'Be Vietnam Pro', sans-serif; background-color: #f2f7f6; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">

    <!-- Toast Notification Element -->
    <div id="toastNotification" class="fixed top-20 right-6 bg-primary text-white text-xs font-bold px-4 py-3 rounded-xl shadow-2xl z-50 hidden flex items-center gap-2 border border-primary-fixed">
        <span class="material-symbols-outlined text-[20px] text-secondary-container">check_circle</span>
        <span id="toastMessage">Thông báo!</span>
    </div>

    <!-- TopNavBar -->
    <header class="bg-primary dark:bg-primary-container text-on-primary dark:text-on-primary-container docked full-width top-0 shadow-sm flex flex-col w-full z-50 sticky">
        <div class="max-w-max-width mx-auto w-full px-margin-desktop py-4 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-2 text-secondary-container hover:opacity-90 transition-opacity">
                    <span class="material-symbols-outlined text-4xl" data-weight="fill" style="font-variation-settings: 'FILL' 1;">shopping_bag</span>
                    <span class="font-headline-lg text-headline-lg font-bold text-on-primary dark:text-on-primary-container tracking-tight">MarketConnect</span>
                </a>
            </div>

            <div class="flex items-center gap-3">
                <!-- Nút Đăng ký bán hàng -->
                <a href="/Stores/Create" class="bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2 rounded-full font-label-md text-xs font-bold flex items-center justify-center gap-1.5 transition-all active:scale-95 shadow-md border border-emerald-500/30 text-center">
                    <span class="material-symbols-outlined text-[16px]">storefront</span>
                    <span>Đăng ký bán hàng</span>
                </a>

                <!-- Icons & User Profile -->
                <div class="flex items-center gap-4 border-l border-on-primary/20 pl-4" id="topbar_auth_zone">
                    <a href="/Notifications" title="Thông báo" class="material-symbols-outlined cursor-pointer hover:bg-primary-container/40 p-2 rounded-full transition-colors">notifications</a>
                    
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="relative group">
                            <div class="flex items-center gap-2 cursor-pointer hover:bg-primary-container/40 p-2 rounded-full transition-colors" onclick="toggleUserDropdown(event)">
                                <span class="material-symbols-outlined">account_circle</span>
                                <span id="home_user_name_display" class="font-label-md text-label-md hidden lg:block">
                                    @User.Identity.Name
                                </span>
                                <span class="material-symbols-outlined text-sm">arrow_drop_down</span>
                            </div>

                            <!-- Dropdown Menu -->
                            <div id="userDropdownMenu" class="absolute right-0 top-full mt-2 w-56 bg-surface-container-lowest text-on-surface rounded-2xl shadow-2xl border border-outline-variant py-2 hidden z-50">
                                <a href="/Account/Profile" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-surface-container-high transition-colors font-bold text-emerald-800">
                                    <span class="material-symbols-outlined text-[18px]">account_box</span> Quản lý hồ sơ
                                </a>
                                <a href="/Stores/Create" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-surface-container-high transition-colors font-bold text-emerald-700">
                                    <span class="material-symbols-outlined text-[18px]">storefront</span> Đăng ký bán hàng
                                </a>
                                <a href="/Stores" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-surface-container-high transition-colors font-bold text-primary">
                                    <span class="material-symbols-outlined text-[18px]">storefront</span> Gian hàng chợ
                                </a>
                                <a href="/MobileVendors/CallMap" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-surface-container-high transition-colors font-bold text-secondary-container">
                                    <span class="material-symbols-outlined text-[18px]">location_on</span> Gọi Hàng Rong
                                </a>
                                <a href="/CartAndOrders" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-surface-container-high transition-colors font-bold text-emerald-700">
                                    <span class="material-symbols-outlined text-[18px]">shopping_cart</span> Giỏ hàng của tôi
                                </a>
                                <a href="/Moderation" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">gavel</span> Kiểm duyệt nội dung & Hồ sơ
                                </a>
                                <div class="border-t border-outline-variant/40 my-1"></div>
                                <a href="/Account/Logout" class="flex items-center gap-2 px-4 py-2.5 text-xs text-error hover:bg-error-container/30 transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">logout</span> Đăng xuất
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3 text-xs font-semibold text-white">
                            <a class="hover:text-orange-300 transition-colors font-bold" href="/Account/Register">Đăng ký</a>
                            <div class="w-[1px] h-3.5 bg-white/40"></div>
                            <a class="hover:text-orange-300 transition-colors font-bold" href="/Account/Login">Đăng nhập</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- TopAppBar (Secondary Header & Search) -->
    <div class="bg-surface-container-lowest border-b border-outline-variant dark:border-outline flat no shadows full-width py-4 relative z-40">
        <div class="max-w-max-width mx-auto px-margin-desktop flex items-center gap-4">
            
            <!-- Location / Market Selector Dropdown -->
            <div class="relative shrink-0" id="marketSelectorWrapper">
                <button type="button" onclick="toggleMarketDropdownMenu(event)" class="flex items-center gap-3 bg-[#e6f9f3] px-4 py-2 rounded-full border border-[#ceead6] cursor-pointer hover:bg-[#dcf5ed] transition-colors shadow-xs">
                    <span class="material-symbols-outlined text-[#006d5b] text-[20px]">store</span>
                    <span id="currentSelectedMarketName" class="text-[14px] font-bold text-[#004d3d]">
                        @(selectedMarket != null ? selectedMarket.Name : "Chợ Nhân Chính")
                    </span>
                    <div id="currentSelectedMarketBadge" class="bg-[#006d5b] text-white px-2.5 py-0.5 rounded-full text-[12px] font-bold ml-1">
                        @selectedMarketDistText.ToLower()
                    </div>
                    <span class="material-symbols-outlined text-[#004d3d] text-[18px] ml-1 transition-transform" id="marketChevron">expand_more</span>
                </button>

                <!-- Dropdown list markets -->
                <div id="marketDropdownMenu" class="absolute left-0 top-full mt-2 w-80 bg-white rounded-2xl shadow-2xl border border-outline-variant py-2 hidden z-50">
                    <div class="px-4 py-2 text-[11px] font-bold text-gray-500 uppercase tracking-wider border-b border-gray-100 flex justify-between items-center">
                        <span>Danh sách Chợ & Phường (Nội thành Hà Nội)</span>
                        <button type="button" onclick="openCascadingLocationModal()" class="text-primary hover:underline font-extrabold text-[10px] flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-outlined text-[14px]">tune</span> Lọc Tỉnh → Xã → Chợ
                        </button>
                    </div>
                    <div class="max-h-64 overflow-y-auto divide-y divide-gray-50" id="marketOptionsList">
                        @foreach (var m in markets)
                        {
                            var wardName = m.Ward?.Name ?? "Phường nội thành Hà Nội";
                            var distText = ComputeDistanceText(m.Latitude, m.Longitude);
                            var isCurrent = selectedMarket != null && m.Id == selectedMarket.Id;
                            <button type="button" 
                                    data-market-id="@m.Id" 
                                    data-market-name="@m.Name" 
                                    data-market-address="@m.Address" 
                                    data-market-dist="@distText"
                                    onclick="onMarketOptionClick(this)" 
                                    class="w-full text-left px-4 py-2.5 text-xs flex items-center justify-between hover:bg-emerald-50 text-gray-800 font-medium transition-colors cursor-pointer @(isCurrent ? "bg-emerald-50 font-bold" : "")">
                                <div class="flex items-center gap-2 truncate">
                                    <span class="material-symbols-outlined text-emerald-700 text-[18px]">storefront</span>
                                    <div class="truncate">
                                        <span class="truncate font-bold block text-gray-900">@m.Name</span>
                                        <span class="text-[10px] text-emerald-800 font-medium">@wardName</span>
                                    </div>
                                </div>
                                <span id="marketBadge_@m.Id" class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full shrink-0">@distText</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Centered Search Input -->
            <div class="flex-grow flex justify-center">
                <form method="get" action="/Home/Index" class="flex w-full max-w-xl border-2 border-secondary-container rounded-lg overflow-hidden focus-within:border-primary transition-colors shadow-xs">
                    <input name="q" id="mainSearchInput" class="w-full px-4 py-2 outline-none font-body-md text-body-md text-on-surface bg-surface-container-lowest border-none focus:ring-0" placeholder="Tìm kiếm sản phẩm, nông sản, tiểu thương..." type="text" value="@Context.Request.Query["q"]">
                    <button type="submit" class="bg-secondary-container text-on-secondary px-6 font-label-md text-label-md font-bold flex items-center gap-2 hover:bg-secondary transition-colors cursor-pointer">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </form>
            </div>

            <!-- Cart Icon -->
            <a href="/CartAndOrders" class="relative cursor-pointer group" title="Xem Giỏ Hàng">
                <div class="p-2 rounded-full hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-primary text-3xl">shopping_cart</span>
                    <span id="globalCartBadge" class="absolute top-0 right-0 bg-secondary-container text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full border-2 border-white">@cartCount</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Main Canvas -->
    <main class="flex-grow max-w-max-width mx-auto w-full px-margin-desktop py-8 space-y-8">
        
        <!-- Breadcrumb Hierarchy -->
        <nav aria-label="Breadcrumb" class="flex text-sm text-on-surface-variant">
            <ol class="inline-flex items-center space-x-1 md:space-x-3 font-label-sm">
                <li class="inline-flex items-center">
                    <a class="inline-flex items-center hover:text-primary transition-colors" href="/">Hà Nội</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <span class="material-symbols-outlined text-[16px] mx-1">chevron_right</span>
                        <a class="hover:text-primary transition-colors" href="/">Thanh Xuân</a>
                    </div>
                </li>
                <li>
                    <div class="flex items-center">
                        <span class="material-symbols-outlined text-[16px] mx-1">chevron_right</span>
                        <a class="hover:text-primary transition-colors" href="/">Nhân Chính</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <span class="material-symbols-outlined text-[16px] mx-1">chevron_right</span>
                        <span class="text-on-surface font-bold" id="breadcrumbCurrentMarket">
                            @(selectedMarket != null ? selectedMarket.Name : "Chợ Nhân Chính") - @selectedMarketDistText.ToLower()
                        </span>
                    </div>
                </li>
            </ol>
        </nav>

        <!-- Market Profile Section -->
        <section class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden flex flex-col lg:flex-row">
            
            <!-- Left: Photos & Map -->
            <div class="lg:w-2/5 flex flex-col border-b lg:border-b-0 lg:border-r border-outline-variant">
                <div class="h-64 lg:h-72 relative group">
                    <img id="marketMainPhoto" alt="Chợ Nhân Chính - Khu vực bên ngoài" class="w-full h-full object-cover transition-all duration-300" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBv_dm10PMDGYVg5t3nYcGJHyFi2DrI2dYZ0X3YKRrrod-pGCBimI5jVl4zqIDGlAYggLMT47Uwa9Okz707yd9QRWRbskAOndIgBiOxxShliS1RSkXlO2PzMiNa5zZ8EW_buQlwWKG1Tlzr7hwea7jRSheArvLJuXi2hwYzY-fqnV0KIHNbxl35u2RedRceYnIl_kdA_Hg0gbjBFiaDKfxeobrGQEdn9ydqRkqA_xoGaxf42OybRtxm">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                    <div class="absolute bottom-4 left-4 right-4 flex gap-2">
                        <button type="button" onclick="openPhotoGalleryModal()" class="bg-white/90 text-on-surface text-xs font-bold px-3 py-1.5 rounded flex items-center gap-1 shadow-sm hover:bg-white cursor-pointer active:scale-95 transition-all">
                            <span class="material-symbols-outlined text-[16px]">photo_library</span> <span id="marketPhotoCountLabel">Xem 5 ảnh</span>
                        </button>
                    </div>
                    <div class="absolute inset-y-0 left-0 flex items-center pl-2">
                        <button type="button" onclick="prevMarketPhoto()" class="bg-white/80 text-on-surface p-1 rounded-full shadow-sm hover:bg-white transition-colors cursor-pointer">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </button>
                    </div>
                    <div class="absolute inset-y-0 right-0 flex items-center pr-2">
                        <button type="button" onclick="nextMarketPhoto()" class="bg-white/80 text-on-surface p-1 rounded-full shadow-sm hover:bg-white transition-colors cursor-pointer">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </button>
                    </div>
                </div>

                <div class="h-48 relative bg-surface-variant flex-grow overflow-hidden rounded-b-2xl border-t border-outline-variant">
                    @{
                        var mLat = selectedMarket != null && selectedMarket.Latitude != 0 ? selectedMarket.Latitude : 21.0040;
                        var mLng = selectedMarket != null && selectedMarket.Longitude != 0 ? selectedMarket.Longitude : 105.8050;
                    }
                    <iframe id="marketGoogleMapIframe" class="w-full h-full border-0" src="https://maps.google.com/maps?q=@mLat,@mLng&z=16&output=embed" loading="lazy"></iframe>
                </div>
            </div>

            <!-- Right: Details -->
            <div class="lg:w-3/5 p-6 lg:p-8 flex flex-col">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <span class="bg-[#e6f4ea] text-[#137333] px-2 py-1 rounded-md text-xs font-bold flex items-center gap-1 border border-[#ceead6]">
                            <span class="material-symbols-outlined text-[14px]">check_circle</span> Đang hoạt động
                        </span>
                        <span class="bg-surface-container-high text-on-surface-variant px-2 py-1 rounded-md text-xs font-bold">Chợ Truyền Thống Hạng 2</span>
                    </div>
                    <button type="button" onclick="shareMarketInfo()" title="Chia sẻ chợ" class="text-primary hover:bg-primary/10 p-2 rounded-full transition-colors flex items-center justify-center cursor-pointer">
                        <span class="material-symbols-outlined">share</span>
                    </button>
                </div>

                <h1 id="marketTitleHeading" class="font-headline-xl text-headline-xl font-bold text-on-surface mb-2">
                    @(selectedMarket != null ? selectedMarket.Name : "Chợ Nhân Chính")
                </h1>

                <p id="marketDescriptionPara" class="font-body-md text-body-md text-on-surface-variant mb-6 line-clamp-3">
                    @(selectedMarket != null && !string.IsNullOrEmpty(selectedMarket.PopularCategories) ? selectedMarket.Name + " là một trong những khu chợ truyền thống tiêu biểu, phục vụ nhu cầu mua sắm thiết yếu của cư dân với đa dạng các mặt hàng " + selectedMarket.PopularCategories + "." : "Chợ Nhân Chính là một trong những khu chợ truyền thống tiêu biểu tại quận Thanh Xuân, phục vụ nhu cầu mua sắm thiết yếu của cư dân khu vực. Chợ nổi tiếng với đa dạng các mặt hàng thực phẩm tươi sống, rau củ quả theo mùa và khu vực ẩm thực địa phương phong phú với giá cả bình dân.")
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8 mt-auto pt-4 border-t border-outline-variant/50">
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-secondary-container mt-0.5">location_on</span>
                        <div>
                            <h3 class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Địa chỉ</h3>
                            <p id="marketAddressDisplay" class="font-body-md text-on-surface font-medium">
                                @(selectedMarket != null && !string.IsNullOrEmpty(selectedMarket.Address) ? selectedMarket.Address : "Phố Nhân Hòa, Phường Nhân Chính, Quận Thanh Xuân, Hà Nội")
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-secondary-container mt-0.5">schedule</span>
                        <div>
                            <h3 class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Giờ hoạt động</h3>
                            <p id="marketOpeningHoursDisplay" class="font-body-md text-on-surface font-medium">
                                @(selectedMarket != null && !string.IsNullOrEmpty(selectedMarket.OpeningHours) ? selectedMarket.OpeningHours : "05:00 - 18:30 (Hàng ngày)")
                            </p>
                            <p class="text-xs text-on-surface-variant mt-0.5">Đông đúc nhất: 06:00 - 08:30 sáng</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-secondary-container mt-0.5">admin_panel_settings</span>
                        <div>
                            <h3 class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mb-1">Ban quản lý</h3>
