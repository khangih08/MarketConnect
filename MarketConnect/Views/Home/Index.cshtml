                      "secondary-container": "#ff7a21",
                      "primary-fixed": "#aff0d9",
                      "on-error": "#ffffff",
                      "surface-container-highest": "#dde4e6",
                      "on-secondary-fixed-variant": "#783200",
                      "surface-container-high": "#e2e9ec",
                      "error-container": "#ffdad6",
