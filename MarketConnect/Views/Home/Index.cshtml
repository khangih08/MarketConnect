            ],
            'cho-hom': [
                'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=800',
                'https://images.unsplash.com/photo-1596040033229-a9821ebd058d?w=800',
                'https://images.unsplash.com/photo-1587593810167-a84920ea0781?w=800',
                'https://images.unsplash.com/photo-1611080626919-7cf5a9dbab5b?w=800'
            ],
            'cho-mo': [
                'https://images.unsplash.com/photo-1542838132-92c53300491e?w=800',
                'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=800',
                'https://images.unsplash.com/photo-1588168333986-5078d3ae3976?w=800',
                'https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?w=800'
            ]
        };

        const activeMarketSlug = '@(selectedMarket != null ? selectedMarket.Slug : "cho-nhan-chinh")';
        const activeMarketName = '@Html.Raw(selectedMarket != null ? selectedMarket.Name : "Chợ Nhân Chính")';

        let photos = marketGalleriesData[activeMarketSlug] || [
            'https://images.unsplash.com/photo-1542838132-92c53300491e?w=800',
            'https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=800',
            'https://images.unsplash.com/photo-1588168333986-5078d3ae3976?w=800',
            'https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?w=800'
        ];
        let currentPhotoIdx = 0;

        function initMarketGallery() {
            if (photos && photos.length > 0) {
                const mainImg = document.getElementById('marketMainPhoto');
                if (mainImg) mainImg.src = photos[0];
            }
            const countBtnLabel = document.getElementById('marketPhotoCountLabel');
            if (countBtnLabel) {
                countBtnLabel.innerText = `Xem ${photos.length} ảnh`;
            }
            const modalTitle = document.getElementById('galleryModalTitle');
            if (modalTitle) {
                modalTitle.innerHTML = `<span class="material-symbols-outlined text-primary">photo_library</span> Bộ Ảnh ${activeMarketName} (${photos.length} ảnh)`;
            }
        }

        function nextMarketPhoto() {
            if (!photos || photos.length === 0) return;
            currentPhotoIdx = (currentPhotoIdx + 1) % photos.length;
            const mainImg = document.getElementById('marketMainPhoto');
            if (mainImg) mainImg.src = photos[currentPhotoIdx];
        }

        function prevMarketPhoto() {
            if (!photos || photos.length === 0) return;
            currentPhotoIdx = (currentPhotoIdx - 1 + photos.length) % photos.length;
            const mainImg = document.getElementById('marketMainPhoto');
            if (mainImg) mainImg.src = photos[currentPhotoIdx];
        }

        // 5. Photo Gallery Modal (Dynamic rendering)
        function openPhotoGalleryModal() {
            const grid = document.getElementById('galleryImageGrid');
            const modal = document.getElementById('photoGalleryModal');

            if (grid && photos) {
                grid.innerHTML = photos.map((url, idx) => `
                    <div class="relative group overflow-hidden rounded-2xl shadow-sm border border-gray-100 bg-gray-50 cursor-pointer" onclick="selectMarketPhotoByIndex(${idx})">
                        <img src="${url}" class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-300" alt="Ảnh ${idx + 1} - ${activeMarketName}" />
                        <div class="absolute bottom-2 left-2 bg-black/60 text-white text-[10px] font-bold px-2 py-0.5 rounded-md backdrop-blur-xs">
                            Ảnh ${idx + 1}/${photos.length}
                        </div>
                    </div>
                `).join('');
            }
            if (modal) modal.classList.remove('hidden');
        }

        function selectMarketPhotoByIndex(idx) {
            currentPhotoIdx = idx;
            const mainImg = document.getElementById('marketMainPhoto');
            if (mainImg && photos[idx]) mainImg.src = photos[idx];
            closePhotoGalleryModal();
        }

        function closePhotoGalleryModal() {
            const modal = document.getElementById('photoGalleryModal');
            if (modal) modal.classList.add('hidden');
        }

        // Run gallery init on DOM loaded
        document.addEventListener('DOMContentLoaded', initMarketGallery);

        // 6. Google Map Directions
        function openGoogleMapDirections() {
            const marketName = document.getElementById('currentSelectedMarketName').innerText;
            window.open(`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(marketName + " Hà Nội")}`, '_blank');
        }

        // 7. Share Market Info
        function shareMarketInfo() {
            if (navigator.share) {
                navigator.share({ title: document.title, url: window.location.href });
            } else {
                navigator.clipboard.writeText(window.location.href);
                showToast('Đã sao chép liên kết chợ vào bộ nhớ tạm!');
            }
        }

        // 8. Categories Horizontal Scrolling & Filtering
        function scrollCategoriesLeft() {
            const container = document.getElementById('categoryGridCarousel');
            if (container) container.scrollBy({ left: -200, behavior: 'smooth' });
        }

        function scrollCategoriesRight() {
            const container = document.getElementById('categoryGridCarousel');
            if (container) container.scrollBy({ left: 200, behavior: 'smooth' });
        }

        function filterByCategory(catName) {
            showToast('Đang lọc các sản phẩm & tiểu thương theo ngành hàng: ' + catName);
            window.location.href = '/Products/Category?category=' + encodeURIComponent(catName);
        }

        // 9. Add to Cart Ajax
        async function handleAddToCart(e, form) {
            e.preventDefault();
            const formData = new FormData(form);
            try {
                await fetch('/CartAndOrders/AddToCart', {
                    method: 'POST',
                    body: formData
                });
                
                const badge = document.getElementById('globalCartBadge');
                if (badge) {
                    const currentCount = parseInt(badge.innerText || '0');
                    badge.innerText = currentCount + 1;
                }
                showToast('Đã thêm sản phẩm vào giỏ hàng thành công!');
            } catch (err) {
                showToast('Đã thêm sản phẩm vào giỏ hàng!');
            }
        }

        // 10. Cascading Location Selection Modal Functions
        function openCascadingLocationModal() {
            document.getElementById('cascadingLocationModal').classList.remove('hidden');
            loadProvinces();
        }

        function closeCascadingLocationModal() {
            document.getElementById('cascadingLocationModal').classList.add('hidden');
        }

        async function loadProvinces() {
            const provSelect = document.getElementById('modalProvinceSelect');
            provSelect.innerHTML = '<option value="">-- Chọn Tỉnh / Thành phố --</option>';
            try {
                const res = await fetch('/api/location/provinces');
                const data = await res.json();
                data.forEach(p => {
                    provSelect.innerHTML += `<option value="${p.id}">${p.name}</option>`;
                });
            } catch(e) { console.error(e); }
        }

        async function onProvinceChanged() {
            const pId = document.getElementById('modalProvinceSelect').value;
            const distSelect = document.getElementById('modalDistrictSelect');
            const wardSelect = document.getElementById('modalWardSelect');
            const mktSelect = document.getElementById('modalMarketSelect');

            distSelect.innerHTML = '<option value="">-- Chọn Quận / Huyện --</option>';
            wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã --</option>';
            mktSelect.innerHTML = '<option value="">-- Chọn Chợ --</option>';

            if (!pId) {
                distSelect.disabled = true;
                wardSelect.disabled = true;
                mktSelect.disabled = true;
                return;
            }

            distSelect.disabled = false;
            try {
                const res = await fetch('/api/location/districts?provinceId=' + pId);
                const data = await res.json();
                data.forEach(d => {
                    distSelect.innerHTML += `<option value="${d.id}">${d.name}</option>`;
                });
                loadMarketsByFilter(pId, null, null);
            } catch(e) { console.error(e); }
        }

        async function onDistrictChanged() {
            const pId = document.getElementById('modalProvinceSelect').value;
            const dId = document.getElementById('modalDistrictSelect').value;
            const wardSelect = document.getElementById('modalWardSelect');
            const mktSelect = document.getElementById('modalMarketSelect');

            wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã --</option>';
            mktSelect.innerHTML = '<option value="">-- Chọn Chợ --</option>';

            if (!dId) {
                wardSelect.disabled = true;
                return;
            }

            wardSelect.disabled = false;
            try {
                const res = await fetch('/api/location/wards?districtId=' + dId);
                const data = await res.json();
                data.forEach(w => {
                    wardSelect.innerHTML += `<option value="${w.id}">${w.name}</option>`;
                });
                loadMarketsByFilter(pId, dId, null);
            } catch(e) { console.error(e); }
        }

        async function onWardChanged() {
            const pId = document.getElementById('modalProvinceSelect').value;
            const dId = document.getElementById('modalDistrictSelect').value;
            const wId = document.getElementById('modalWardSelect').value;
            loadMarketsByFilter(pId, dId, wId);
        }

        async function loadMarketsByFilter(pId, dId, wId) {
            const mktSelect = document.getElementById('modalMarketSelect');
            mktSelect.innerHTML = '<option value="">-- Chọn Chợ --</option>';
            mktSelect.disabled = false;

            let url = `/api/location/markets?`;
            if (pId) url += `provinceId=${pId}&`;
            if (dId) url += `districtId=${dId}&`;
            if (wId) url += `wardId=${wId}&`;

            try {
                const res = await fetch(url);
                const data = await res.json();
                if (data.length > 0) {
                    data.forEach(m => {
                        const areaInfo = m.wardName ? `(${m.wardName})` : '';
                        mktSelect.innerHTML += `<option value="${m.id}" data-name="${m.name}" data-address="${m.address}">${m.name} ${areaInfo}</option>`;
                    });
                } else {
                    mktSelect.innerHTML = '<option value="">Chưa có dữ liệu chợ ở khu vực này</option>';
                }
            } catch(e) { console.error(e); }
        }

        function confirmSelectedMarketFromModal() {
            const mktSelect = document.getElementById('modalMarketSelect');
            const selectedOpt = mktSelect.options[mktSelect.selectedIndex];
            if (!mktSelect.value || !selectedOpt) {
                showToast('Vui lòng chọn chợ từ danh sách!');
                return;
            }

            const marketId = mktSelect.value;
            const marketName = selectedOpt.getAttribute('data-name');
            const address = selectedOpt.getAttribute('data-address');

            closeCascadingLocationModal();
            selectActiveMarket(marketId, marketName, address);
        }

        // Dynamic GPS Real-time Distance Calculator
        const activeMarketId = '@(selectedMarket != null ? selectedMarket.Id.ToString() : "1")';

        function openGoogleMapDirections() {
            const mName = document.getElementById('currentSelectedMarketName') ? document.getElementById('currentSelectedMarketName').innerText : 'Chợ Hà Nội';
            window.open('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(mName + ' Hà Nội'), '_blank');
        }

        const marketsGeoData = [
            @foreach(var m in markets)
            {
                <text>{ id: @m.Id, name: "@Html.Raw(m.Name)", lat: @m.Latitude, lng: @m.Longitude },</text>
            }
        ];

        function getHaversineDistanceKm(lat1, lon1, lat2, lon2) {
            if (!lat1 || !lon1 || !lat2 || !lon2) return 1.5;
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon/2) * Math.sin(dLon/2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            return R * c;
        }

        function updateMarketDistancesWithGPS() {
            const applyCoords = function(uLat, uLng) {
                marketsGeoData.forEach(m => {
                    if (m.lat && m.lng) {
                        const distKm = getHaversineDistanceKm(uLat, uLng, m.lat, m.lng);
                        const distText = distKm < 0.2 ? "Cách < 200m" : `Cách ${distKm.toFixed(1)} km`;

                        const badge = document.getElementById('marketBadge_' + m.id);
                        if (badge) badge.innerText = distText;

                        if (String(m.id) === String(activeMarketId)) {
                            const topBadge = document.getElementById('currentSelectedMarketBadge');
                            if (topBadge) topBadge.innerText = distText.toLowerCase();
                            const breadcrumb = document.getElementById('breadcrumbCurrentMarket');
                            if (breadcrumb) breadcrumb.innerText = activeMarketName + ' - ' + distText.toLowerCase();
                        }
                    }
                });
            };

            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(
                    pos => applyCoords(pos.coords.latitude, pos.coords.longitude),
                    err => applyCoords(21.0040, 105.8050),
                    { timeout: 10000, enableHighAccuracy: true }
                );
            } else {
                applyCoords(21.0040, 105.8050);
            }
        }

        document.addEventListener('DOMContentLoaded', updateMarketDistancesWithGPS);
    </script>
