@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "MarketConnect Admin Portal - Tổng quan";
    var recentLogs = ViewBag.RecentActivity as List<MarketConnect.Data.AuditLog> ?? new List<MarketConnect.Data.AuditLog>();
}

<!-- Page Header -->
<div class="flex items-center justify-between mb-8">
    <div class="flex flex-col gap-2">
        <div class="flex items-center gap-3 text-primary">
            <span class="material-symbols-outlined text-3xl">qr_code_2</span>
            <h1 class="font-display-lg text-display-lg text-2xl font-bold text-on-surface">Tổng Quan Hệ Thống Admin Portal</h1>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant text-xs">Thống kê toàn diện về người dùng, sản phẩm, chợ, hàng đợi kiểm duyệt và cảnh báo bảo mật.</p>
    </div>
    <a href="/Moderation" class="bg-secondary hover:bg-on-secondary-container text-white px-5 py-2.5 rounded-lg font-label-md transition-colors flex items-center gap-2 shadow-sm text-xs font-semibold">
        <span class="material-symbols-outlined text-sm">policy</span>
        Vào Hàng Đợi Kiểm Duyệt
        <span class="material-symbols-outlined text-sm">arrow_right_alt</span>
    </a>
</div>

<!-- Dashboard Grid -->
<div class="flex flex-col gap-6">
    <!-- Top Row: 4 Large Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1 -->
        <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-soft flex flex-col justify-between border border-surface-container">
            <div class="flex justify-between items-start mb-4">
                <span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px] font-semibold">Tổng số sản phẩm</span>
                <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center text-secondary">
                    <span class="material-symbols-outlined">inventory_2</span>
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <span class="font-display-lg text-display-lg text-3xl font-bold text-on-surface">@ViewBag.TotalProducts</span>
                <span class="font-label-sm text-secondary flex items-center gap-1 text-[11px] font-medium">
                    <span class="material-symbols-outlined text-[14px]">check</span>
                    Đã tối ưu hóa dữ liệu
                </span>
            </div>
        </div>
        <!-- Card 2 -->
        <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-soft flex flex-col justify-between border-l-4 border-orange-400 border-y border-r border-surface-container">
            <div class="flex justify-between items-start mb-4">
                <span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px] font-semibold">Nội dung chờ duyệt</span>
                <div class="w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center text-orange-500">
                    <span class="material-symbols-outlined">pending_actions</span>
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <span class="font-display-lg text-display-lg text-3xl font-bold text-orange-500">@ViewBag.TotalPending</span>
                <span class="font-label-sm text-orange-600 flex items-center gap-1 text-[11px] font-medium">
                    <span class="material-symbols-outlined text-[14px]">warning</span>
                    Cần kiểm duyệt thủ công
                </span>
            </div>
        </div>
        <!-- Card 3 -->
        <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-soft flex flex-col justify-between border-l-4 border-error border-y border-r border-surface-container">
            <div class="flex justify-between items-start mb-4">
                <span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px] font-semibold">Nội dung rủi ro cao</span>
                <div class="w-10 h-10 rounded-lg bg-error-container flex items-center justify-center text-error">
                    <span class="material-symbols-outlined">report</span>
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <span class="font-display-lg text-display-lg text-3xl font-bold text-error">@ViewBag.HighRiskCount</span>
                <span class="font-label-sm text-error flex items-center gap-1 text-[11px] font-medium">
                    <span class="material-symbols-outlined text-[14px]">error</span>
                    Cảnh báo mức High/Critical
                </span>
            </div>
        </div>
        <!-- Card 4 -->
        <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-soft flex flex-col justify-between border-l-4 border-purple-500 border-y border-r border-surface-container">
            <div class="flex justify-between items-start mb-4">
                <span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px] font-semibold">Khiếu nại chờ xử lý</span>
                <div class="w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center text-purple-600">
                    <span class="material-symbols-outlined">gavel</span>
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <span class="font-display-lg text-display-lg text-3xl font-bold text-purple-600">@ViewBag.PendingAppealsCount</span>
                <span class="font-label-sm text-purple-600 flex items-center gap-1 text-[11px] font-medium">
                    <span class="material-symbols-outlined text-[14px]">forward_to_inbox</span>
                    Từ tiểu thương gửi tới
                </span>
            </div>
        </div>
    </div>

    <!-- Second Row: 4 Smaller Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-surface-container-lowest rounded-xl p-4 shadow-soft flex flex-col items-center justify-center gap-2 border border-surface-container">
            <span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px]">Tổng người dùng</span>
            <span class="font-headline-md text-headline-md text-xl font-bold text-on-surface">@ViewBag.TotalUsers</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-4 shadow-soft flex flex-col items-center justify-center gap-2 border border-surface-container">
            <span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px]">Tổng số chợ</span>
            <span class="font-headline-md text-headline-md text-xl font-bold text-blue-600">@ViewBag.TotalMarkets</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-4 shadow-soft flex flex-col items-center justify-center gap-2 border border-surface-container">
            <span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px]">Tổng số tiểu thương</span>
            <span class="font-headline-md text-headline-md text-xl font-bold text-secondary">@ViewBag.TotalMerchants</span>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-4 shadow-soft flex flex-col items-center justify-center gap-2 border border-surface-container">
            <span class="font-label-sm text-on-surface-variant uppercase tracking-wider text-[11px]">Tài khoản bị khóa</span>
            <span class="font-headline-md text-headline-md text-xl font-bold text-on-surface">@ViewBag.LockedUsersCount</span>
        </div>
    </div>

    <!-- Bottom Section: Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Area (Left - 2 Cols) -->
        <div class="lg:col-span-2 bg-surface-container-lowest rounded-2xl shadow-soft flex flex-col border border-surface-container">
            <div class="p-6 border-b border-surface-variant flex justify-between items-center">
                <div class="flex items-center gap-2 text-primary">
                    <span class="material-symbols-outlined">insights</span>
                    <h2 class="font-title-lg text-title-lg text-base font-bold text-on-surface">Hoạt Động Kiểm Duyệt Tự Động & Thủ Công</h2>
                </div>
                <span class="font-label-sm text-on-surface-variant text-xs">Cập nhật thời gian thực</span>
            </div>
            <div class="p-6 flex flex-col gap-4">
                <!-- High Risk Row -->
                <a href="/Moderation?riskLevel=High" class="bg-error/5 border border-error/20 rounded-xl p-4 flex items-center justify-between hover:bg-error/10 transition-colors">
                    <div class="flex items-center gap-4">
                        <div class="w-3 h-3 rounded-full bg-error animate-ping"></div>
                        <div class="flex flex-col">
                            <span class="font-label-md text-error font-bold text-xs">HIGH RISK QUEUE</span>
                            <span class="font-body-md text-on-surface-variant text-xs">Yêu cầu kiểm duyệt viên thẩm định kỹ</span>
                        </div>
                    </div>
                    <span class="font-headline-sm text-headline-sm font-bold text-error text-sm">@ViewBag.HighRiskCount Hồ Sơ</span>
                </a>
                <!-- Medium Risk Row -->
                <a href="/Moderation" class="bg-orange-50 border border-orange-200 rounded-xl p-4 flex items-center justify-between hover:bg-orange-100/50 transition-colors">
                    <div class="flex items-center gap-4">
                        <div class="w-3 h-3 rounded-full bg-orange-500"></div>
                        <div class="flex flex-col">
                            <span class="font-label-md text-orange-600 font-bold text-xs">MEDIUM RISK QUEUE</span>
                            <span class="font-body-md text-on-surface-variant text-xs">Xử lý theo thứ tự chờ trong hàng đợi</span>
                        </div>
                    </div>
                    <span class="font-headline-sm text-headline-sm font-bold text-orange-600 text-sm">@ViewBag.TotalPending Hồ Sơ</span>
                </a>
                <!-- Auto Approved Row -->
                <div class="bg-secondary/5 border border-secondary/20 rounded-xl p-4 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-3 h-3 rounded-full bg-secondary"></div>
                        <div class="flex flex-col">
                            <span class="font-label-md text-secondary font-bold text-xs">AUTO APPROVED</span>
                            <span class="font-body-md text-on-surface-variant text-xs">Nội dung an toàn được duyệt tự động</span>
                        </div>
                    </div>
                    <span class="font-headline-sm text-headline-sm font-bold text-secondary text-sm">95.4%</span>
                </div>
                <!-- Auto Rejected Row -->
                <div class="bg-surface border border-outline-variant rounded-xl p-4 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-3 h-3 rounded-full bg-on-surface"></div>
                        <div class="flex flex-col">
                            <span class="font-label-md text-on-surface font-bold text-xs">AUTO REJECTED</span>
                            <span class="font-body-md text-on-surface-variant text-xs">Chặn trực tiếp vi phạm nghiêm trọng (Hàng cấm / Vi phạm chính sách chắc chắn)</span>
                        </div>
                    </div>
                    <span class="font-headline-sm text-headline-sm font-bold text-on-surface text-sm">4.6%</span>
                </div>
            </div>
        </div>
        <!-- Side Area (Right - 1 Col) -->
        <div class="bg-surface-container-lowest rounded-2xl shadow-soft flex flex-col h-full border border-surface-container">
            <div class="p-6 border-b border-surface-variant flex justify-between items-center">
                <div class="flex items-center gap-2 text-primary">
                    <span class="material-symbols-outlined text-blue-600">history</span>
                    <h2 class="font-title-lg text-title-lg text-base font-bold text-on-surface">Hoạt Động Gần Đây</h2>
                </div>
                <a class="font-label-sm text-secondary hover:underline flex items-center gap-1 text-xs font-bold" href="/Moderation/AuditLogs">
                    Xem log
                    <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                </a>
            </div>
            <div class="flex-1 p-6 flex flex-col gap-3 min-h-[300px]">
                @if (!recentLogs.Any())
                {
                    <div class="flex flex-col items-center justify-center h-full text-center py-10">
                        <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center text-outline-variant mb-4">
                            <span class="material-symbols-outlined text-3xl">event_note</span>
                        </div>
                        <span class="font-body-md text-on-surface-variant text-xs">Chưa có nhật ký hoạt động gần đây.</span>
                    </div>
                }
                else
                {
                    @foreach (var log in recentLogs)
                    {
                        <div class="p-3 rounded-xl bg-surface-container-low border border-surface-container space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="font-extrabold text-on-surface text-xs">@log.Action</span>
                                <span class="text-[10px] text-outline font-mono">@log.Timestamp.AddHours(7).ToString("HH:mm dd/MM")</span>
                            </div>
                            <div class="text-on-surface-variant text-[11px] truncate">@log.DetailsJson</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
