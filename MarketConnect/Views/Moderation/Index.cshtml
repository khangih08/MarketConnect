@model List<MarketConnect.Data.ModerationCase>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hàng Đợi Kiểm Duyệt Nội Dung (Moderation Queue)";
    var markets = ViewBag.Markets as List<MarketConnect.Data.Market> ?? new List<MarketConnect.Data.Market>();
    var provinces = ViewBag.Provinces as List<MarketConnect.Data.Province> ?? new List<MarketConnect.Data.Province>();
}

<div class="space-y-6">
    <!-- Header Title -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-800 text-3xl">gavel</span>
                <span>Hàng Đợi Kiểm Duyệt Nội Dung & Phê Duyệt Nâng Cao</span>
            </h1>
            <p class="text-xs text-slate-500 mt-1">Đánh giá rủi ro đa chiều tự động (FR-06), kiểm duyệt ưu tiên thủ công và so sánh diff phiên bản (FR-07).</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/Moderation/RulesConfig" class="px-3.5 py-2 bg-blue-50 hover:bg-blue-100 text-blue-900 font-extrabold rounded-2xl text-xs border border-blue-300 transition-all flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">tune</span> ⚙️ Cấu Hình Quy Tắc (FR-06)
            </a>
            <a href="/AdminRole" class="px-3.5 py-2 bg-purple-50 hover:bg-purple-100 text-purple-900 font-extrabold rounded-2xl text-xs border border-purple-300 transition-all flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">vpn_key</span> 🔐 Phân Quyền Scope (FR-08)
            </a>
        </div>
    </div>

    <div id="afContainer" class="hidden">@Html.AntiForgeryToken()</div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 text-emerald-800 rounded-2xl text-xs font-bold border border-emerald-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-red-50 text-red-800 rounded-2xl text-xs font-bold border border-red-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">warning</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Quick Status Counter Bar -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 text-center">
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">🔴 HIGH RISK</div>
            <div class="text-2xl font-black text-red-600 mt-1">@ViewBag.HighRiskCount</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">🟠 MEDIUM RISK</div>
            <div class="text-2xl font-black text-amber-800 mt-1">@ViewBag.MediumRiskCount</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">⚠️ ESCALATED</div>
            <div class="text-2xl font-black text-purple-800 mt-1">@Model.Count(c => c.IsEscalated)</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">🟢 AUTO APPROVED</div>
            <div class="text-2xl font-black text-emerald-800 mt-1">@ViewBag.AutoApprovedCount</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">
            <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">📩 APPEALS</div>
            <div class="text-2xl font-black text-indigo-700 mt-1">@ViewBag.PendingAppealsCount</div>
        </div>
    </div>

    <!-- Scoped Filter Toolbar (Layout Section 2) -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 flex flex-wrap gap-3 items-center text-xs shadow-2xs">
        <span class="font-extrabold text-slate-700 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm text-slate-500">filter_alt</span> Bộ lọc:
        </span>
        
        <form method="get" action="/Moderation" class="flex flex-wrap items-center gap-2">
            <select name="entityType" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1.5 font-bold outline-none">
                <option value="">-- Loại thực thể --</option>
                <option value="Product" selected="@(ViewBag.EntityType == "Product")">Sản Phẩm</option>
                <option value="Store" selected="@(ViewBag.EntityType == "Store")">Gian Hàng</option>
            </select>

            <select name="riskLevel" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1.5 font-bold outline-none">
                <option value="">-- Mức rủi ro --</option>
                <option value="High" selected="@(ViewBag.RiskLevel?.ToString() == "High")">🔴 High Risk (≥ 60)</option>
                <option value="Medium" selected="@(ViewBag.RiskLevel?.ToString() == "Medium")">🟠 Medium Risk (30-59)</option>
                <option value="Low" selected="@(ViewBag.RiskLevel?.ToString() == "Low")">🟢 Low Risk (&lt; 30)</option>
            </select>

            <select name="marketId" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1.5 font-bold outline-none max-w-[160px]">
                <option value="">-- Tất cả chợ --</option>
                @foreach (var m in markets)
                {
                    <option value="@m.Id" selected="@(ViewBag.MarketId == m.Id)">@m.Name</option>
                }
            </select>

            <a href="/Moderation" class="px-3 py-1.5 rounded-xl border border-slate-200 font-bold hover:bg-slate-100 text-slate-600">Xóa bộ lọc</a>
        </form>
    </div>

    <!-- Moderation Queue List Table (Layout Section 2) -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-slate-900 uppercase tracking-wider">Danh Sách Hàng Đợi Kiểm Duyệt (Priority Queue)</h3>
            <span class="text-xs text-slate-500 font-bold">Tổng cộng: @Model.Count hồ sơ</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700 border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-900 font-extrabold uppercase tracking-wider text-[11px]">
                        <th class="p-3.5">Risk Score</th>
                        <th class="p-3.5">Nội Dung Thực Thể</th>
                        <th class="p-3.5">Chợ Phụ Trách</th>
                        <th class="p-3.5">Thời Gian Chờ</th>
                        <th class="p-3.5 text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="p-8 text-center text-slate-500">
                                <span class="material-symbols-outlined text-4xl text-emerald-600 block mb-2">check_circle</span>
                                Hàng đợi kiểm duyệt hiện tại đang trống. Tất cả nội dung trong phạm vi quản lý đã được xử lý!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="p-3.5">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-black text-xs @(c.RiskLevel == MarketConnect.Data.RiskLevel.High || c.RiskLevel == MarketConnect.Data.RiskLevel.Critical || c.RiskScore >= 60 ? "bg-red-100 text-red-700 border border-red-300" : "bg-amber-100 text-amber-900 border border-amber-300")">
                                        @(c.RiskScore >= 60 ? "🔴" : "🟠") @c.RiskScore/100
                                    </span>
                                </td>
                                <td class="p-3.5">
                                    <div class="font-extrabold text-slate-900">#@c.Id - @c.EntityType ID:#@c.EntityId</div>
                                    <div class="text-[11px] text-slate-500 font-mono truncate max-w-xs">@c.ContentSnapshotJson</div>
                                </td>
                                <td class="p-3.5 font-bold text-slate-800">
                                    @(c.MarketId.HasValue ? (markets.FirstOrDefault(m => m.Id == c.MarketId.Value)?.Name ?? "Chợ Nhân Chính") : "Chợ Nhân Chính")
                                </td>
                                <td class="p-3.5 text-slate-500 font-medium">
                                    @c.CreatedAt.AddHours(7).ToString("HH:mm dd/MM")
                                </td>
                                <td class="p-3.5 text-right">
                                    <button type="button" onclick="openInspectModal(@c.Id)" class="bg-emerald-800 hover:bg-emerald-900 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs shadow-xs cursor-pointer inline-flex items-center gap-1">
                                        <span class="material-symbols-outlined text-sm">visibility</span> Xem Detail Case
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL KIỂM DUYỆT CHI TIẾT CASE #MC-000123 (LAYOUT SECTION 3) -->
<!-- ========================================================= -->
<!-- MODAL KIỂM DUYỆT CHI TIẾT SẢN PHẨM / GIAN HÀNG -->
<!-- ========================================================= -->
<div id="inspectModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-4xl w-full p-6 space-y-5 shadow-2xl overflow-hidden flex flex-col max-h-[92vh]">
        <!-- Top Title & Case Header -->
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="flex items-center gap-3">
                <a href="javascript:void(0)" onclick="closeInspectModal()" class="text-xs font-extrabold text-slate-500 hover:text-slate-900 flex items-center gap-1">
                    &larr; Quay lại hàng đợi
                </a>
                <span class="h-4 w-[1px] bg-slate-300"></span>
                <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-800 text-xl">gavel</span>
                    <span id="inspectCaseTitle">KIỂM DUYỆT #MC-000000</span>
                </h3>
            </div>
            <button type="button" onclick="closeInspectModal()" class="text-slate-400 hover:text-slate-700 font-extrabold text-2xl cursor-pointer">&times;</button>
        </div>

        <!-- Scrollable Modal Body -->
        <div class="overflow-y-auto space-y-5 pr-1 text-xs">
            <!-- 2-Column Split: Entity Info Left vs Auto Assessment Results Right -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- LEFT COLUMN: THÔNG TIN SẢN PHẨM / GIAN HÀNG -->
                <div class="bg-slate-50 rounded-3xl p-5 border border-slate-200 space-y-3">
                    <h4 class="font-extrabold text-xs uppercase tracking-wider text-slate-500 border-b border-slate-200 pb-2">THÔNG TIN SẢN PHẨM</h4>
                    <div class="flex gap-4 items-start">
                        <img id="inspectImg" src="https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?w=300" alt="Product" class="w-20 h-20 object-cover rounded-2xl border border-slate-200 flex-shrink-0" />
                        <div class="space-y-1">
                            <div id="inspectName" class="font-black text-sm text-slate-900">Sản Phẩm Đang Kiểm Duyệt</div>
                            <div id="inspectPrice" class="text-base font-black text-emerald-700">0đ</div>
                        </div>
                    </div>

                    <div class="space-y-2 pt-2 border-t border-slate-200 text-xs">
                        <div class="flex justify-between"><span class="text-slate-500">Tên gian hàng:</span><strong id="inspectStoreName" class="text-slate-900 font-bold">--</strong></div>
                        <div class="flex justify-between"><span class="text-slate-500">Người đại diện:</span><strong id="inspectRepresentative" class="text-slate-900 font-bold">--</strong></div>
                        <div class="flex justify-between"><span class="text-slate-500">Số điện thoại:</span><strong id="inspectPhone" class="text-slate-900 font-mono font-bold">--</strong></div>
                        <div class="flex justify-between"><span class="text-slate-500">Chợ trực thuộc:</span><strong id="inspectMarket" class="text-slate-900 font-bold">--</strong></div>
                        <div class="flex justify-between"><span class="text-slate-500">Danh mục:</span><strong id="inspectCategory" class="text-slate-900 font-bold">--</strong></div>
                    </div>

                    <details class="pt-2 border-t border-slate-200 text-[11px]">
                        <summary class="cursor-pointer font-bold text-slate-500 hover:text-slate-800">Xem chi tiết snapshot JSON ▾</summary>
                        <pre id="inspectSnapshot" class="bg-white p-2.5 rounded-xl border border-slate-200 text-[10px] font-mono overflow-x-auto max-h-24 mt-2 text-slate-700"></pre>
                    </details>
                </div>

                <!-- RIGHT COLUMN: KIỂM TRA TỰ ĐỘNG (AUTO ASSESSMENT) -->
                <div class="bg-slate-50 rounded-3xl p-5 border border-slate-200 space-y-3 flex flex-col justify-between">
                    <div class="space-y-3">
                        <h4 class="font-extrabold text-xs uppercase tracking-wider text-slate-500 border-b border-slate-200 pb-2">KIỂM TRA TỰ ĐỘNG</h4>
                        
                        <div class="grid grid-cols-2 gap-3">
                            <div class="bg-white p-3 rounded-2xl border border-slate-200 flex flex-col justify-center">
                                <span class="text-[10px] font-extrabold uppercase text-slate-400 block mb-1">Mức Rủi Ro</span>
                                <div>
                                    <span id="inspectRiskBadge" class="px-3 py-1 rounded-full font-extrabold text-xs bg-emerald-100 text-emerald-800 border border-emerald-300 inline-block">
                                        🟢 THẤP
                                    </span>
                                </div>
                            </div>
                            <div class="bg-white p-3 rounded-2xl border border-slate-200 flex flex-col justify-center">
                                <span class="text-[10px] font-extrabold uppercase text-slate-400 block mb-1">Điểm Rủi Ro</span>
                                <span id="inspectScoreNum" class="text-xl font-black text-slate-900">0 / 100</span>
                            </div>
                        </div>

                        <div>
                            <span class="font-bold text-slate-600 block mb-1">Kiểm tra tự động:</span>
                            <div id="inspectTriggeredRules" class="bg-white p-3 rounded-2xl border border-slate-200 text-xs font-bold text-emerald-700 max-h-24 overflow-y-auto">
                                ✓ Không phát hiện vi phạm
                            </div>
                        </div>

                        <div id="inspectRecommendationBox" class="bg-blue-50/80 p-3 rounded-2xl border border-blue-200 text-blue-950 text-xs leading-relaxed">
                            <span class="font-bold text-blue-900 block mb-0.5">Hệ thống đề xuất:</span>
                            <span id="inspectSystemRecommendation">Sản phẩm đủ điều kiện để Admin xem xét phê duyệt.</span>
                        </div>
                    </div>

                    <div class="flex justify-between items-center bg-white p-3 rounded-2xl border border-slate-200 mt-2">
                        <span class="font-bold text-slate-600">Trạng thái:</span>
                        <span id="inspectDecisionText" class="font-extrabold text-amber-800 flex items-center gap-1">Chờ Admin quyết định</span>
                    </div>
                </div>
            </div>

            <!-- COLLAPSIBLE SECTION: LỊCH SỬ KIỂM DUYỆT & PHIÊN BẢN -->
            <details class="bg-slate-50 rounded-3xl p-4 border border-slate-200 space-y-3">
                <summary class="cursor-pointer font-extrabold text-xs uppercase tracking-wider text-slate-700 flex items-center justify-between">
                    <span class="flex items-center gap-1.5"><span class="material-symbols-outlined text-sm text-slate-600">history</span> Lịch Sử Kiểm Duyệt & Phiên Bản</span>
                    <span class="text-slate-400 text-[11px] font-bold">Mở rộng ▾</span>
                </summary>
                
                <div class="pt-3 space-y-4">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-bold text-slate-700">Các phiên bản nội dung:</span>
                            <button type="button" onclick="triggerDiffView()" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-[11px]">
                                So Sánh Phiên Bản Diff
                            </button>
                        </div>
                        <div id="inspectVersionsList" class="flex gap-2 overflow-x-auto py-1"></div>
                    </div>

                    <div>
                        <span class="font-bold text-slate-700 block mb-2">Nhật ký thao tác xử lý:</span>
                        <div id="inspectHistoryTimeline" class="space-y-1.5 max-h-32 overflow-y-auto"></div>
                    </div>
                </div>
            </details>
        </div>

        <!-- BOTTOM CONTROL ACTION BAR (CHỈ GỒM 3 NÚT CORE CẦN THIẾT) -->
        <div class="pt-3 border-t border-slate-200 flex items-center justify-end gap-3">
            <button type="button" onclick="openChangesRequiredDialog()" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white font-extrabold rounded-2xl text-xs shadow-xs transition-all active:scale-95 cursor-pointer flex items-center gap-1.5">
                <span class="material-symbols-outlined text-base">edit_note</span>
                <span>⚠ Yêu Cầu Sửa</span>
            </button>
            <button type="button" onclick="openRejectDialog()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-extrabold rounded-2xl text-xs shadow-xs transition-all active:scale-95 cursor-pointer flex items-center gap-1.5">
                <span class="material-symbols-outlined text-base">cancel</span>
                <span>✕ Từ Chối</span>
            </button>
            <button type="button" onclick="openApproveDialog()" class="px-6 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-black rounded-2xl text-xs shadow-md transition-all active:scale-95 cursor-pointer flex items-center gap-1.5">
                <span class="material-symbols-outlined text-base">check_circle</span>
                <span>✓ Phê Duyệt</span>
            </button>
        </div>
    </div>
</div>

<!-- MODAL XÁC NHẬN PHÊ DUYỆT -->
<div id="approveDialog" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-700 text-xl">check_circle</span>
            <span>Xác nhận Phê Duyệt</span>
        </h3>
        <p class="text-xs text-slate-600 leading-relaxed">
            Bạn có chắc chắn muốn **PHÊ DUYỆT** sản phẩm này để đăng bán công khai trên hệ thống Chợ Việt Online?
        </p>
        <div class="flex justify-end gap-2 pt-2">
            <button type="button" onclick="closeDialog('approveDialog')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs">Hủy</button>
            <button type="button" onclick="confirmApprove()" class="px-5 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-black rounded-xl text-xs shadow-sm">✓ Xác Nhận Phê Duyệt</button>
        </div>
    </div>
</div>

<!-- MODAL YÊU CẦU SỬA -->
<div id="changesRequiredDialog" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-amber-600 text-xl">edit_note</span>
            <span>Yêu cầu tiểu thương sửa lại sản phẩm</span>
        </h3>
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Lý do yêu cầu sửa <span class="text-red-500">*</span></label>
            <textarea id="changesRequiredNotes" rows="3" placeholder="Ví dụ: Giá chưa hợp lệ, mô tả cần làm rõ nguồn gốc sản phẩm..." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs outline-none focus:border-amber-600 font-medium"></textarea>
        </div>
        <div class="flex justify-end gap-2 pt-2">
            <button type="button" onclick="closeDialog('changesRequiredDialog')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs">Hủy</button>
            <button type="button" onclick="confirmChangesRequired()" class="px-5 py-2 bg-amber-600 hover:bg-amber-700 text-white font-black rounded-xl text-xs shadow-sm">Gửi Yêu Cầu Sửa</button>
        </div>
    </div>
</div>

<!-- MODAL TỪ CHỐI -->
<div id="rejectDialog" class="hidden fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 space-y-4 shadow-2xl">
        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-red-600 text-xl">cancel</span>
            <span>Từ chối duyệt sản phẩm</span>
        </h3>
        <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Lý do từ chối <span class="text-red-500">*</span></label>
            <textarea id="rejectNotes" rows="3" placeholder="Ví dụ: Sản phẩm thuộc danh mục cấm bán, hình ảnh vi phạm chính sách..." class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs outline-none focus:border-red-600 font-medium"></textarea>
        </div>
        <div class="flex justify-end gap-2 pt-2">
            <button type="button" onclick="closeDialog('rejectDialog')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs">Hủy</button>
            <button type="button" onclick="confirmReject()" class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white font-black rounded-xl text-xs shadow-sm">✕ Xác Nhận Từ Chối</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentActiveCaseId = 0;
    let currentEntityType = 'Product';
    let currentEntityId = 0;

    async function openInspectModal(caseId) {
        currentActiveCaseId = caseId;
        const modal = document.getElementById('inspectModal');
        if (modal) modal.classList.remove('hidden');

        try {
            const res = await fetch(`/Moderation/GetCaseDetail?caseId=${caseId}`);
            if (!res.ok) return;
            const data = await res.json();

            currentEntityType = data.entityType;
            currentEntityId = data.entityId;

            document.getElementById('inspectCaseTitle').innerText = `KIỂM DUYỆT #MC-${String(data.caseId).padStart(6, '0')}`;
            document.getElementById('inspectScoreNum').innerText = `${data.riskScore} / 100`;

            const badge = document.getElementById('inspectRiskBadge');
            if (badge) {
                badge.innerText = data.riskScore >= 60 ? '🔴 CAO' : (data.riskScore >= 30 ? '🟠 TRUNG BÌNH' : '🟢 THẤP');
                badge.className = `px-3 py-1 rounded-full font-black text-xs ${data.riskScore >= 60 ? 'bg-red-100 text-red-700 border border-red-300' : (data.riskScore >= 30 ? 'bg-amber-100 text-amber-900 border border-amber-300' : 'bg-emerald-100 text-emerald-800 border border-emerald-300')}`;
            }

            document.getElementById('inspectDecisionText').innerText = '⏳ Chờ Admin quyết định';
            document.getElementById('inspectSnapshot').innerText = data.snapshot || '{}';
            document.getElementById('inspectSystemRecommendation').innerText = data.systemRecommendation || 'Sản phẩm đủ điều kiện để Admin xem xét phê duyệt.';

            // Fill product & store detail info
            if (data.detailInfo) {
                document.getElementById('inspectName').innerText = data.detailInfo.productName;
                document.getElementById('inspectPrice').innerText = `${data.detailInfo.price.toLocaleString('vi-VN')}đ`;
                document.getElementById('inspectImg').src = data.detailInfo.imageUrl || 'https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?w=300';
                document.getElementById('inspectStoreName').innerText = data.detailInfo.storeName;
                document.getElementById('inspectRepresentative').innerText = data.detailInfo.representativeName;
                document.getElementById('inspectPhone').innerText = data.detailInfo.verifiedPhone;
                document.getElementById('inspectMarket').innerText = data.detailInfo.marketName;
                document.getElementById('inspectCategory').innerText = data.detailInfo.categoryName;
            }

            // Triggered rules
            const rulesBox = document.getElementById('inspectTriggeredRules');
            let rulesList = [];
            try { rulesList = JSON.parse(data.triggeredRules || '[]'); } catch(e) {}
            if (rulesList.length === 0) {
                rulesBox.innerHTML = '<div class="text-emerald-700 font-bold">✓ Không phát hiện vi phạm</div>';
            } else {
                rulesBox.innerHTML = rulesList.map(r => `<div class="text-red-600 font-bold flex items-center gap-1"><span class="material-symbols-outlined text-sm">warning</span> ⚠ ${r}</div>`).join('');
            }

            // Versions
            const versionsBox = document.getElementById('inspectVersionsList');
            if (data.versions && data.versions.length > 0) {
                versionsBox.innerHTML = data.versions.map(v => `
                    <div class="bg-white border border-slate-200 px-3 py-1.5 rounded-xl font-bold text-slate-800 text-[11px] shrink-0">
                        Version #${v.versionNumber} ${v.versionNumber === data.versions[0].versionNumber ? '(Hiện tại)' : ''}
                    </div>
                `).join('');
            } else {
                versionsBox.innerHTML = '<div class="text-slate-400 text-[11px]">Chưa có lịch sử phiên bản.</div>';
            }

            // Timeline
            const timelineBox = document.getElementById('inspectHistoryTimeline');
            if (data.history && data.history.length > 0) {
                timelineBox.innerHTML = data.history.map(h => `
                    <div class="bg-white p-2 rounded-xl border border-slate-200 flex justify-between items-center text-[11px]">
                        <div><span class="font-extrabold text-slate-900">${h.adminName}:</span> ${h.actionType} (${h.reason || '---'})</div>
                        <span class="text-slate-400 font-mono text-[10px]">${h.timestamp}</span>
                    </div>
                `).join('');
            } else {
                timelineBox.innerHTML = '<div class="text-slate-400 font-medium text-[11px]">🤖 Auto Moderation: Risk Score = ' + data.riskScore + '</div>';
            }
        } catch(e) {
            console.error(e);
        }
    }

    function closeInspectModal() {
        const modal = document.getElementById('inspectModal');
        if (modal) modal.classList.add('hidden');
    }

    function closeDialog(dialogId) {
        const dlg = document.getElementById(dialogId);
        if (dlg) dlg.classList.add('hidden');
    }

    function openApproveDialog() {
        document.getElementById('approveDialog').classList.remove('hidden');
    }

    function confirmApprove() {
        closeDialog('approveDialog');
        submitSingleReview(currentActiveCaseId, 'Approved', 'Admin duyệt chấp thuận sản phẩm');
    }

    function openChangesRequiredDialog() {
        document.getElementById('changesRequiredNotes').value = '';
        document.getElementById('changesRequiredDialog').classList.remove('hidden');
    }

    function confirmChangesRequired() {
        const notes = document.getElementById('changesRequiredNotes').value.trim();
        if (!notes) {
            alert('Vui lòng nhập lý do yêu cầu tiểu thương sửa lại sản phẩm!');
            return;
        }
        closeDialog('changesRequiredDialog');
        submitSingleReview(currentActiveCaseId, 'ChangesRequired', notes);
    }

    function openRejectDialog() {
        document.getElementById('rejectNotes').value = '';
        document.getElementById('rejectDialog').classList.remove('hidden');
    }

    function confirmReject() {
        const notes = document.getElementById('rejectNotes').value.trim();
        if (!notes) {
            alert('Vui lòng nhập lý do từ chối sản phẩm!');
            return;
        }
        closeDialog('rejectDialog');
        submitSingleReview(currentActiveCaseId, 'Rejected', notes);
    }

    function triggerDiffView() {
        openDiffModal(currentEntityType, currentEntityId);
    }

    function submitSingleReview(caseId, decisionStatus, notes) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Moderation/Review';

        const tokenField = document.querySelector('#afContainer input[name="__RequestVerificationToken"]');
        if (tokenField) {
            const csrfInput = document.createElement('input');
            csrfInput.type = 'hidden';
            csrfInput.name = '__RequestVerificationToken';
            csrfInput.value = tokenField.value;
            form.appendChild(csrfField);
        }

        const caseInput = document.createElement('input');
        caseInput.type = 'hidden'; caseInput.name = 'caseId'; caseInput.value = caseId; form.appendChild(caseInput);

        const statusInput = document.createElement('input');
        statusInput.type = 'hidden'; statusInput.name = 'decisionStatus'; statusInput.value = decisionStatus; form.appendChild(statusInput);

        const notesInput = document.createElement('input');
        notesInput.type = 'hidden'; notesInput.name = 'notes'; notesInput.value = notes || ''; form.appendChild(notesInput);

        document.body.appendChild(form);
        form.submit();
    }
</script>
}
