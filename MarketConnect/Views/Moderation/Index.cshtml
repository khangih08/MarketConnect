@model List<MarketConnect.Data.ModerationCase>

@{
    ViewData["Title"] = "Cổng Kiểm Duyệt Nội Dung & Quản Trị Hệ Thống - MarketConnect";
    var markets = ViewBag.Markets as List<MarketConnect.Data.Market> ?? new List<MarketConnect.Data.Market>();
    var provinces = ViewBag.Provinces as List<MarketConnect.Data.Province> ?? new List<MarketConnect.Data.Province>();
    var pendingAppeals = ViewBag.PendingAppeals as List<MarketConnect.Data.ModerationAppeal> ?? new List<MarketConnect.Data.ModerationAppeal>();
}

<div class="max-w-[1440px] mx-auto px-4 md:px-16 py-6 space-y-6">
    <!-- Header Title & Role Access -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-200 pb-4">
        <div>
            <h1 class="text-2xl font-extrabold text-gray-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-800 text-[28px]">gavel</span>
                <span>Cổng Kiểm Duyệt Nội Dung & Phân Quyền Quản Trị</span>
            </h1>
            <p class="text-xs text-gray-500 mt-1">Đánh giá rủi ro đa chiều tự động, hàng đợi kiểm duyệt ưu tiên thủ công và phê duyệt theo phạm vi địa lý (Data Scope).</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/AdminMfa/Verify" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-amber-50 hover:bg-amber-100 text-amber-900 font-extrabold rounded-2xl text-xs border border-amber-300 transition-all">
                <span class="material-symbols-outlined text-sm">security</span> Xác thực MFA Quản trị
            </a>
            <a href="/AdminRole" class="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-800 hover:bg-emerald-900 text-white font-extrabold rounded-2xl text-xs shadow-sm transition-all">
                <span class="material-symbols-outlined text-sm">admin_panel_settings</span> Quản lý Phân Quyền (RBAC) &rarr;
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 text-emerald-800 rounded-2xl text-xs font-bold border border-emerald-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-red-50 text-red-800 rounded-2xl text-xs font-bold border border-red-200 flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">warning</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- KPI Statistics Dashboard Bar (FR-07) -->
    <div class="grid grid-cols-2 md:grid-cols-6 gap-3 text-center">
        <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs">
            <div class="text-[11px] font-extrabold text-gray-400 uppercase tracking-wider">Chờ Kiểm Duyệt</div>
            <div class="text-2xl font-black text-amber-700 mt-1">@ViewBag.TotalPending</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs">
            <div class="text-[11px] font-extrabold text-gray-400 uppercase tracking-wider">Rủi Ro Cao (High)</div>
            <div class="text-2xl font-black text-red-600 mt-1">@ViewBag.HighRiskCount</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs">
            <div class="text-[11px] font-extrabold text-gray-400 uppercase tracking-wider">Rủi Ro Trung Bình</div>
            <div class="text-2xl font-black text-amber-800 mt-1">@ViewBag.MediumRiskCount</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs">
            <div class="text-[11px] font-extrabold text-gray-400 uppercase tracking-wider">Đã Tự Động Duyệt</div>
            <div class="text-2xl font-black text-emerald-800 mt-1">@ViewBag.AutoApprovedCount</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs">
            <div class="text-[11px] font-extrabold text-gray-400 uppercase tracking-wider">Đã Tự Động Từ Chối</div>
            <div class="text-2xl font-black text-stone-700 mt-1">@ViewBag.AutoRejectedCount</div>
        </div>
        <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-2xs">
            <div class="text-[11px] font-extrabold text-gray-400 uppercase tracking-wider">Khiếu Nại Chờ Duyệt</div>
            <div class="text-2xl font-black text-purple-800 mt-1">@ViewBag.PendingAppealsCount</div>
        </div>
    </div>

    <!-- Scoped Filters Bar -->
    <div class="bg-white p-4 rounded-2xl border border-gray-200 flex flex-wrap gap-3 items-center text-xs shadow-2xs">
        <span class="font-extrabold text-gray-700">Bộ lọc thông minh:</span>
        <a href="/Moderation" class="px-3 py-1.5 rounded-xl border border-gray-200 font-bold hover:bg-emerald-50 @(ViewBag.EntityType == null ? "bg-emerald-800 text-white" : "")">Tất Cả Queue</a>
        <a href="/Moderation?entityType=Product" class="px-3 py-1.5 rounded-xl border border-gray-200 font-bold hover:bg-emerald-50 @(ViewBag.EntityType == "Product" ? "bg-emerald-800 text-white" : "")">Sản Phẩm</a>
        <a href="/Moderation?entityType=Store" class="px-3 py-1.5 rounded-xl border border-gray-200 font-bold hover:bg-emerald-50 @(ViewBag.EntityType == "Store" ? "bg-emerald-800 text-white" : "")">Gian Hàng</a>
        
        <div class="h-4 w-[1px] bg-gray-300 mx-1"></div>
        <a href="/Moderation?riskLevel=High" class="px-3 py-1.5 rounded-xl border border-red-200 font-bold bg-red-50 text-red-700 hover:bg-red-100">⚠ Rủi Ro Cao (High)</a>
        <a href="/Moderation?riskLevel=Medium" class="px-3 py-1.5 rounded-xl border border-amber-200 font-bold bg-amber-50 text-amber-900 hover:bg-amber-100">⚠ Rủi Ro TB (Medium)</a>
    </div>

    <!-- Bulk Moderation Bar (FR-07 BULK REVIEW) -->
    <form id="bulkForm" method="post" action="/Moderation/BulkReview">
        @Html.AntiForgeryToken()
        <div class="bg-emerald-900 text-white p-4 rounded-2xl mb-4 flex flex-wrap items-center justify-between gap-4 text-xs shadow-md">
            <div class="flex items-center gap-3">
                <input type="checkbox" id="selectAllCheckbox" onclick="toggleSelectAll(this)" class="w-4 h-4 rounded cursor-pointer" />
                <span class="font-extrabold">Chọn Tất Cả Hàng Đợi Kiểm Duyệt Hàng Loạt (Bulk Moderation)</span>
            </div>
            <div class="flex items-center gap-2 flex-grow max-w-md">
                <input type="text" name="notes" placeholder="Lý do xử lý hàng loạt (Bắt buộc)..." class="w-full bg-white text-gray-900 rounded-xl px-3 py-1.5 text-xs outline-none font-medium" />
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" name="decisionStatus" value="Approved" class="bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer shadow-xs">
                    ✓ Duyệt Hàng Loạt
                </button>
                <button type="submit" name="decisionStatus" value="Rejected" class="bg-red-600 hover:bg-red-700 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer shadow-xs">
                    ✕ Từ Chối Hàng Loạt
                </button>
            </div>
        </div>

        <!-- Moderation Priority Queue List -->
        <div class="space-y-4">
            @if (!Model.Any())
            {
                <div class="bg-white p-8 rounded-2xl text-center text-gray-500 text-xs border border-gray-200 shadow-2xs">
                    <span class="material-symbols-outlined text-4xl text-emerald-600 block mb-2">check_circle</span>
                    Hàng đợi kiểm duyệt hiện tại đang trống. Tất cả nội dung đã được xử lý chuẩn xác!
                </div>
            }
            else
            {
                @foreach (var c in Model)
                {
                    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm p-6 space-y-4 hover:border-emerald-300 transition-colors">
                        <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-gray-100">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" name="caseIds" value="@c.Id" class="case-checkbox w-4 h-4 rounded cursor-pointer" />
                                <span class="bg-emerald-100 text-emerald-900 text-xs font-black px-3 py-1 rounded-full uppercase">@c.EntityType</span>
                                <span class="font-extrabold text-sm text-gray-900">ID thực thể: #@c.EntityId</span>
                                @if (c.IsEscalated)
                                {
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-purple-100 text-purple-900 border border-purple-300 animate-pulse">
                                        ⚡ ĐÃ CHUYỂN CẤP DUYỆT (ESCALATED)
                                    </span>
                                }
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-xs font-bold text-gray-500">Mức Rủi Ro:</span>
                                <span class="px-3 py-1 rounded-full font-black text-xs @(c.RiskLevel == MarketConnect.Data.RiskLevel.High || c.RiskLevel == MarketConnect.Data.RiskLevel.Critical ? "bg-red-100 text-red-700 border border-red-300" : "bg-amber-100 text-amber-900 border border-amber-300")">
                                    @c.RiskLevel.ToString().ToUpper() (Điểm: @c.RiskScore/100)
                                </span>
                            </div>
                        </div>

                        <!-- Content Snapshot & Triggered Rules Breakdown -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-gray-700 bg-gray-50 p-4 rounded-2xl border border-gray-100">
                            <div class="space-y-1">
                                <p class="font-extrabold text-gray-900">Chi tiết Snapshot Nội dung (Version #@c.CurrentVersionNumber):</p>
                                <pre class="bg-white p-2.5 rounded-xl border border-gray-200 text-[11px] text-gray-800 font-mono overflow-x-auto max-h-32">@c.ContentSnapshotJson</pre>
                            </div>
                            <div class="space-y-1">
                                <p class="font-extrabold text-gray-900">Quy tắc tự động bị kích hoạt (Triggered Rules):</p>
                                <div class="bg-white p-2.5 rounded-xl border border-gray-200 text-[11px] space-y-1 max-h-32 overflow-y-auto">
                                    @if (!string.IsNullOrEmpty(c.TriggeredRulesJson))
                                    {
                                        <p class="text-red-600 font-bold">@c.TriggeredRulesJson</p>
                                    }
                                    else
                                    {
                                        <p class="text-emerald-700 font-bold">✓ Không phát hiện vi phạm quy tắc cơ bản.</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Action Controls (Single Review, Request Edit, Reject, Escalate, Override) -->
                        <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-gray-100">
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="loadActionHistory(@c.Id)" class="text-xs font-bold text-gray-600 hover:text-emerald-800 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">history</span> Xem lịch sử xử lý &rarr;
                                </button>
                                <button type="button" onclick="loadVersionHistory('@c.EntityType', @c.EntityId)" class="text-xs font-bold text-blue-700 hover:underline flex items-center gap-1">
                                    <span class="material-symbols-outlined text-sm">inventory_2</span> Xem phiên bản (Versions) &rarr;
                                </button>
                            </div>

                            <div class="flex items-center gap-2 flex-wrap">
                                <!-- Form Single Review Action -->
                                <button type="button" onclick="submitSingleReview(@c.Id, 'Approved')" class="bg-emerald-800 hover:bg-emerald-900 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer shadow-2xs">
                                    ✓ Phê Duyệt
                                </button>
                                <button type="button" onclick="submitSingleReview(@c.Id, 'ChangesRequired')" class="bg-amber-600 hover:bg-amber-700 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer shadow-2xs">
                                    ✎ Yêu Cầu Sửa
                                </button>
                                <button type="button" onclick="submitSingleReview(@c.Id, 'Rejected')" class="bg-red-600 hover:bg-red-700 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer shadow-2xs">
                                    ✕ Từ Chối
                                </button>
                                <button type="button" onclick="openOverrideModal(@c.Id)" class="bg-purple-700 hover:bg-purple-800 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer shadow-2xs">
                                    ⚡ Ghi Đè (Override)
                                </button>
                                <button type="button" onclick="openEscalateModal(@c.Id)" class="bg-stone-800 hover:bg-stone-900 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer shadow-2xs">
                                    ⬆ Chuyển Cấp Duyệt
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </form>

    <!-- SECTION: KHUYẾN NẠI CỦA TIỂU THƯƠNG (MERCHANT APPEALS REVIEW TAB) -->
    @if (pendingAppeals.Any())
    {
        <div class="mt-10 space-y-4 pt-6 border-t border-gray-200">
            <h2 class="text-xl font-extrabold text-gray-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-800 text-[26px]">connect_without_contact</span>
                <span>Danh Sách Khiếu Nại Từ Tiểu Thương (Appeals Queue)</span>
            </h2>

            <div class="grid grid-cols-1 gap-4">
                @foreach (var app in pendingAppeals)
                {
                    <div class="bg-white p-6 rounded-3xl border border-purple-200 shadow-sm space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-gray-100">
                            <div class="font-extrabold text-sm text-gray-900">Khiếu Nại Hồ Sơ/Sản Phẩm Case #@app.CaseId</div>
                            <span class="px-3 py-0.5 rounded-full text-xs font-black bg-purple-100 text-purple-900">@app.Status.ToString()</span>
                        </div>
                        <div class="text-xs text-gray-700 space-y-1">
                            <p><strong>Tiểu thương gửi:</strong> @(app.Merchant?.Name ?? "Tiểu thương") (@(app.Merchant?.Email))</p>
                            <p><strong>Lý do khiếu nại:</strong> <span class="font-medium text-gray-900">@app.Reason</span></p>
                        </div>
                        <form method="post" action="/Moderation/ReviewAppeal" class="flex items-center gap-2 pt-2 border-t border-gray-100">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appealId" value="@app.Id" />
                            <input type="text" name="adminResponse" placeholder="Phản hồi lý do xử lý khiếu nại..." class="bg-gray-50 border border-gray-200 rounded-xl px-3 py-1.5 text-xs outline-none flex-grow font-medium" />
                            <button type="submit" name="decisionStatus" value="Accepted" class="bg-emerald-700 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer">
                                Chap Nhan Khiếu Nại (Approve)
                            </button>
                            <button type="submit" name="decisionStatus" value="Rejected" class="bg-red-600 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-xs cursor-pointer">
                                Bác Khiếu Nại (Reject)
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Modal Modals Script -->
<script>
    function toggleSelectAll(master) {
        const checkboxes = document.querySelectorAll('.case-checkbox');
        checkboxes.forEach(cb => cb.checked = master.checked);
    }

    function submitSingleReview(caseId, decisionStatus) {
        const notes = prompt(`Nhập lý do/hướng dẫn xử lý cho quyết định ${decisionStatus}:`);
        if (notes === null) return;
        if ((decisionStatus === 'Rejected' || decisionStatus === 'ChangesRequired') && !notes.trim()) {
            alert('Quản trị viên BẮT BUỘC phải nhập lý do khi Từ Chối hoặc Yêu Cầu Sửa!');
            return;
        }

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Moderation/Review';

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) {
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
        }

        const caseInput = document.createElement('input');
        caseInput.type = 'hidden';
        caseInput.name = 'caseId';
        caseInput.value = caseId;
        form.appendChild(caseInput);

        const statusInput = document.createElement('input');
        statusInput.type = 'hidden';
        statusInput.name = 'decisionStatus';
        statusInput.value = decisionStatus;
        form.appendChild(statusInput);

        const notesInput = document.createElement('input');
        notesInput.type = 'hidden';
        notesInput.name = 'notes';
        notesInput.value = notes;
        form.appendChild(notesInput);

        document.body.appendChild(form);
        form.submit();
    }

    function openOverrideModal(caseId) {
        const reason = prompt('BẮT BUỘC nhập lý do Ghi Đè quyết định (Override):');
        if (!reason || !reason.trim()) {
            alert('Lý do Ghi Đè không được để trống!');
            return;
        }
        const newStatus = prompt('Nhập trạng thái mới (Approved / Rejected / ChangesRequired):', 'Approved');
        if (!newStatus) return;

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Moderation/Override';

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) {
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
        }

        const cInput = document.createElement('input');
        cInput.type = 'hidden';
        cInput.name = 'caseId';
        cInput.value = caseId;
        form.appendChild(cInput);

        const sInput = document.createElement('input');
        sInput.type = 'hidden';
        sInput.name = 'newStatus';
        sInput.value = newStatus;
        form.appendChild(sInput);

        const rInput = document.createElement('input');
        rInput.type = 'hidden';
        rInput.name = 'overrideReason';
        rInput.value = reason;
        form.appendChild(rInput);

        document.body.appendChild(form);
        form.submit();
    }

    function openEscalateModal(caseId) {
        const reason = prompt('BẮT BUỘC nhập lý do Chuyển Cấp Duyệt (Escalate):');
        if (!reason || !reason.trim()) return;

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Moderation/Escalate';

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) {
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
        }

        const cInput = document.createElement('input');
        cInput.type = 'hidden';
        cInput.name = 'caseId';
        cInput.value = caseId;
        form.appendChild(cInput);

        const rInput = document.createElement('input');
        rInput.type = 'hidden';
        rInput.name = 'escalationReason';
        rInput.value = reason;
        form.appendChild(rInput);

        document.body.appendChild(form);
        form.submit();
    }

    async function loadActionHistory(caseId) {
        try {
            const res = await fetch(`/Moderation/GetActionHistory?caseId=${caseId}`);
            if (!res.ok) return;
            const data = await res.json();
            let msg = `LỊCH SỬ XỬ LÝ CHO CASE #${caseId}:\n\n`;
            if (data.length === 0) msg += 'Chưa có lịch sử xử lý thủ công.';
            data.forEach(h => {
                msg += `[${h.timestamp}] ${h.adminName}: ${h.actionType} (${h.oldStatus} -> ${h.newStatus})\nLý do: ${h.reason}\n------------------\n`;
            });
            alert(msg);
        } catch (e) { console.error(e); }
    }

    async function loadVersionHistory(entityType, entityId) {
        try {
            const res = await fetch(`/Moderation/GetVersionHistory?entityType=${entityType}&entityId=${entityId}`);
            if (!res.ok) return;
            const data = await res.json();
            let msg = `LỊCH SỬ PHIÊN BẢN (CONTENT VERSIONS) ${entityType} #${entityId}:\n\n`;
            data.forEach(v => {
                msg += `Version #${v.versionNumber} [${v.createdAt}]\nSnapshot: ${v.snapshotJson}\n------------------\n`;
            });
            alert(msg);
        } catch (e) { console.error(e); }
    }
</script>
