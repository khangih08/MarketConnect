@model List<MarketConnect.Data.Store>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Tiểu Thương & Gian Hàng (Merchants Management)";
}

<div class="space-y-6">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-800 text-3xl">store</span>
                <span>Quản Lý Tiểu Thương & Hồ Sơ Gian Hàng</span>
            </h1>
            <p class="text-xs text-slate-500 mt-1">Đánh giá rủi ro tài khoản (Account Risk FR-06), phê duyệt hồ sơ đăng ký sạp hàng và lịch sử khiếu nại vi phạm.</p>
        </div>
    </div>

    <!-- Merchants Table -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-extrabold text-sm text-slate-900 uppercase">Danh Sách Gian Hàng Tiểu Thương</h3>
            <span class="text-xs font-bold text-slate-500">Tổng số: @Model.Count gian hàng</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-slate-700 border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-900 font-extrabold uppercase tracking-wider text-[11px]">
                        <th class="p-3.5">ID</th>
                        <th class="p-3.5">Tên Gian Hàng / Đại Diện</th>
                        <th class="p-3.5">Chợ Trực Thuộc</th>
                        <th class="p-3.5">SĐT Xác Minh</th>
                        <th class="p-3.5">Trạng Thái Hồ Sơ</th>
                        <th class="p-3.5 text-right">Thao Tác Duyệt/Khóa</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var s in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="p-3.5 font-bold text-slate-900">#@s.Id</td>
                            <td class="p-3.5">
                                <div class="font-extrabold text-slate-900 text-sm">@s.StoreName</div>
                                <div class="text-[11px] text-slate-500">Đại diện: <strong>@s.RepresentativeName</strong></div>
                            </td>
                            <td class="p-3.5 font-bold text-slate-800">
                                @(s.Market?.Name ?? "Chợ Nhân Chính")
                            </td>
                            <td class="p-3.5 font-mono text-slate-900 font-bold">
                                @s.VerifiedPhone
                            </td>
                            <td class="p-3.5">
                                <span class="px-2.5 py-1 rounded-full font-black text-[11px] @(s.Status == MarketConnect.Data.StoreStatus.Approved ? "bg-emerald-100 text-emerald-900 border border-emerald-300" : s.Status == MarketConnect.Data.StoreStatus.Rejected ? "bg-red-100 text-red-700 border border-red-300" : "bg-amber-100 text-amber-900 border border-amber-300")">
                                    @s.Status.ToString()
                                </span>
                            </td>
                            <td class="p-3.5 text-right">
                                <form method="post" action="/Moderation/ReviewStore" class="inline-flex items-center gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storeId" value="@s.Id" />
                                    <button type="submit" name="newStatus" value="Approved" class="px-2.5 py-1 bg-emerald-700 text-white font-bold rounded-xl text-[11px]">Duyệt</button>
                                    <button type="submit" name="newStatus" value="Rejected" class="px-2.5 py-1 bg-red-600 text-white font-bold rounded-xl text-[11px]">Từ chối</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
