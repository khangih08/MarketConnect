                        <div class="relative aspect-[4/3] bg-gray-50 overflow-hidden">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" src="${item.imageUrl}" alt="${item.productName}" />
                            ${item.discountPercent ? `<span class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full shadow-sm">-${item.discountPercent}%</span>` : ''}
                            <button type="button" class="absolute top-2 right-2 bg-white/90 hover:bg-white p-1.5 rounded-full shadow-sm">
                                <span class="material-symbols-outlined text-[16px] text-gray-400 hover:text-red-500 transition-colors">favorite</span>
                            </button>
                        </div>
                        <div class="p-4">
                            <p class="text-gray-400 text-[10px] font-bold uppercase tracking-wider mb-1">${item.brand || 'Category'}</p>
                            <h4 class="font-bold text-xs text-gray-800 line-clamp-2 min-h-[32px] mb-2 group-hover:text-[#004532] transition-colors leading-snug">${item.productName}</h4>
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-[#004532] font-black text-sm">đ${item.price.toLocaleString('vi-VN')}</span>
                            </div>
                            <div class="flex items-center gap-1 text-[11px] text-gray-500">
                                <span class="material-symbols-outlined text-amber-500 text-[14px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                <span class="font-bold text-gray-800">${item.rating}</span>
                                <span>(${item.reviewCount || 0})</span>
                            </div>
                        </div>
                    </div>
                `).join('');
            }
        } catch (err) {
            console.error("Lỗi khi tải sản phẩm liên quan:", err);
        }
    }
});
</script>