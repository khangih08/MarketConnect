@{
    Layout = "_Layout";
    ViewData["Title"] = "Chi tiết sản phẩm | MarketConnect";
}

<style>
    .card-shadow {
        box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.03);
    }
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #00453233;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #00453266;
    }
</style>

<main class="max-w-[1280px] mx-auto px-4 md:px-8 py-6 min-h-screen">
    <!-- 1. Breadcrumbs Navigation -->
    <nav class="flex items-center gap-2 mb-6 text-gray-500 text-xs font-medium bg-white/60 backdrop-blur-sm px-4 py-2.5 rounded-xl border border-gray-100/80 shadow-sm w-fit">
        <a class="hover:text-[#004532] transition-colors flex items-center gap-1" href="/">
            <span class="material-symbols-outlined text-[16px]">home</span>
            <span>Trang chủ</span>
        </a>
        <span class="material-symbols-outlined text-[14px] text-gray-300">chevron_right</span>
        <a id="breadcrumbCategory" class="hover:text-[#004532] transition-colors" href="#">Sản phẩm</a>
        <span class="material-symbols-outlined text-[14px] text-gray-300">chevron_right</span>
        <span id="breadcrumbTitle" class="text-gray-800 font-semibold truncate max-w-[280px]">Đang tải...</span>
    </nav>

    <!-- 2. Main Product Section (2 Columns Desktop, 1 Column Mobile) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- LEFT COLUMN: Media Gallery & Product Specifications / Description -->
        <div class="lg:col-span-7 flex flex-col gap-8">
            <!-- Media Gallery Box -->
            <div class="bg-white rounded-2xl p-6 card-shadow border border-gray-100">
                <!-- Main Image Preview -->
                <div class="relative aspect-square rounded-2xl overflow-hidden bg-gray-50/80 border border-gray-100 group flex items-center justify-center shadow-inner">
                    <img id="mainProductImage" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" src="/images/placeholder.svg" alt="Product Image" />
                    
                    <!-- Gallery Slider Controls -->
                    <div class="absolute inset-0 flex items-center justify-between px-4 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none">
                        <button id="btnPrevImage" type="button" class="pointer-events-auto bg-white/95 hover:bg-white text-[#004532] p-2.5 rounded-full shadow-lg transition-transform active:scale-90 flex items-center justify-center border border-gray-100">
                            <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                        </button>
                        <button id="btnNextImage" type="button" class="pointer-events-auto bg-white/95 hover:bg-white text-[#004532] p-2.5 rounded-full shadow-lg transition-transform active:scale-90 flex items-center justify-center border border-gray-100">
                            <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                        </button>
                    </div>
                    
                    <!-- Badges Over Image -->
                    <div class="absolute top-4 left-4 flex flex-col gap-2 z-10 pointer-events-none">
                        <span id="badgeBestSeller" class="bg-[#f97316] text-white text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">Bán chạy</span>
                        <span id="badgeDiscount" class="bg-red-500 text-white text-[10px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">Giảm 20%</span>
                    </div>
                </div>

                <!-- Thumbnail Grid -->
                <div id="thumbnailGallery" class="grid grid-cols-5 gap-3 mt-4">
                    <div class="aspect-square rounded-xl overflow-hidden border-2 border-[#004532] cursor-pointer shadow-sm">
                        <img class="w-full h-full object-cover" src="/images/placeholder.svg" />
                    </div>
                </div>
            </div>

            <!-- Product Specifications Card -->
            <section class="bg-white rounded-2xl p-6 md:p-8 card-shadow border border-gray-100">
                <h2 class="text-base md:text-lg font-bold text-gray-800 mb-4 flex items-center gap-2 border-b border-gray-100 pb-3">
                    <span class="material-symbols-outlined text-[#004532]">tune</span>
                    <span>Thông tin chi tiết & Tình trạng</span>
                </h2>
                <div id="specificationsContainer" class="rounded-xl overflow-hidden border border-gray-100 divide-y divide-gray-100">
                    <div class="p-4 text-gray-400 text-xs text-center">Đang tải thông số kỹ thuật...</div>
                </div>
            </section>

            <!-- Product Description Card -->
            <section class="bg-white rounded-2xl p-6 md:p-8 card-shadow border border-gray-100">
                <h2 class="text-base md:text-lg font-bold text-gray-800 mb-4 flex items-center gap-2 border-b border-gray-100 pb-3">
                    <span class="material-symbols-outlined text-[#004532]">description</span>
                    <span>Mô tả sản phẩm</span>
                </h2>
                <div id="productDescription" class="prose prose-sm max-w-none text-gray-600 space-y-3 leading-relaxed">
                    <p class="text-gray-400 text-xs italic">Đang tải mô tả sản phẩm...</p>
                </div>
            </section>
        </div>

        <!-- RIGHT COLUMN: Price Card, Seller Info, Quick Actions & Q&A Comments -->
        <div class="lg:col-span-5 flex flex-col gap-6 lg:sticky lg:top-24">
            
            <!-- 1. Header Title & Price Card -->
            <div class="bg-white rounded-2xl p-6 card-shadow border border-gray-100 flex flex-col gap-5">
                <div class="flex justify-between items-start gap-4">
                    <div class="flex-1 min-w-0">
                        <span id="brandName" class="text-[#004532] text-xs font-bold uppercase tracking-wider mb-1 block">MarketConnect</span>
                        <h1 id="productTitle" class="text-xl md:text-2xl font-bold text-gray-800 leading-snug">Đang tải sản phẩm...</h1>
                    </div>
                    <button id="btnFavorite" type="button" class="text-gray-400 hover:text-red-500 transition-colors p-2.5 rounded-full hover:bg-red-50 shrink-0 border border-gray-100">
                        <span id="heartIcon" class="material-symbols-outlined text-[20px] block" style="font-variation-settings: 'FILL' 0;">favorite</span>
                    </button>
                </div>

                <div class="flex items-center gap-3 text-xs text-gray-600 flex-wrap">
                    <div class="flex items-center text-amber-500 gap-0.5">
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star_half</span>
                        <span id="productRating" class="font-bold text-gray-800 ml-1 text-sm">4.8</span>
                    </div>
                    <div class="h-3.5 w-[1px] bg-gray-200"></div>
                    <div>Đã bán <span id="soldCount" class="font-bold text-gray-800">1</span></div>
                    <div class="h-3.5 w-[1px] bg-gray-200"></div>
                    <div class="flex items-center gap-1 text-[#004532] bg-emerald-50 px-2.5 py-1 rounded-md font-bold text-[11px] border border-emerald-100">
                        <span class="material-symbols-outlined text-[14px] text-emerald-600">verified</span>
                        <span>Chính hãng</span>
                    </div>
                </div>

                <!-- Single Premium Price Card -->
                <div class="bg-gradient-to-r from-emerald-50/80 via-emerald-50/40 to-emerald-50/10 rounded-2xl p-5 border border-emerald-100/90 shadow-sm flex items-center justify-between gap-4 flex-wrap">
                    <div>
                        <span class="text-[11px] font-semibold text-gray-500 block mb-1 uppercase tracking-wider">Giá bán công khai</span>
                        <div class="text-2xl md:text-3xl font-black text-[#004532] tracking-tight" id="productPrice">
                            đ0
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 text-xs text-emerald-800 bg-white px-3 py-2 rounded-xl border border-emerald-200/80 shadow-sm font-semibold">
                        <span class="material-symbols-outlined text-[16px] text-emerald-600">location_on</span>
                        <span id="shippingLabel">Hà Nội</span>
                    </div>
                </div>
            </div>

            <!-- 2. Seller Info Profile Card (Refactored layout to prevent overflow) -->
            <div class="bg-white rounded-2xl p-6 card-shadow border border-gray-100 flex flex-col gap-4">
                <div class="flex items-center gap-4">
                    <div class="relative shrink-0 w-14 h-14">
                        <img id="sellerLogo" class="w-14 h-14 rounded-full border-2 border-emerald-100 object-cover shadow-sm ring-2 ring-emerald-500/10" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150" alt="Seller Avatar" />
                        <div id="sellerStatus" class="absolute bottom-0 right-0 w-4 h-4 bg-emerald-500 border-2 border-white rounded-full ring-2 ring-emerald-400/20"></div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 id="sellerName" class="font-bold text-base text-gray-800 leading-tight truncate">Đang tải người bán...</h3>
                        <div class="flex items-center gap-2 mt-1 flex-wrap text-xs">
                            <span id="sellerActive" class="text-emerald-600 font-medium">Đang hoạt động</span>
                            <span class="text-gray-300">•</span>
                            <span class="text-[#004532] font-bold">Tài khoản xác thực</span>
                        </div>
                    </div>
                </div>

                <!-- Secondary Metrics Row with Clean Vertical Separators -->
                <div class="grid grid-cols-3 gap-2 pt-3 border-t border-gray-100 text-center">
                    <div class="flex flex-col items-center">
                        <span class="text-gray-400 text-[10px] font-bold uppercase tracking-wider mb-0.5">Đánh giá</span>
                        <span id="sellerRating" class="font-extrabold text-gray-800 text-xs">5.0/5.0</span>
                    </div>
                    <div class="flex flex-col items-center border-l border-gray-200">
                        <span class="text-gray-400 text-[10px] font-bold uppercase tracking-wider mb-0.5">Tin đã đăng</span>
                        <span id="sellerTotalProducts" class="font-extrabold text-gray-800 text-xs">1 tin</span>
                    </div>
                    <div class="flex flex-col items-center border-l border-gray-200">
                        <span class="text-gray-400 text-[10px] font-bold uppercase tracking-wider mb-0.5">Phản hồi</span>
                        <span class="font-extrabold text-emerald-700 text-xs">Nhanh trong 15p</span>
                    </div>
                </div>
            </div>

            <!-- 3. Communication Actions & Quick Question -->
            <div class="bg-white rounded-2xl p-6 card-shadow border border-gray-100 flex flex-col gap-4">
                <div class="grid grid-cols-2 gap-3 w-full">
                    <button id="btnCallSeller" type="button" class="bg-[#004532] hover:bg-[#065f46] text-white font-bold h-12 rounded-xl text-xs flex items-center justify-center gap-2 transition-all active:scale-[0.98] shadow-md shadow-emerald-900/10 cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">phone_enabled</span>
                        <span>Gọi điện thoại</span>
                    </button>
                    <button id="btnChatSeller" type="button" class="bg-white border-2 border-[#004532] text-[#004532] hover:bg-emerald-50 font-bold h-12 rounded-xl text-xs flex items-center justify-center gap-2 transition-all active:scale-[0.98] cursor-pointer">
                        <span class="material-symbols-outlined text-[18px]">chat</span>
                        <span>Chat nhanh</span>
                    </button>
                </div>
                
                <!-- Quick Question Bar with Inline Submit Button -->
                <div class="relative w-full rounded-xl overflow-hidden border border-gray-200 focus-within:border-[#004532] focus-within:ring-2 focus-within:ring-[#004532]/20 transition-all bg-white shadow-sm">
                    <input id="inputQuickQuestion" class="w-full h-11 pl-4 pr-20 text-xs text-gray-800 placeholder-gray-400 bg-transparent border-none outline-none focus:ring-0" placeholder="Hỏi thêm về sản phẩm này..." type="text">
                    <button id="btnSendQuickQuestion" type="button" class="absolute right-1 top-1 bottom-1 bg-[#004532] hover:bg-[#065f46] text-white px-4 rounded-lg font-bold text-xs transition-all active:scale-95 flex items-center justify-center shadow-sm cursor-pointer">
                        <span>Gửi</span>
                    </button>
                </div>
            </div>

            <!-- 4. Promo CTA Banner Card -->
            <section class="bg-gradient-to-br from-[#004532] via-[#04523d] to-[#065f46] text-white rounded-2xl p-6 shadow-md flex flex-col items-center text-center relative overflow-hidden group">
                <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                    <span class="material-symbols-outlined text-[28px] text-emerald-300">add_business</span>
                </div>
                <h3 class="font-bold text-base mb-1">Bạn đang có sản phẩm tương tự?</h3>
                <p class="text-white/80 text-xs mb-4">Đăng bán sản phẩm của bạn trên MarketConnect hoàn toàn miễn phí.</p>
                <a href="/Product/Create" class="bg-white text-[#004532] hover:bg-emerald-50 px-6 py-2.5 rounded-full font-bold text-xs w-full transition-all shadow-md group-hover:shadow-lg text-center block">
                    Đăng sản phẩm ngay
                </a>
            </section>

            <!-- 5. Q&A & Comments Widget -->
            <section class="bg-white rounded-2xl p-6 card-shadow border border-gray-100 flex flex-col h-[520px]">
                <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center justify-between border-b border-gray-100 pb-3">
                    <span class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#004532] text-[20px]">forum</span>
                        <span>Hỏi đáp & Bình luận</span>
                    </span>
                    <span id="commentCountBadge" class="bg-emerald-100 text-[#004532] px-2.5 py-0.5 rounded-full text-xs font-extrabold">0</span>
                </h2>

                <!-- Comments List Container -->
                <div id="commentsList" class="flex-1 overflow-y-auto custom-scrollbar space-y-3 pr-1">
                    <div class="flex flex-col items-center justify-center h-full text-center px-4 py-8">
                        <span class="material-symbols-outlined text-[36px] text-gray-300 mb-2">forum</span>
                        <p class="text-gray-500 text-xs font-medium">Chưa có bình luận nào cho sản phẩm này.</p>
                        <p class="text-gray-400 text-[11px] mt-1 italic">Hãy là người đầu tiên đặt câu hỏi!</p>
                    </div>
                </div>

                <!-- Comment Input Form -->
                <div class="mt-3 pt-3 border-t border-gray-100">
                    <div class="flex items-start gap-2.5">
                        <img id="currentUserAvatar" class="w-8 h-8 rounded-full object-cover shrink-0 ring-2 ring-emerald-500/20" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100" alt="Avatar" />
                        <div class="flex-1 min-w-0">
                            <textarea id="inputCommentText" onfocus="handleCommentInputFocus(event)" class="w-full border border-gray-200 rounded-xl p-2.5 text-xs focus:ring-2 focus:ring-[#004532]/20 focus:border-[#004532] outline-none resize-none transition-all placeholder-gray-400" placeholder="Viết câu hỏi hoặc bình luận của bạn..." rows="2"></textarea>
                            
                            <!-- Khung xem trước hình ảnh đính kèm (Image Thumbnail Preview) -->
                            <div id="commentImagePreviewContainer" class="hidden mt-2 relative inline-block group">
                                <img id="commentImagePreview" class="w-20 h-20 object-cover rounded-xl border border-gray-200 shadow-xs" src="" alt="Xem trước ảnh đính kèm" />
                                <button type="button" onclick="removeCommentImage()" title="Xóa ảnh đính kèm" class="absolute -top-1.5 -right-1.5 bg-red-500 hover:bg-red-600 text-white rounded-full p-0.5 shadow-sm active:scale-90 transition-all cursor-pointer flex items-center justify-center">
                                    <span class="material-symbols-outlined text-[13px]">close</span>
                                </button>
                            </div>

                            <div class="flex justify-between items-center mt-2">
                                <div class="flex items-center gap-2">
                                    <!-- Nút icon đính kèm ảnh 📷 -->
                                    <label for="commentImageInput" title="Đính kèm hình ảnh (Max 5MB)" class="flex items-center gap-1 text-gray-600 hover:text-[#004532] hover:bg-emerald-50 px-2.5 py-1 rounded-lg text-xs font-semibold cursor-pointer transition-colors border border-gray-200 shadow-2xs">
                                        <span class="material-symbols-outlined text-[18px] text-emerald-600">photo_camera</span>
                                        <span class="hidden sm:inline text-[11px]">Đính kèm ảnh</span>
                                    </label>
                                    <input type="file" id="commentImageInput" accept="image/jpeg,image/png,image/webp" onchange="handleCommentImageSelect(event)" class="hidden" />

                                    <span class="text-[10px] text-gray-400">Tối đa 5MB (.jpg, .png)</span>
                                </div>
                                
                                <button id="btnSubmitComment" type="button" class="bg-[#004532] hover:bg-[#065f46] text-white px-4 py-1.5 rounded-lg font-bold text-xs transition-all active:scale-95 cursor-pointer shadow-sm">
                                    Gửi bình luận
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </div>

    <!-- 3. Related Products Section -->
    <section class="mt-12">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg md:text-xl font-bold text-gray-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-[#004532]">grid_view</span>
                <span>Sản phẩm tương tự</span>
            </h2>
            <a class="text-[#004532] font-bold text-xs flex items-center gap-1 hover:underline" href="/">
                <span>Xem tất cả</span>
                <span class="material-symbols-outlined text-[16px]">arrow_right_alt</span>
            </a>
        </div>
        <div id="relatedProductsGrid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
            <div class="bg-white rounded-2xl p-4 border border-gray-100 text-center text-xs text-gray-400 col-span-full py-8">Đang tải sản phẩm tương tự...</div>
        </div>
    </section>

    <!-- MODAL YÊU CẦU ĐĂNG NHẬP -->
    <div id="loginRequiredModal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center shadow-2xl border border-gray-100 animate-in fade-in zoom-in duration-200">
            <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-[28px]">lock</span>
            </div>
            <h4 class="text-base font-bold text-gray-800 mb-1">Yêu cầu đăng nhập</h4>
            <p class="text-xs text-gray-500 mb-6 leading-relaxed">Bạn cần đăng nhập tài khoản MarketConnect để viết bình luận hoặc đặt câu hỏi về sản phẩm này.</p>
            
            <div class="flex items-center gap-3">
                <button type="button" onclick="hideLoginModal()" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold py-2.5 rounded-xl transition-colors">
                    Để sau
                </button>
                <a id="modalLoginBtn" href="/Account/Login" class="flex-1 bg-[#004532] hover:bg-[#065f46] text-white text-xs font-bold py-2.5 rounded-xl transition-colors shadow-sm inline-block">
                    Đăng nhập
                </a>
            </div>
        </div>
    </div>

    <!-- MODAL XÁC NHẬN XÓA BÌNH LUẬN -->
    <div id="deleteCommentModal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center shadow-2xl border border-gray-100 animate-in fade-in zoom-in duration-200">
            <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-[28px]">delete</span>
            </div>
            <h4 class="text-base font-bold text-gray-800 mb-1">Xác nhận xóa bình luận</h4>
            <p class="text-xs text-gray-500 mb-6 leading-relaxed">Bạn có chắc chắn muốn xóa bình luận này? Thao tác này không thể hoàn tác.</p>
            
            <div class="flex items-center gap-3">
                <button type="button" onclick="hideDeleteCommentModal()" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold py-2.5 rounded-xl transition-colors">
                    Hủy bỏ
                </button>
                <button id="btnConfirmDeleteComment" type="button" class="flex-1 bg-red-600 hover:bg-red-700 text-white text-xs font-bold py-2.5 rounded-xl transition-colors shadow-sm cursor-pointer">
                    Xóa bình luận
                </button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/product-detail.js" asp-append-version="true"></script>
}