@using MarketConnect.Services
@inject ICurrentUserService CurrentUserService
@{
    var currentUserRole = CurrentUserService.Role;
    var currentEmail = CurrentUserService.Email;
    var currentUserId = CurrentUserService.UserId;
    var currentPath = Context.Request.Path.Value ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketConnect Admin Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col">
    <!-- Top Header Bar -->
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-40 shadow-md">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
            <!-- Brand Logo -->
            <div class="flex items-center gap-3">
                <a href="/Moderation/Dashboard" class="flex items-center gap-2.5 group">
                    <div class="w-9 h-9 rounded-xl bg-emerald-600 flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
                        <span class="material-symbols-outlined text-2xl">admin_panel_settings</span>
                    </div>
                    <div>
                        <span class="text-base font-extrabold tracking-tight text-white block leading-none">MarketConnect</span>
                        <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-400">Admin Portal</span>
                    </div>
                </a>
            </div>

            <!-- Header Right Section: Notification & User Dropdown -->
            <div class="flex items-center gap-4">
                <!-- Notification Bell (FR-07 Notification Center) -->
                <div class="relative" id="notificationDropdown">
                    <button type="button" onclick="toggleNotificationMenu()" class="relative p-2 text-slate-300 hover:text-white rounded-xl hover:bg-slate-800 transition-colors cursor-pointer">
                        <span class="material-symbols-outlined text-2xl">notifications</span>
                        <span class="absolute top-1.5 right-1.5 w-4 h-4 bg-red-600 text-white font-extrabold text-[10px] rounded-full flex items-center justify-center border-2 border-slate-900 animate-pulse">3</span>
                    </button>

                    <!-- Notifications Panel -->
                    <div id="notificationMenu" class="hidden absolute right-0 mt-2 w-80 bg-white text-slate-900 rounded-2xl shadow-2xl border border-slate-200 py-2 z-50">
                        <div class="px-4 py-2 border-b border-slate-100 flex items-center justify-between">
                            <span class="font-extrabold text-xs text-slate-900">Thông Báo Cảnh Báo</span>
                            <span class="text-[10px] font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded-full">3 Mới</span>
                        </div>
                        <div class="max-h-72 overflow-y-auto divide-y divide-slate-100 text-xs">
                            <a href="/Moderation?riskLevel=High" class="block p-3 hover:bg-red-50/50 transition-colors">
                                <div class="font-bold text-red-700 flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-sm">warning</span> 🔴 5 nội dung RỦI RO CAO chờ duyệt
                                </div>
                                <div class="text-[11px] text-slate-500 mt-0.5">Yêu cầu kiểm duyệt thủ công ưu tiên</div>
                            </a>
                            <a href="/Moderation/Appeals" class="block p-3 hover:bg-purple-50/50 transition-colors">
                                <div class="font-bold text-purple-800 flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-sm">mail</span> 📩 2 khiếu nại mới từ tiểu thương
                                </div>
                                <div class="text-[11px] text-slate-500 mt-0.5">Khiếu nại về quyết định Auto Rejected</div>
                            </a>
                            <a href="/AdminRole" class="block p-3 hover:bg-amber-50/50 transition-colors">
                                <div class="font-bold text-amber-900 flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-sm">shield</span> 🔐 Có thay đổi phân quyền mới
                                </div>
                                <div class="text-[11px] text-slate-500 mt-0.5">Phân quyền scope cho Moderator</div>
                            </a>
                        </div>
                        <div class="px-4 py-2 border-t border-slate-100 text-center">
                            <a href="/Moderation" class="text-[11px] font-bold text-emerald-700 hover:underline">Xem tất cả hàng đợi &rarr;</a>
                        </div>
                    </div>
                </div>

                <!-- User Profile Badge & Quick MFA -->
                <div class="flex items-center gap-3 border-l border-slate-800 pl-4">
                    <a href="/AdminMfa/Verify" class="inline-flex items-center gap-1 px-3 py-1.5 bg-amber-500/20 text-amber-300 hover:bg-amber-500/30 rounded-xl text-xs font-bold border border-amber-500/40 transition-colors">
                        <span class="material-symbols-outlined text-sm">security</span> MFA OTP
                    </a>
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-emerald-700 text-white font-extrabold flex items-center justify-center text-xs shadow-inner">
                            @(string.IsNullOrEmpty(currentEmail) ? "A" : currentEmail.Substring(0, 1).ToUpper())
                        </div>
                        <div class="hidden sm:block text-left">
                            <div class="text-xs font-extrabold text-white leading-none">@(string.IsNullOrEmpty(currentEmail) ? "Quản trị viên" : currentEmail.Split('@')[0])</div>
                            <div class="text-[10px] font-extrabold text-emerald-400 mt-0.5">@currentUserRole.ToString()</div>
                        </div>
                        <a href="/Account/Logout" title="Đăng xuất" class="text-slate-400 hover:text-red-400 p-1 rounded-lg hover:bg-slate-800 transition-colors ml-1">
                            <span class="material-symbols-outlined text-lg">logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Layout Container with 9-Module Left Sidebar -->
    <div class="flex-grow flex max-w-[1600px] w-full mx-auto">
        <!-- Sidebar Navigation (9 Modules) -->
        <aside class="w-64 bg-slate-900 text-slate-300 border-r border-slate-800 flex-shrink-0 hidden md:block py-6">
            <div class="px-4 mb-4">
                <span class="text-[10px] font-black uppercase tracking-wider text-slate-500 block">Menu Quản Trị Hệ Thống</span>
            </div>
            <nav class="space-y-1 px-2">
                <!-- 1. Tổng quan -->
                <a href="/Moderation/Dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.Equals("/Moderation/Dashboard", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">dashboard</span>
                    <span>📊 1. Tổng quan</span>
                </a>

                <!-- 2. Kiểm duyệt -->
                <a href="/Moderation" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.Equals("/Moderation", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">shield</span>
                    <span>🛡 2. Kiểm duyệt Queue</span>
                </a>

                <!-- 3. Quản lý chợ -->
                <a href="/Moderation/Markets" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.Equals("/Moderation/Markets", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">storefront</span>
                    <span>🏪 3. Quản lý chợ</span>
                </a>

                <!-- 4. Người dùng -->
                <a href="/Moderation/Users" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.Equals("/Moderation/Users", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">group</span>
                    <span>👥 4. Người dùng</span>
                </a>

                <!-- 5. Tiểu thương -->
                <a href="/Moderation/Merchants" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.Equals("/Moderation/Merchants", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">store</span>
                    <span>🧑‍🌾 5. Tiểu thương</span>
                </a>

                <!-- 6. Phân quyền & Scope -->
                <a href="/AdminRole" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.StartsWith("/AdminRole", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">vpn_key</span>
                    <span>🔐 6. Phân quyền & Scope</span>
                </a>

                <!-- 7. Khiếu nại -->
                <a href="/Moderation/Appeals" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.Equals("/Moderation/Appeals", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">mark_email_unread</span>
                    <span>📩 7. Khiếu nại (Appeals)</span>
                </a>

                <!-- 8. Audit Log -->
                <a href="/Moderation/AuditLogs" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.Equals("/Moderation/AuditLogs", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">receipt_long</span>
                    <span>📜 8. Audit Log</span>
                </a>

                <!-- 9. Cấu hình kiểm duyệt -->
                <a href="/Moderation/RulesConfig" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-xs font-extrabold transition-all @(currentPath.Equals("/Moderation/RulesConfig", StringComparison.OrdinalIgnoreCase) ? "bg-emerald-600 text-white shadow-md" : "hover:bg-slate-800 hover:text-white")">
                    <span class="material-symbols-outlined text-lg">tune</span>
                    <span>⚙️ 9. Cấu hình quy tắc</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content View Area -->
        <main class="flex-grow p-6 overflow-x-hidden">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script>
        function toggleNotificationMenu() {
            const menu = document.getElementById('notificationMenu');
            if (menu) menu.classList.toggle('hidden');
        }

        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('notificationDropdown');
            const menu = document.getElementById('notificationMenu');
            if (dropdown && menu && !dropdown.contains(e.target)) {
                menu.classList.add('hidden');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
