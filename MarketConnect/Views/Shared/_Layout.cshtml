<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"]</title>

    <!-- Các thư viện UI từ CDN Internet -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />

    <!-- Các thẻ cấu hình nạp CSS tĩnh bắt buộc của ASP.NET Core -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketConnect.styles.css" asp-append-version="true" />

    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        "colors": {
                            "primary": "#004532",
                            "secondary": "#f97316",
                            "surface": "#f9f9ff",
                            "background": "#f5f5fa",
                            "on-background": "#151c27",
                            "outline-variant": "#dee2e6",
                            "primary-container": "#065f46",
                            "on-surface-variant": "#3f4944",
                            "on-surface": "#151c27",
                            "surface-container-low": "#f0f3ff",
                            "surface-container-lowest": "#ffffff"
                        },
                        "fontFamily": {
                            "sans": ["Hanken Grotesk", "sans-serif"]
                        }
                    },
                }
            }
    </script>
    <style>
            body {
                font-family: 'Hanken Grotesk', sans-serif;
                background-color: #f5f5fa;
            }

            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }
          
            .user-dropdown-menu::before {
                content: "";
                position: absolute;
                top: -6px;
                right: 20px;
                border-width: 0 6px 6px 6px;
                border-style: solid;
                border-color: transparent transparent white transparent;
            }
    </style>
</head>
<body class="text-on-background text-sm flex flex-col min-h-screen">

    <!-- 1. HEADER CHUNG CHO TẤT CẢ CÁC TRANG -->
    <header class="w-full sticky top-0 bg-[#004532] text-white z-50 shadow-md select-none">
        <div class="max-w-[1440px] mx-auto px-4 md:px-16 py-3 flex justify-between items-center">
            <!-- Left Links -->
            <div class="flex items-center gap-4 text-xs">
                <a class="hover:text-orange-400 transition-colors" href="/">Kênh Người Bán</a>
                <div class="w-px h-4 bg-white/20 hidden md:block"></div>
                <a class="hover:text-orange-400 transition-colors" href="#">Tải ứng dụng</a>
                <div class="w-px h-4 bg-white/20 hidden md:block"></div>
                <div class="flex items-center gap-2">
                    <span>Kết nối</span>
                    <i class="bi bi-facebook cursor-pointer hover:text-orange-400 transition-colors"></i>
                    <i class="bi bi-instagram cursor-pointer hover:text-orange-400 transition-colors"></i>
                </div>
            </div>
            <!-- Right Links -->
            <div class="flex items-center gap-4 text-xs">
                <a class="flex items-center gap-1 hover:text-orange-400 transition-colors" href="/Notifications">
                    <span class="material-symbols-outlined text-[18px]">notifications</span> Thông báo
                </a>
                <a class="flex items-center gap-1 hover:text-orange-400 transition-colors" href="/Support">
                    <span class="material-symbols-outlined text-[18px]">help</span> Hỗ trợ
                </a>

                <!-- NÚT ĐĂNG TIN CẠNH ICON USER -->
                <a href="/Product/Create" class="bg-[#f97316] hover:bg-orange-600 text-white font-bold px-3 py-1.5 rounded-lg text-xs flex items-center gap-1 shadow-sm transition-all active:scale-95">
                    <span class="material-symbols-outlined text-[16px]">add_circle</span>
                    <span>Đăng tin</span>
                </a>

                <!-- KHU VỰC THAY ĐỔI: HIỂN THỊ ĐỘNG THEO TRẠNG THÁI ĐĂNG NHẬP -->
                <div id="topbar_auth_zone" class="flex items-center gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Khi đã đăng nhập: Hiện cụm tên và Menu Dropdown Hover -->
                        <div class="relative group user-menu-container">
                            <a class="flex items-center gap-1.5 font-medium hover:text-orange-400 cursor-pointer py-1">
                                <span class="material-symbols-outlined text-[18px]">account_circle</span>
                                <span>@User.Identity.Name</span>
                                <span class="text-[9px] transition-transform group-hover:rotate-180">▼</span>
                            </a>

                            <!-- Dropdown Menu xuất hiện khi Hover vào cụm tên -->
                            <div class="absolute right-0 top-full mt-1 w-48 bg-white text-gray-800 rounded shadow-xl py-1 hidden group-hover:block z-50 user-dropdown-menu">
                                <a href="/Product/Create" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-gray-100 hover:text-orange-500 transition-colors font-bold text-orange-600">
                                    <span class="material-symbols-outlined text-[16px]">add_circle</span> Đăng tin bán hàng
                                </a>
                                <a href="/Account/Profile" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-gray-100 hover:text-orange-500 transition-colors">
                                    <span class="material-symbols-outlined text-[16px]">settings</span> Cài đặt tài khoản
                                </a>
                                <a href="/Help" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-gray-100 hover:text-orange-500 transition-colors">
                                    <span class="material-symbols-outlined text-[16px]">help_center</span> Trợ giúp
                                </a>
                                <a href="/Feedback" class="flex items-center gap-2 px-4 py-2.5 text-xs hover:bg-gray-100 hover:text-orange-500 transition-colors">
                                    <span class="material-symbols-outlined text-[16px]">rate_review</span> Đóng góp ý kiến
                                </a>
                                <div class="border-t border-gray-100 my-1"></div>

                                <!-- Form Logout ẩn chuẩn bảo mật Method POST -->
                                <form id="logoutForm" action="/Account/Logout" method="post" class="hidden"></form>
                                <a href="javascript:document.getElementById('logoutForm').submit();" class="flex items-center gap-2 px-4 py-2.5 text-xs text-red-600 hover:bg-red-50 transition-colors">
                                    <span class="material-symbols-outlined text-[16px]">logout</span> Đăng xuất
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Khi chưa đăng nhập: Hiện nút mặc định ban đầu -->
                        <a class="font-medium hover:text-orange-400" href="/Account/Register">Đăng ký</a>
                        <div class="w-[1px] h-3 bg-white/30"></div>
                        <a class="font-medium hover:text-orange-400" href="/Account/Login">Đăng nhập</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <div class="w-full bg-white border-b border-gray-200 shadow-sm">
        <div class="max-w-[1440px] mx-auto px-4 md:px-16 py-4 flex items-center justify-between gap-6">
            <div class="flex items-center gap-3 shrink-0">
                <a href="/" class="flex items-center gap-2">
                    <i class="bi bi-bag-fill text-[#f97316] text-3xl"></i>
                    <h1 class="font-bold text-2xl text-[#004d38] tracking-tight">MarketConnect</h1>
                </a>

                <!-- DROPDOWN CHỌN CHỢ BÊN CẠNH MARKETCONNECT -->
                <div class="relative ml-1" id="marketSelectorContainer">
                    <button id="selectedMarketBtn" type="button" onclick="toggleMarketDropdown(event)" class="flex items-center gap-1.5 bg-emerald-50 hover:bg-emerald-100 text-[#004d38] font-bold text-xs px-3 py-1.5 rounded-full border border-emerald-200 transition-all cursor-pointer shadow-sm">
                        <i class="bi bi-geo-alt-fill text-red-500 text-sm"></i>
                        <span id="selectedMarketName">Chợ Đồng Xuân</span>
                        <i id="marketChevron" class="bi bi-chevron-down text-[10px] text-gray-500 transition-transform"></i>
                    </button>

                    <!-- Dropdown danh sách các chợ -->
                    <div id="marketDropdownMenu" class="absolute left-0 top-full pt-1 w-56 hidden z-50">
                        <div class="bg-white rounded-xl shadow-xl border border-gray-100 py-1.5 max-h-80 overflow-y-auto">
                            <div class="px-3 py-1 text-[10px] font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100 mb-1">
                                Chọn chợ
                            </div>
                            <div id="marketListOptions" class="space-y-0.5"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex-grow max-w-2xl hidden md:block">
                <form method="get" action="/Products/Category" class="flex bg-white border-2 border-[#f97316] rounded-sm p-[2px]">
                    <input name="q" class="flex-grow border-none focus:ring-0 px-4 text-sm outline-none" placeholder="Tìm kiếm sản phẩm, nông sản, chợ..." type="text" />
                    <button type="submit" class="bg-[#f97316] text-white px-6 py-1.5 flex items-center justify-center hover:opacity-95 transition-all">
                        <i class="bi bi-search text-base"></i>
                    </button>
                </form>
            </div>

            <div class="flex items-center pr-4">
                <div class="relative cursor-pointer">
                    <i class="bi bi-cart3 text-[#004d38] text-2xl"></i>
                    <span class="absolute -top-2 -right-2 bg-[#f97316] text-white text-[10px] px-1.5 rounded-full border-2 border-white font-bold">5</span>
                </div>
            </div>
        </div>
    </div>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-200 pt-8 mt-auto">
        <div class="max-w-[1440px] mx-auto px-4 md:px-16 py-6 text-center text-gray-500 text-xs">
            <p>© 2026 MarketConnect. Tất cả các quyền được bảo lưu.</p>
            <p class="mt-2 text-gray-400">Địa chỉ: Tầng 4-5-6, Tòa nhà Capital Place, số 29 đường Liễu Giai, Phường Ngọc Khánh, Quận Ba Đình, Hà Nội.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/layout-scripts.js" asp-append-version="true"></script>

    <script>
        const marketsList = [
            "Chợ Đồng Xuân",
            "Chợ Hàng Bè",
            "Chợ Long Biên",
            "Chợ Thành Công",
            "Chợ Ngọc Hà",
            "Chợ Ngã Tư Sở",
            "Chợ Nam Đồng",
            "Chợ Láng Hạ",
            "Chợ Hôm",
            "Chợ Mơ",
            "Chợ Nguyễn Công Trứ",
            "Chợ Nhà Xanh",
            "Chợ Nghĩa Tân",
            "Chợ Dịch Vọng",
            "Chợ Nhân Chính",
            "Chợ Bưởi"
        ];

        function toggleMarketDropdown(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('marketDropdownMenu');
            const chevron = document.getElementById('marketChevron');
            if (menu) {
                menu.classList.toggle('hidden');
                if (chevron) chevron.classList.toggle('rotate-180');
            }
        }

        // Close dropdown on outside click
        document.addEventListener('click', function(e) {
            const container = document.getElementById('marketSelectorContainer');
            const menu = document.getElementById('marketDropdownMenu');
            const chevron = document.getElementById('marketChevron');
            if (container && !container.contains(e.target) && menu && !menu.classList.contains('hidden')) {
                menu.classList.add('hidden');
                if (chevron) chevron.classList.remove('rotate-180');
            }
        });

        function initMarketSelector() {
            const savedMarket = localStorage.getItem('selected_market') || "Chợ Đồng Xuân";
            const nameElem = document.getElementById('selectedMarketName');
            if (nameElem) nameElem.innerText = savedMarket;

            const listContainer = document.getElementById('marketListOptions');
            if (listContainer) {
                listContainer.innerHTML = marketsList.map(m => {
                    const isSelected = m === savedMarket;
                    return `
                        <button type="button" onclick="selectMarket('${m}')" class="w-full text-left px-3 py-1.5 text-xs flex items-center justify-between hover:bg-emerald-50 hover:text-[#004d38] font-medium transition-colors ${isSelected ? 'bg-emerald-50 text-[#004d38] font-bold' : 'text-gray-700'}">
                            <span>${m}</span>
                            ${isSelected ? '<i class="bi bi-check-lg text-emerald-600 font-bold"></i>' : ''}
                        </button>
                    `;
                }).join('');
            }
        }

        function selectMarket(marketName) {
            localStorage.setItem('selected_market', marketName);
            const nameElem = document.getElementById('selectedMarketName');
            if (nameElem) nameElem.innerText = marketName;
            initMarketSelector();
            const menu = document.getElementById('marketDropdownMenu');
            if (menu) menu.classList.add('hidden');
            window.dispatchEvent(new CustomEvent('marketChanged', { detail: marketName }));
        }

        document.addEventListener('DOMContentLoaded', initMarketSelector);
    </script>
</body>
</html>