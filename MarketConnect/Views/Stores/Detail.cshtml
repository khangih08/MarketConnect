@model MarketConnect.Data.Store

@{
    ViewData["Title"] = Model.StoreName + " - Chợ Việt Online";
    bool canPostProduct = ViewBag.CanPostProduct == true;
    var categories = ViewBag.Categories as IEnumerable<MarketConnect.Data.Category> ?? new List<MarketConnect.Data.Category>();
}

<div class="max-w-[1440px] mx-auto px-4 md:px-16 py-6">
    <!-- Header Thông Báo Nền Tảng -->
    <div class="bg-amber-50 border border-amber-200 text-amber-900 px-4 py-3 rounded-2xl mb-6 text-xs flex items-start gap-2.5 shadow-xs">
        <span class="material-symbols-outlined text-amber-600 text-[20px] shrink-0 mt-0.5">info</span>
        <div>
            <span class="font-bold">Lưu ý nền tảng:</span> Nền tảng chỉ hỗ trợ kết nối thông tin giữa người mua và tiểu thương. Giá cuối cùng, thanh toán và giao nhận được người mua thỏa thuận trực tiếp với từng tiểu thương.
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-2xl mb-6 text-xs flex items-center gap-2 shadow-xs">
            <span class="material-symbols-outlined text-emerald-600 text-[20px]">check_circle</span>
            <span class="font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-2xl mb-6 text-xs flex items-center gap-2 shadow-xs">
            <span class="material-symbols-outlined text-red-600 text-[20px]">error</span>
            <span class="font-semibold">@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Store Profile Header -->
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden mb-8">
        <div class="h-44 bg-gradient-to-r from-emerald-900 via-teal-800 to-emerald-900 p-6 flex items-end relative">
            <div class="flex flex-col md:flex-row items-start md:items-end gap-4 z-10 w-full justify-between">
                <div class="flex items-end gap-4">
                    <div class="w-20 h-20 rounded-2xl bg-white p-1 shadow-lg overflow-hidden shrink-0 border-2 border-white">
                        <img src="@(string.IsNullOrEmpty(Model.LogoUrl) ? "https://images.unsplash.com/photo-1542838132-92c53300491e?w=300" : Model.LogoUrl)" class="w-full h-full object-cover rounded-xl" />
                    </div>
                    <div class="text-white space-y-1">
                        <div class="flex items-center gap-2">
                            <h1 class="text-2xl font-extrabold tracking-tight">@Model.StoreName</h1>
                            <span class="bg-emerald-500 text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                                @Model.Status.ToString()
                            </span>
                        </div>
                        <p class="text-xs text-emerald-200 flex items-center gap-2">
                            <span>Chủ gian: <strong class="text-white">@Model.RepresentativeName</strong></span>
                            <span>•</span>
                            <span>Vị trí quầy: <strong class="text-white">@Model.StallLocation</strong></span>
                        </p>
                    </div>
                </div>

                <div class="shrink-0 mb-1 flex items-center gap-2 flex-wrap">
                    @if (Model.Status == MarketConnect.Data.StoreStatus.Approved)
                    {
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-600/90 text-white text-[11px] font-bold border border-emerald-400/50 shadow-xs">
                            <span class="material-symbols-outlined text-sm">verified_user</span> Tiểu thương đã xác thực
                        </span>
                    }

                    @if (canPostProduct)
                    {
                        <a href="/CartAndOrders/MerchantRequests?storeId=@Model.Id" class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-extrabold shadow-md transition-all active:scale-95">
                            <span class="material-symbols-outlined text-sm">inbox</span> Đơn hàng gửi tới quầy
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Contact Channels & Pickup Methods -->
        <div class="p-6 bg-emerald-50/50 border-t border-gray-100 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <a href="tel:@Model.VerifiedPhone" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center gap-1.5 shadow-sm transition-all active:scale-95">
                    <span class="material-symbols-outlined text-[18px]">call</span>
                    <span>Gọi Điện: @Model.VerifiedPhone</span>
                </a>
                <a href="https://zalo.me/@Model.VerifiedPhone" target="_blank" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center gap-1.5 shadow-sm transition-all active:scale-95">
                    <span class="material-symbols-outlined text-[18px]">chat</span>
                    <span>Zalo Tiện Lợi</span>
                </a>
            </div>

            <div class="text-xs text-gray-600 flex items-center gap-2">
                <span class="font-bold text-gray-800">Hình thức nhận hàng:</span>
                <span class="bg-white px-3 py-1 rounded-lg border border-gray-200 font-medium">@Model.PickupMethods</span>
            </div>
        </div>
    </div>

    <!-- Products in Store Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-700">grid_view</span> Sản Phẩm Tại Gian Hàng
        </h2>

        @if (canPostProduct && Model.Products != null && Model.Products.Any())
        {
            <!-- CHỈ HIỂN THỊ NÚT Ở HEADER KHI ĐÃ CÓ SẢN PHẨM DÀNH CHO TIỂU THƯƠNG -->
            <button id="btnOpenAddProductModalHeader" type="button" onclick="openAddProductModal()" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center gap-2 shadow-md transition-all active:scale-95 cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">add_box</span>
                <span>＋ Đăng Sản Phẩm Mới</span>
            </button>
        }
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
        @if (Model.Products != null && Model.Products.Any())
        {
            foreach (var p in Model.Products)
            {
                <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden p-4 space-y-3 flex flex-col justify-between hover:shadow-md transition-shadow">
                    <div class="space-y-3">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=400" : p.ImageUrl)" class="w-full h-40 object-cover rounded-xl" alt="@p.Name" />
                        <div>
                            <h3 class="font-bold text-sm text-gray-900 line-clamp-1">@p.Name</h3>
                            <p class="text-xs text-gray-500 line-clamp-2 mt-1">@p.Description</p>
                        </div>
                    </div>
                    <div class="pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="text-emerald-700 font-extrabold text-base">@p.Price.ToString("N0") đ / @p.Unit</span>
                        <form method="post" action="/CartAndOrders/AddToCart">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-3 py-1.5 rounded-lg text-xs flex items-center gap-1 transition-all active:scale-95 cursor-pointer">
                                <span class="material-symbols-outlined text-[16px]">add_shopping_cart</span>
                                <span>Thêm Giỏ</span>
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- KHU VỰC CHƯA CÓ SẢN PHẨM NÀO ĐANG CÔNG KHAI -->
            <div class="col-span-full bg-white p-10 md:p-14 rounded-3xl text-center border border-gray-100 shadow-xs flex flex-col items-center justify-center space-y-4">
                <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-3xl">storefront</span>
                </div>
                <div class="max-w-md space-y-1">
                    <p class="text-sm font-extrabold text-gray-800">Chưa có sản phẩm nào được đăng công khai tại gian hàng này.</p>
                    @if (!canPostProduct)
                    {
                        <p class="text-xs text-gray-400">Vui lòng quay lại sau hoặc liên hệ trực tiếp tiểu thương qua số điện thoại để trao đổi.</p>
                    }
                </div>

                @if (canPostProduct)
                {
                    <!-- NÚT ĐĂNG SẢN PHẨM MỚI VÀO GIAN HÀNG NẰM TẠI ĐÚNG VỊ TRÍ NÀY VÀ CHỈ HIỆN VỚI TÀI KHOẢN TIỂU THƯƠNG ĐÃ XÁC THỰC -->
                    <button id="btnOpenAddProductModal" type="button" onclick="openAddProductModal()" class="bg-[#f97316] hover:bg-orange-600 text-white font-extrabold px-6 py-3 rounded-2xl text-xs flex items-center gap-2 shadow-md transition-all active:scale-95 cursor-pointer mt-2">
                        <span class="material-symbols-outlined text-[20px]">add_box</span>
                        <span>＋ Đăng Sản Phẩm Mới Vào Gian Hàng</span>
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (canPostProduct)
{
    <!-- MODAL ĐĂNG SẢN PHẨM DÀNH RIÊNG CHO TIỂU THƯƠNG -->
    <div id="addProductModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-xl w-full p-6 md:p-8 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-orange-500 text-2xl">add_box</span>
                    <h3 class="font-extrabold text-lg text-gray-900">Đăng Sản Phẩm Mới Vào Gian Hàng</h3>
                </div>
                <button id="btnCloseAddProductModal" type="button" class="text-gray-400 hover:text-gray-600 cursor-pointer">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>

            <form method="post" action="/Stores/AddProduct" enctype="multipart/form-data" class="space-y-4">
                <input type="hidden" name="StoreId" value="@Model.Id" />

                <!-- 1. Tên sản phẩm -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">1. Tên Sản Phẩm / Nông Sản <span class="text-red-500">*</span></label>
                    <input type="text" name="Name" required placeholder="Ví dụ: Táo Envy Mỹ Hộp 1kg, Cam Sành Tiền Giang..." class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs outline-none focus:border-emerald-700 font-medium" />
                </div>

                <!-- 2. Danh mục & Đơn vị tính -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">2. Danh Mục <span class="text-red-500">*</span></label>
                        <select name="CategoryId" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs outline-none focus:border-emerald-700 font-medium">
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">3. Đơn Vị Tính <span class="text-red-500">*</span></label>
                        <select name="Unit" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs outline-none focus:border-emerald-700 font-medium">
                            <option value="kg">kg (Kilogram)</option>
                            <option value="Cái">Cái / Trái</option>
                            <option value="Bó">Bó / Chùm</option>
                            <option value="Khay">Khay / Hộp</option>
                            <option value="Túi">Túi / Gói</option>
                            <option value="Đòn">Đòn / Cây</option>
                        </select>
                    </div>
                </div>

                <!-- 3. Giá bán & Miễn phí -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">4. Giá Bán (Đồng) <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <input id="modalPrice" type="number" min="0" step="1000" name="Price" required placeholder="50000" class="w-full bg-gray-50 border border-gray-200 rounded-xl pl-4 pr-10 py-2.5 text-xs outline-none focus:border-emerald-700 font-bold text-emerald-800" />
                        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-gray-400">đ</span>
                    </div>
                    <div class="flex items-center gap-2 mt-1.5">
                        <input id="modalIsFree" type="checkbox" name="IsFree" value="true" class="w-4 h-4 text-emerald-600 rounded border-gray-300 focus:ring-emerald-500" />
                        <label for="modalIsFree" class="text-xs text-gray-600 font-medium cursor-pointer">Sản phẩm cho tặng miễn phí</label>
                    </div>
                </div>

                <!-- 4. Tình trạng hàng hóa -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">5. Tình Trạng Hàng Hóa</label>
                    <select name="Condition" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-xs outline-none focus:border-emerald-700 font-medium">
                        <option value="Tươi mới về trong ngày">Tươi mới về trong ngày</option>
                        <option value="Đã sơ chế sạch sẽ">Đã sơ chế sạch sẽ</option>
                        <option value="Cấp đông tiêu chuẩn">Cấp đông tiêu chuẩn</option>
                        <option value="Mới 100%">Mới 100%</option>
                    </select>
                </div>

                <!-- 5. Tải ảnh sản phẩm từ máy tính -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">6. Hình Ảnh Sản Phẩm (Tải từ máy tính)</label>
                    <div class="border-2 border-dashed border-gray-200 rounded-2xl p-4 text-center hover:border-emerald-600 transition-colors bg-gray-50/50">
                        <label class="cursor-pointer block">
                            <span class="material-symbols-outlined text-2xl text-gray-400">add_a_photo</span>
                            <span class="text-xs font-bold text-gray-700 block mt-1">Chọn ảnh sản phẩm từ máy tính</span>
                            <span class="text-[11px] text-gray-400 block">PNG, JPG, WEBP</span>
                            <input id="modalImageFile" type="file" name="ImageFile" accept="image/*" class="hidden" />
                        </label>
                        <div id="modalImagePreviewContainer" class="mt-3 hidden relative rounded-xl overflow-hidden border border-gray-200 aspect-video bg-gray-100 max-h-36 mx-auto">
                            <img id="modalImgPreview" class="w-full h-full object-cover" src="#" alt="Preview" />
                        </div>
                    </div>
                </div>

                <!-- 6. Mô tả sản phẩm -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">7. Mô Tả Chi Tiết Sản Phẩm</label>
                    <textarea name="Description" rows="3" placeholder="Mô tả nguồn gốc, chất lượng, cách bảo quản..." class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3 text-xs outline-none focus:border-emerald-700 font-medium"></textarea>
                </div>

                <!-- Buttons -->
                <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
                    <button id="btnCancelAddProductModal" type="button" class="px-5 py-2.5 rounded-xl text-xs font-bold text-gray-500 hover:bg-gray-100 transition-colors cursor-pointer">
                        Hủy Bỏ
                    </button>
                    <button type="submit" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-6 py-2.5 rounded-xl text-xs flex items-center gap-1.5 shadow-md transition-all active:scale-95 cursor-pointer">
                        <span class="material-symbols-outlined text-base">publish</span>
                        <span>Đăng Sản Phẩm Ngay</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<script src="~/js/store-detail.js" asp-append-version="true"></script>

