@model IEnumerable<MarketConnect.Data.Store>

@{
    ViewData["Title"] = "Danh Sách Gian Hàng Chợ - Chợ Việt Online";
}

<div class="max-w-[1440px] mx-auto px-4 md:px-16 py-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-700">storefront</span> Gian Hàng Tiểu Thương Truyền Thống
            </h1>
            <p class="text-gray-500 text-xs mt-1">Kết nối trực tiếp với tiểu thương tại chợ - Không qua trung gian thu tiền</p>
        </div>
        <a href="/Stores/Create" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-1.5 shadow-sm transition-all active:scale-95">
            <span class="material-symbols-outlined text-[18px]">add_business</span>
            <span>Đăng Ký Gian Hàng Mới</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl mb-6 text-xs flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600 text-[20px]">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
        @foreach (var store in Model)
        {
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden hover:shadow-md transition-shadow group flex flex-col">
                <div class="relative h-36 bg-gradient-to-r from-emerald-800 to-teal-900 p-4 flex items-end">
                    <span class="absolute top-3 right-3 bg-emerald-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">
                        @store.Status.ToString()
                    </span>
                    <div class="flex items-center gap-3">
                        <div class="w-14 h-14 rounded-xl bg-white p-1 shadow-md overflow-hidden shrink-0">
                            <img src="@(string.IsNullOrEmpty(store.LogoUrl) ? "https://images.unsplash.com/photo-1542838132-92c53300491e?w=200" : store.LogoUrl)" class="w-full h-full object-cover rounded-lg" alt="@store.StoreName" />
                        </div>
                        <div class="text-white truncate">
                            <h3 class="font-bold text-sm truncate group-hover:text-amber-300 transition-colors">@store.StoreName</h3>
                            <p class="text-[11px] text-emerald-200 truncate">Chủ quầy: @store.RepresentativeName</p>
                        </div>
                    </div>
                </div>
                <div class="p-4 flex-grow flex flex-col justify-between space-y-3">
                    <div class="space-y-1.5 text-xs text-gray-600">
                        <p class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px] text-emerald-700 shrink-0">pin_drop</span>
                            <span class="font-semibold text-gray-800 truncate">@store.StallLocation</span>
                        </p>
                        <p class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px] text-emerald-700 shrink-0">phone_in_talk</span>
                            <span>@store.VerifiedPhone</span>
                        </p>
                        <p class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px] text-emerald-700 shrink-0">schedule</span>
                            <span>@store.OpeningHours</span>
                        </p>
                    </div>
                    <a href="/Stores/Detail/@store.Id" class="w-full bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold py-2 rounded-xl text-center text-xs block transition-colors border border-emerald-200">
                        Xem Gian Hàng & Liên Hệ
                    </a>
                </div>
            </div>
        }
    </div>
</div>
