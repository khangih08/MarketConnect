{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MarketConnectDb;Username=postgres;Password=YOUR_SECURE_PASSWORD"
  },
  "Jwt": {
    "Secret": "YOUR_SUPER_SECRET_KEY_MIN_32_CHARS_LONG",
    "Issuer": "MarketConnect",
    "Audience": "MarketConnectClients",
    "ExpiryMinutes": 60
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID"
  }
}
