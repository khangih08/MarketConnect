          },
          "marketName": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          },
          "stallNumber": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "Product": {
        "required": [
          "name"
        ],
        "type": "object",
