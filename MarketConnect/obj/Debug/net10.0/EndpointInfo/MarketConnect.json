            "type": "integer",
            "format": "int32"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "passwordHash": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
