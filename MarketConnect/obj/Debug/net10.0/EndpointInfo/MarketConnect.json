          "id": {
            "type": "integer",
            "format": "int32"
          },
          "merchantId": {
            "type": "integer",
            "format": "int32"
          },
          "productId": {
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "isTrending": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
